// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Content {
  id               String   @id @default(uuid())
  platform         String   // instagram, pinterest, youtube, tiktok, twitter, unknown
  source_url       String   @unique // Prevent duplicate entries for the same URL
  media_url        String?
  thumbnail_url    String?
  caption          String?
  tags             String   // JSON array stored as string (SQLite compat)
  category         String   @default("uncategorized")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  popularity_score Int      @default(0)
  download_count   Int      @default(0)
  view_count       Int      @default(0)
  media_type       String   @default("video") // video, image, carousel
  platform_metrics String?  // JSON metrics payload (likes/comments/views)
  preview_mode     String   @default("external") // embed, direct_video, image, external
  download_available Boolean @default(false)

  @@index([platform])
  @@index([category])
  @@index([created_at])
  @@index([popularity_score])
  @@index([category, created_at])
  @@index([platform, created_at])
}
