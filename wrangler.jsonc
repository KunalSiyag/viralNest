{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pintdownload",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Avoid a second indexable origin (pintdownload.dazzbuilds.workers.dev).
  "workers_dev": false,
  "preview_urls": true,
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Asset html_handling always 307s. Google will not consolidate slash URLs on 307.
    // Send only trailing-slash paths to the Worker (src/worker.ts 301s them). Canonical
    // no-slash HTML stays asset-first so cache/invocation stay unchanged.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*/", "/*/*/"]
  },
  // Astro sessions binding (app does not use sessions; required by adapter defaults).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bb6408e9b56e457e9df7782970831caa"
    }
  ],
  // Zone routes (same account as pintdownload.app). Prefer routes over "Custom domain"
  // when the UI only offers "Add site". Patterns cover apex + www.
  "routes": [
    { "pattern": "pintdownload.app", "zone_name": "pintdownload.app" },
    { "pattern": "pintdownload.app/*", "zone_name": "pintdownload.app" },
    { "pattern": "www.pintdownload.app", "zone_name": "pintdownload.app" },
    { "pattern": "www.pintdownload.app/*", "zone_name": "pintdownload.app" }
  ],
  "observability": {
    "enabled": true
  }
}
