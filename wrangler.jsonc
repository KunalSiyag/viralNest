{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pintdownload",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Avoid a second indexable origin (pintdownload.dazzbuilds.workers.dev).
  "workers_dev": false,
  "preview_urls": true,
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Asset html_handling always 307s. Google will not consolidate slash URLs on 307.
    "html_handling": "drop-trailing-slash",
    // Trailing-slash HTML → Worker (src/worker.ts 301s). Canonical no-slash HTML
    // stays asset-first. An array disables the default "non-navigation misses go
    // to the Worker" fallback, so SSR routes MUST be listed. Without `/api/*`,
    // POST /api/extract hits 404-page asset serving and Cloudflare returns 405.
    // Same for `/mcp` (remote MCP server, POST only; `/mcp/` already matches "/*/").
    "run_worker_first": ["/api/*", "/mcp", "/_image", "/_server-islands/*", "/*/", "/*/*/"]
  },
  // MCP endpoint rate limits (Workers Rate Limiting binding; per Cloudflare
  // location, approximate). src/lib/mcp/rate-limit.ts treats a missing binding
  // as "allowed", so this block can be removed if a plan rejects it.
  "ratelimits": [
    // Every POST /mcp, per client IP.
    { "name": "MCP_REQUEST_LIMITER", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
    // Tool calls that reach Pinterest, per client IP.
    { "name": "MCP_TOOL_LIMITER", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } },
    // All Pinterest-bound MCP tool calls in this location (protects the upstream for the website).
    // 20× the per-client tool limit: draining it takes 20 IPv4 addresses or IPv6 /48s.
    { "name": "MCP_UPSTREAM_LIMITER", "namespace_id": "4203", "simple": { "limit": 600, "period": 60 } }
  ],
  // Astro sessions binding (app does not use sessions; required by adapter defaults).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bb6408e9b56e457e9df7782970831caa"
    }
  ],
  // Zone routes (same account as pintdownload.app). Prefer routes over "Custom domain"
  // when the UI only offers "Add site". Patterns cover apex + www.
  "routes": [
    { "pattern": "pintdownload.app", "zone_name": "pintdownload.app" },
    { "pattern": "pintdownload.app/*", "zone_name": "pintdownload.app" },
    { "pattern": "www.pintdownload.app", "zone_name": "pintdownload.app" },
    { "pattern": "www.pintdownload.app/*", "zone_name": "pintdownload.app" }
  ],
  // `wrangler dev` (npm run preview) hands the Worker the route host over http:,
  // so hostRedirectUrl would 301 every /api/* call to an https URL on an
  // http-only local port. Present requests as https, as production sees them.
  "dev": {
    "upstream_protocol": "https"
  },
  "observability": {
    "enabled": true
  }
}
