---
import { BRAND } from '../lib/brand';
import { absoluteUrl, normalizeCanonical } from '../lib/urls';
import StickyPasteBar from '../components/StickyPasteBar';
import FooterKeywordMatrix from '../components/FooterKeywordMatrix.astro';
// One import for all locale plumbing (see the note in that file): BaseLayout
// keeps its pre-i18n import count, so English stylesheet order is unchanged.
import {
  LanguageMenu,
  getCollection,
  LOCALE_META,
  indexableAlternatesFor,
  liveLocales,
  localeHome,
  localeOfPath,
  pathFor,
  routeForPath,
  routesProp,
  STICKY_PAGE_IDS,
  EN_UI,
  fillUi,
  breadcrumbSchema,
  fontAssetsFor,
  stickyMessagesFor,
  type AnyLocale,
  type PageId,
  type UiStrings,
} from '../components/i18n/layout';
import '../styles/ticket.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** fullBleed removes max-width constraint (hero pages) */
  fullBleed?: boolean;
  /** Hide decorative side pins */
  clean?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  /** Ticket stock the page is printed on (hero field + header) */
  field?: 'red' | 'tangerine' | 'canary' | 'lilac' | 'mint' | 'sky' | 'blush' | 'counter';
  /** Page locale. Default: from the URL through the route map ('en' outside /<locale>/). */
  locale?: AnyLocale;
  /** Chrome strings for the locale (default English). */
  ui?: UiStrings;
}

const {
  title,
  description,
  canonicalUrl,
  image,
  ogType = 'website',
  fullBleed = false,
  clean = false,
  jsonLd,
  noindex = false,
  field = 'red',
} = Astro.props;

const route = routeForPath(Astro.url.pathname);
const locale: AnyLocale = Astro.props.locale ?? route?.locale ?? localeOfPath(Astro.url.pathname);
const isEn = locale === 'en';
const meta = LOCALE_META[locale];
const t: UiStrings = Astro.props.ui ?? EN_UI;
const pageId: PageId | null = route && route.locale === locale ? route.pageId : null;
/** Live locale not cleared for search (LOCALE_META.indexable): noindex, follow and no hreflang. */
const localeNoindex = !meta.indexable;
/** hreflang cluster: one generator for every member (src/i18n/routes.ts). Localized noindex pages (404) carry none. */
const cluster = pageId && !localeNoindex ? indexableAlternatesFor(pageId) : null;
const otherLocalesLive = liveLocales().length > 0;

/** Content of this locale's live pages (nav labels, cards); English never loads it. */
const localized = isEn
  ? new Map()
  : new Map(
      (await getCollection('i18nPages', (e) => e.data.locale === locale))
        .filter((e) => pathFor(e.data.pageId, locale))
        .map((e) => [e.data.pageId, e.data]),
    );
const navOf = (id: PageId) => localized.get(id)?.nav as { label: string; short: string; shortWide?: string } | undefined;
const hrefOf = (id: PageId) => (localized.has(id) ? pathFor(id, locale) : null);
/** Localized link text pointing at an English-only page: hreflang marks the target's language. */
const englishLinkAttrs = isEn ? {} : { hreflang: 'en' };
const englishMarker = isEn || !t.footer.englishMarker ? '' : ` ${t.footer.englishMarker}`;

// Always normalize: no trailing slash except homepage
const currentCanonical = normalizeCanonical(
  canonicalUrl || absoluteUrl(Astro.url.pathname),
);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogImage = image
  ? image.startsWith('http')
    ? image
    : absoluteUrl(image.startsWith('/') ? image : `/${image}`)
  : absoluteUrl(BRAND.ogImage);

const pathName = Astro.url.pathname.replace(/\/$/, '');
const enBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    ...(pathName
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title.split('—')[0].trim(),
            item: currentCanonical,
          },
        ]
      : []),
  ],
};

/** Localized pages: rooted at the locale home, named by nav.label (plan §6 breadcrumb). */
const pageBreadcrumbSchema = isEn
  ? enBreadcrumbSchema
  : breadcrumbSchema(
      locale,
      pageId && pageId !== 'home' && navOf(pageId) ? { name: navOf(pageId)!.label, url: currentCanonical } : null,
    );

const websiteSearchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND.name,
  url: absoluteUrl('/'),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${absoluteUrl('/')}?url={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${absoluteUrl('/')}#organization`,
  name: BRAND.name,
  url: absoluteUrl('/'),
  // One description for the one shared @id: the English text lives on English
  // pages; localized pages reference the same entity without restating it.
  ...(isEn ? { description: BRAND.description } : {}),
  logo: {
    '@type': 'ImageObject',
    url: absoluteUrl('/images/logo.png'),
  },
  email: BRAND.email.support,
  sameAs: ['https://github.com/kunalsiyag', 'https://x.com/pintdownload'],
};

const adClient = meta.ads ? (import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined) : undefined;
const fieldClass = field === 'counter' ? '' : `field-${field}`;
const themeColor = { red: '#C8281A', tangerine: '#F08A3C', canary: '#F4C531', lilac: '#B79CE8', mint: '#6CC79A', sky: '#7DB7E8', blush: '#F29BB4', counter: '#E4E6E9' }[field];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
/** 'page' on the item's own URL, 'true' anywhere inside its section (blog articles under Guides). */
const navCurrent = (href: string): 'page' | 'true' | undefined =>
  currentPath === href ? 'page' : href !== '/' && currentPath.startsWith(`${href}/`) ? 'true' : undefined;

/** Header navigation — concise labels for clean header spacing */
const enNav = [
  { href: '/pinterest-video-downloader', label: 'Videos' },
  { href: '/pinterest-pin-downloader', label: 'Pins' },
  { href: '/pinterest-image-downloader', label: 'Images' },
  { href: '/pinterest-gif-downloader', label: 'GIFs' },
  { href: '/pinterest-board-downloader', label: 'Boards' },
  { href: '/pinterest-profile-picture-downloader', label: 'Avatar' },
  { href: '/pinterest-profile-downloader', label: 'Profiles' },
  { href: '/blog', label: 'Guides' },
];

const enMobileNav = [
  { href: '/pinterest-video-downloader', label: 'Pinterest Video Downloader' },
  { href: '/pinterest-pin-downloader', label: 'Pinterest Pin Downloader' },
  { href: '/pinterest-board-downloader', label: 'Pinterest Board Downloader' },
  { href: '/pinterest-profile-picture-downloader', label: 'Pinterest Avatar / DP Downloader' },
  { href: '/pinterest-profile-downloader', label: 'Pinterest Profile Downloader' },
  { href: '/pinterest-gif-downloader', label: 'Pinterest GIF Downloader' },
  { href: '/pinterest-image-downloader', label: 'Pinterest Photo Downloader' },
  { href: '/blog', label: 'Blog & Guides' },
  { href: '/how-to-download-pinterest-videos', label: 'How to Download' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact Support' },
];

/** Localized header: the same slots by pageId; a slot without a live page is left out. */
const NAV_SLOTS: PageId[] = [
  'pinterest-video-downloader',
  'pinterest-pin-downloader',
  'pinterest-image-downloader',
  'pinterest-gif-downloader',
  'pinterest-board-downloader',
  'pinterest-profile-picture-downloader',
  'pinterest-profile-downloader',
];
const MOBILE_SLOTS: PageId[] = [
  'pinterest-video-downloader',
  'pinterest-pin-downloader',
  'pinterest-board-downloader',
  'pinterest-profile-picture-downloader',
  'pinterest-profile-downloader',
  'pinterest-gif-downloader',
  'pinterest-image-downloader',
  'how-to-download-pinterest-videos',
];
type NavItem = { href: string; label: string; wide?: string; english?: boolean };
const slotItems = (ids: PageId[], label: (id: PageId) => string | undefined): NavItem[] =>
  ids.flatMap((id) => {
    const href = hrefOf(id);
    const text = label(id);
    return href && text ? [{ href, label: text }] : [];
  });
const nav: NavItem[] = isEn
  ? enNav
  : [
      ...NAV_SLOTS.flatMap((id): NavItem[] => {
        const href = hrefOf(id);
        const n = navOf(id);
        return href && n?.short ? [{ href, label: n.short, ...(n.shortWide ? { wide: n.shortWide } : {}) }] : [];
      }),
      ...slotItems(['how-to-download-pinterest-videos'], () => t.header.guides),
    ];
const mobileNav: NavItem[] = isEn
  ? enMobileNav
  : [
      ...slotItems(MOBILE_SLOTS, (id) => navOf(id)?.label),
      { href: '/blog', label: `${t.footer.blog}${englishMarker}`, english: true },
      { href: '/about', label: `${t.footer.about}${englishMarker}`, english: true },
      { href: '/contact', label: `${t.footer.contact}${englishMarker}`, english: true },
    ];

/** Localized footer columns (architecture §7): localized pages, English-only pages marked. */
const FOOTER_TOOLS: PageId[] = [
  'pinterest-video-downloader',
  'pinterest-pin-downloader',
  'pinterest-board-downloader',
  'pinterest-image-downloader',
  'pinterest-profile-picture-downloader',
  'pinterest-profile-downloader',
  'pinterest-gif-downloader',
];
const FOOTER_GUIDES: PageId[] = [
  'how-to-download-pinterest-videos',
  'how-to-download-pinterest-video-in-gallery',
  'download-pinterest-videos-iphone-android',
  'how-to-download-pinterest-video-on-laptop',
];
const footerTools = isEn ? [] : slotItems(FOOTER_TOOLS, (id) => navOf(id)?.label).slice(0, 6);
const footerGuides = isEn ? [] : slotItems(FOOTER_GUIDES, (id) => navOf(id)?.label);
const footerCompany = [
  { href: '/about', label: t.footer.about },
  { href: '/contact', label: t.footer.contact },
  { href: '/privacy-policy', label: t.footer.privacy },
  { href: '/terms-of-service', label: t.footer.terms },
];

/** Footer link matrix for localized pages (English keeps its own groups). */
const matrixGroups = isEn
  ? undefined
  : [
      {
        category: t.matrix.devices,
        links: slotItems(
          [
            'download-pinterest-videos-iphone-android',
            'how-to-download-pinterest-video-in-gallery',
            'how-to-download-pinterest-video-on-laptop',
            'pinterest-video-downloader-chrome',
            'how-to-download-pinterest-videos',
          ],
          (id) => navOf(id)?.label,
        ),
      },
      {
        category: t.matrix.formats,
        links: slotItems(
          [
            'pinterest-video-downloader',
            'pinterest-carousel-downloader',
            'pinterest-image-downloader',
            'pinterest-gif-downloader',
            'pinterest-audio-downloader',
            'pinterest-to-mp4',
            'pinterest-4k-downloader',
          ],
          (id) => navOf(id)?.label,
        ),
      },
      {
        category: t.matrix.batch,
        links: slotItems(
          [
            'pinterest-board-downloader',
            'pinterest-profile-downloader',
            'pinterest-profile-picture-downloader',
            'pinterest-pin-downloader',
          ],
          (id) => navOf(id)?.label,
        ),
      },
    ].filter((g) => g.links.length > 0);

/** og:locale:alternate for the other members of the cluster. */
const ogAlternates =
  cluster && cluster.length > 2
    ? cluster
        .filter((a) => a.locale !== 'x-default' && a.locale !== locale)
        .map((a) => LOCALE_META[a.locale as AnyLocale].ogLocale)
    : [];
const fontPreloads = fontAssetsFor(locale).preload;
const stickyMessages = stickyMessagesFor(locale);

/** Inline header script, labels from the locale (English bytes unchanged). */
const jsq = (v: string) => `'${v.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/</g, '\\u003c')}'`;
const headerScript = `
        (function () {
          var btn = document.getElementById('mobile-nav-toggle');
          var panel = document.getElementById('mobile-nav-panel');
          if (btn && panel) {
            // A language menu left open inside the panel would greet the next opening.
            var closeMenus = function () {
              panel.querySelectorAll('details[open]').forEach(function (d) { d.open = false; });
            };
            btn.addEventListener('click', function () {
              var open = panel.classList.toggle('hidden') === false;
              if (!open) closeMenus();
              btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              btn.setAttribute('aria-label', open ? ${jsq(t.header.menuClose)} : ${jsq(t.header.menuOpen)});
            });
            document.addEventListener('keydown', function (e) {
              // defaultPrevented: Escape already closed a language menu (LanguageMenu).
              if (e.key === 'Escape' && !e.defaultPrevented && !panel.classList.contains('hidden')) {
                closeMenus();
                panel.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
                btn.setAttribute('aria-label', ${jsq(t.header.menuOpen)});
                btn.focus();
              }
            });
          }
          var theme = document.getElementById('theme-toggle-btn');
          if (theme) {
            theme.addEventListener('click', function () {
              var h = document.documentElement;
              var dark = !h.classList.contains('dark');
              h.classList.toggle('dark', dark);
              h.classList.toggle('light', !dark);
              try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
            });
          }
        })();
      `;
---

<!doctype html>
<html lang={meta.htmlLang} dir={isEn ? undefined : meta.dir} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BRAND.name} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : localeNoindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    {!(noindex && !isEn) && <link rel="canonical" href={currentCanonical} />}
    <link rel="sitemap" type="application/xml" title="Sitemap" href={absoluteUrl('/sitemap.xml')} />
    {/* Only declare real locale URLs. Fake multi-locale hreflang pointing at English hurts SEO. */}
    {cluster ? (
      cluster.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
    ) : isEn ? (
      <>
        <link rel="alternate" hreflang="en" href={currentCanonical} />
        <link rel="alternate" hreflang="x-default" href={currentCanonical} />
      </>
    ) : null}
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BRAND.name} Blog`}
      href={absoluteUrl('/rss.xml')}
    />
    <link rel="search" type="application/opensearchdescription+xml" title={BRAND.name} href="/opensearch.xml" />

    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {ogAlternates.map((og) => <meta property="og:locale:alternate" content={og} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pintdownload" />
    <meta name="twitter:url" content={currentCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageBreadcrumbSchema)} />
    {isEn && <script type="application/ld+json" set:html={JSON.stringify(websiteSearchSchema)} />}
    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {adClient && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>
    )}
    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class:list={['min-h-screen flex flex-col font-sans antialiased overflow-x-hidden', fieldClass]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-[100] focus:px-4 focus:py-3 focus:rounded-md focus:bg-ink-900 focus:text-white focus:font-bold"
    >{isEn ? '\nSkip to content\n' : t.skipToContent}</a>

    <header id="site-header" class:list={['relative z-40 w-full', field === 'counter' ? 'bg-[var(--counter)] text-[var(--ink)] border-b-2 border-[var(--ink)]' : 'field']}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[4.5rem] flex items-center justify-between gap-4 lg:gap-6 xl:gap-4">
        <a href={localeHome(locale)} class="flex items-center gap-2 min-w-0 shrink-0 rounded-md" aria-label={t.homeAria}>
          <span class="grid place-items-center h-10 w-10 rounded-md bg-white shrink-0">
            <img src="/images/logo.png" alt={t.logoAlt} width="28" height="28" class="h-7 w-7 object-contain" decoding="async" />
          </span>
          <span class="t-display text-[1.6rem] leading-none tracking-[0.01em]" translate="no" lang={isEn ? undefined : 'en'}>PintDownload</span>
        </a>

        {/* Eight localized slots (de, es, pt, tr, vi) are wider than English's
            seven: a hair smaller and tighter between 1024 and 1279px. */}
        <nav
          class={!isEn && nav.length >= 8
            ? 'hidden lg:flex items-center [justify-content:safe_center] flex-1 min-w-0 gap-0 xl:gap-1 text-[0.875rem] xl:text-[0.95rem] font-bold [&>a]:px-1 xl:[&>a]:px-3'
            : 'hidden lg:flex items-center [justify-content:safe_center] flex-1 min-w-0 gap-0 xl:gap-1 text-[0.9rem] xl:text-[0.95rem] font-bold'}
          aria-label={t.header.mainNavAria}
        >
          {nav.map((item) => {
            const current = navCurrent(item.href);
            const isActive = Boolean(current);
            return (
              <a
                href={item.href}
                aria-current={current}
                class:list={[
                  'px-1.5 xl:px-3 py-2 rounded-md whitespace-nowrap transition-colors',
                  isActive ? 'bg-ink-900 text-white' : 'hover:bg-black/10',
                ]}
              >
                {item.wide ? (
                  <>
                    <span class="xl:hidden">{item.label}</span>
                    <span class="hidden xl:inline">{item.wide}</span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          {otherLocalesLive && (
            <div class="hidden sm:block"><LanguageMenu id="lang-menu-desktop" locale={locale} pageId={pageId} ui={t} withScript /></div>
          )}
          <button
            id="theme-toggle-btn"
            type="button"
            class="h-11 w-11 inline-flex items-center justify-center rounded-md hover:bg-black/10 touch-manipulation"
            aria-label={t.header.themeToggle}
          >
            <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="lg:hidden h-11 w-11 inline-flex items-center justify-center rounded-md hover:bg-black/10 touch-manipulation"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label={t.header.menuOpen}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-panel" class="hidden lg:hidden absolute start-0 end-0 top-full z-50 bg-ink-900 text-white">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-2 text-base font-semibold" aria-label={t.header.mobileNavAria}>
          {otherLocalesLive && (
            <div class="sm:hidden py-3 flex items-center justify-between gap-3 border-b-2 border-dashed border-white/20">
              <span class="t-label">{t.languageMenu.label}</span>
              <LanguageMenu id="lang-menu-mobile" locale={locale} pageId={pageId} ui={t} />
            </div>
          )}
          <ul class="divide-y-2 divide-dashed divide-white/20">
            {mobileNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={navCurrent(item.href)}
                  hreflang={item.english ? 'en' : undefined}
                  class="flex items-center justify-between min-h-[3.25rem] px-1 hover:text-stock-canary touch-manipulation"
                >
                  {item.label}
                  <svg class={isEn ? undefined : 'rtl:-scale-x-100'} xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </a>
