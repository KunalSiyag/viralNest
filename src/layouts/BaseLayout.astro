      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Plus Jakarta Sans', sans-serif;
  }

  body {
    touch-action: manipulation;
    font-family: var(--font-sans);
  }
  
  *:focus-visible {
    outline: 2px solid #E60023;
    outline-offset: 2px;
  }
  
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #F1F1F1;
