---
import { BRAND } from '../lib/brand';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** fullBleed removes max-width constraint (hero pages) */
  fullBleed?: boolean;
  /** Hide decorative side pins */
  clean?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl,
  image,
  ogType = 'website',
  fullBleed = false,
  clean = false,
  jsonLd,
} = Astro.props;

const currentCanonical = canonicalUrl || Astro.url.href;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogImage = image
  ? image.startsWith('http')
    ? image
    : `${BRAND.url}${image.startsWith('/') ? image : `/${image}`}`
  : `${BRAND.url}${BRAND.logoPng}`;

const pathName = Astro.url.pathname.replace(/\/$/, '');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BRAND.url}/` },
    ...(pathName
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title.split('—')[0].trim(),
            item: currentCanonical,
          },
        ]
      : []),
  ],
};

const websiteSearchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND.name,
  url: `${BRAND.url}/`,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${BRAND.url}/?url={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

/** SEO-rich primary nav (Pinpea-style intent labels) */
const nav = [
  { href: '/pinterest-video-downloader', label: 'Pinterest Video Downloader' },
  { href: '/pinterest-pin-downloader', label: 'Pinterest Pin Downloader' },
  { href: '/pinterest-board-downloader', label: 'Pinterest Board Downloader' },
];

const mobileNav = [
  ...nav,
  { href: '/pinterest-image-downloader', label: 'Pinterest Photo Downloader' },
  { href: '/pinterest-profile-downloader', label: 'Pinterest Profile Downloader' },
  { href: '/blog', label: 'Blog' },
  { href: '/how-to-download-pinterest-videos', label: 'How to download' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={BRAND.logoPng} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentCanonical} />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BRAND.name} Blog`}
      href={`${BRAND.url}/rss.xml`}
    />
    <link rel="search" type="application/opensearchdescription+xml" title={BRAND.name} href="/opensearch.xml" />

    <meta name="msvalidate.01" content="BING_WEBMASTER_VERIFICATION_KEY" />
    <meta name="yandex-verification" content="YANDEX_VERIFICATION_KEY" />
    <meta name="baidu-site-verification" content="BAIDU_VERIFICATION_KEY" />

    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#E11D48" />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSearchSchema)} />
    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#FFFBFB] dark:bg-ink-950 text-ink-900 dark:text-slate-100 antialiased min-h-screen flex flex-col font-sans selection:bg-brand-600/20 selection:text-brand-800 dark:selection:text-brand-100"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-full focus:bg-white focus:text-ink-900 focus:shadow-lift"
    >
      Skip to content
    </a>

    <!-- Minimal frosted header -->
    <header
      class="sticky top-0 z-50 w-full border-b border-black/[0.05] dark:border-white/[0.08] bg-white/80 dark:bg-ink-950/80 backdrop-blur-xl"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-[4.25rem] flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2.5 group min-w-0 focus-visible:outline-none shrink-0">
          <img
            src="/images/logo.svg"
            alt=""
            width="36"
            height="36"
            class="w-9 h-9 rounded-[22%] shadow-soft"
            decoding="async"
          />
          <span class="font-bold text-[1.125rem] tracking-tight text-ink-900 dark:text-white truncate">
            Pint<span class="text-brand-600">Download</span>
          </span>
        </a>

        <nav class="hidden xl:flex items-center gap-0.5 text-[0.875rem] font-medium" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 rounded-full text-ink-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors whitespace-nowrap"
            >
              {item.label}
            </a>
          ))}
          <a
            href="/blog"
            class="px-3 py-2 rounded-full text-ink-600 dark:text-slate-300 hover:text-brand-600 transition-colors"
          >
            Blog
          </a>
        </nav>

        <div class="flex items-center gap-1.5">
          <button
            id="theme-toggle-btn"
            type="button"
            onclick="const h=document.documentElement;if(h.classList.contains('dark')){h.classList.remove('dark');h.classList.add('light');localStorage.setItem('theme','light');}else{h.classList.remove('light');h.classList.add('dark');localStorage.setItem('theme','dark');}"
            class="h-10 w-10 inline-flex items-center justify-center rounded-full bg-black/[0.04] dark:bg-white/[0.08] text-ink-700 dark:text-slate-200 hover:bg-black/[0.07] dark:hover:bg-white/[0.12] transition-colors touch-manipulation text-sm"
            title="Toggle theme"
            aria-label="Toggle light and dark mode"
          >
            <span class="hidden dark:inline" aria-hidden="true">☀️</span>
            <span class="inline dark:hidden" aria-hidden="true">🌙</span>
          </button>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="xl:hidden h-10 w-10 inline-flex items-center justify-center rounded-full bg-black/[0.04] dark:bg-white/[0.08] text-ink-800 dark:text-slate-100 touch-manipulation"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="Open menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-panel" class="hidden xl:hidden border-t border-black/[0.05] dark:border-white/[0.08] bg-white/95 dark:bg-ink-950/95 backdrop-blur-xl">
        <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3 grid grid-cols-1 gap-1.5 text-[0.95rem] font-medium" aria-label="Tools">
          {mobileNav.map((item) => (
            <a
              href={item.href}
              class="px-4 py-3 rounded-xl bg-ink-50 dark:bg-white/[0.05] text-ink-800 dark:text-slate-100 hover:bg-brand-50 dark:hover:bg-brand-950/40 hover:text-brand-700 transition-colors touch-manipulation"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
      <script is:inline>
        (function () {
          var btn = document.getElementById('mobile-nav-toggle');
          var panel = document.getElementById('mobile-nav-panel');
          if (!btn || !panel) return;
          btn.addEventListener('click', function () {
            var open = panel.classList.toggle('hidden') === false;
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          });
        })();
      </script>
    </header>

    <div class="relative w-full overflow-x-hidden flex-1">
      {!clean && (
        <>
          <div class="hidden 2xl:block absolute left-6 top-28 w-44 pointer-events-none select-none z-0 opacity-70">
            <div class="transform -rotate-6">
              <div class="p-1.5 bg-white/90 dark:bg-ink-900/90 rounded-2xl border border-black/[0.05] shadow-lift">
                <img src="/images/side_pin_1.jpg" alt="" class="w-full h-52 object-cover rounded-xl" width="176" height="208" loading="lazy" />
              </div>
            </div>
          </div>
          <div class="hidden 2xl:block absolute right-6 top-32 w-44 pointer-events-none select-none z-0 opacity-70">
            <div class="transform rotate-6">
              <div class="p-1.5 bg-white/90 dark:bg-ink-900/90 rounded-2xl border border-black/[0.05] shadow-lift">
                <img src="/images/side_pin_2.jpg" alt="" class="w-full h-52 object-cover rounded-xl" width="176" height="208" loading="lazy" />
              </div>
            </div>
          </div>
        </>
      )}

      <main
        id="main-content"
        class:list={[
          'relative z-10 flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col',
          fullBleed ? 'max-w-none px-0 py-0' : 'max-w-5xl',
        ]}
      >
        <slot />
      </main>
    </div>

    <footer class="w-full border-t border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-950 py-14 sm:py-16 text-base text-ink-500 dark:text-slate-400">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col gap-12">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 text-left">
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="inline-flex items-center gap-2.5 mb-4">
              <img src="/images/logo.svg" alt="" width="32" height="32" class="w-8 h-8 rounded-[22%]" />
              <span class="font-semibold text-lg text-ink-900 dark:text-white tracking-tight">
                Pint<span class="text-brand-600">Download</span>
              </span>
            </a>
            <p class="text-[0.95rem] leading-relaxed text-ink-500 dark:text-slate-400 max-w-xs">
              {BRAND.tagline}. Free public pin, video, board, and profile downloads — no account, no watermark from us.
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-ink-900 dark:text-white mb-4 text-[1.05rem]">Tools</h4>
            <ul class="space-y-2.5 text-[0.95rem] font-medium">
              <li><a href="/pinterest-video-downloader" class="hover:text-brand-600 transition-colors">Pinterest Video Downloader</a></li>
              <li><a href="/pinterest-pin-downloader" class="hover:text-brand-600 transition-colors">Pinterest Pin Downloader</a></li>
              <li><a href="/pinterest-board-downloader" class="hover:text-brand-600 transition-colors">Pinterest Board Downloader</a></li>
              <li><a href="/pinterest-image-downloader" class="hover:text-brand-600 transition-colors">Pinterest Photo Downloader</a></li>
              <li><a href="/pinterest-profile-downloader" class="hover:text-brand-600 transition-colors">Pinterest Profile Downloader</a></li>
              <li><a href="/pinterest-gif-downloader" class="hover:text-brand-600 transition-colors">Pinterest GIF Downloader</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-ink-900 dark:text-white mb-4 text-[1.05rem]">Learn</h4>
            <ul class="space-y-2.5 text-[0.95rem] font-medium">
              <li><a href="/blog" class="hover:text-brand-600 transition-colors">Blog</a></li>
              <li><a href="/rss.xml" class="hover:text-brand-600 transition-colors">RSS</a></li>
              <li><a href="/how-to-download-pinterest-videos" class="hover:text-brand-600 transition-colors">How-to guide</a></li>
              <li><a href="/blog/troubleshooting-pinterest-downloads" class="hover:text-brand-600 transition-colors">Troubleshooting</a></li>
              <li><a href="/blog/pin-vs-board-vs-profile-urls-explained" class="hover:text-brand-600 transition-colors">URL types</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-ink-900 dark:text-white mb-4 text-[1.05rem]">Company</h4>
            <ul class="space-y-2.5 text-[0.95rem] font-medium">
              <li><a href="/about" class="hover:text-brand-600 transition-colors">About</a></li>
              <li><a href="/contact" class="hover:text-brand-600 transition-colors">Contact</a></li>
              <li><a href="/privacy-policy" class="hover:text-brand-600 transition-colors">Privacy</a></li>
              <li><a href="/terms-of-service" class="hover:text-brand-600 transition-colors">Terms</a></li>
              <li>
                <a href={`mailto:${BRAND.email.support}`} class="hover:text-brand-600 transition-colors break-all">
                  {BRAND.email.support}
                </a>
              </li>
              <li>
                <a href={`mailto:${BRAND.email.feedback}`} class="hover:text-brand-600 transition-colors break-all">
                  {BRAND.email.feedback}
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-black/[0.06] dark:border-white/[0.08] text-[0.9rem]">
          <p class="text-ink-500">
            © {new Date().getFullYear()} {BRAND.name} · {BRAND.domain}
          </p>
          <p class="text-ink-400 dark:text-slate-500 text-center md:text-right max-w-lg">
            Credit original creators when you reuse clips. Independent tool — not affiliated with Pinterest Inc.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }

  html {
    font-size: 100%;
  }

  @media (min-width: 768px) {
    html {
      font-size: 106.25%; /* slightly larger on desktop */
    }
  }

  body {
    touch-action: manipulation;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  *:focus-visible {
    outline: 2px solid #E11D48;
    outline-offset: 3px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: #d4d4d8;
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  .dark ::-webkit-scrollbar-thumb {
    background: #3f3f46;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
</style>
