---
import { BRAND } from '../lib/brand';
import StickyPasteBar from '../components/StickyPasteBar';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** fullBleed removes max-width constraint (hero pages) */
  fullBleed?: boolean;
  /** Hide decorative side pins */
  clean?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl,
  image,
  ogType = 'website',
  fullBleed = false,
  clean = false,
  jsonLd,
} = Astro.props;

const currentCanonical = canonicalUrl || Astro.url.href;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogImage = image
  ? image.startsWith('http')
    ? image
    : `${BRAND.url}${image.startsWith('/') ? image : `/${image}`}`
  : `${BRAND.url}${BRAND.logoPng}`;

const pathName = Astro.url.pathname.replace(/\/$/, '');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BRAND.url}/` },
    ...(pathName
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title.split('—')[0].trim(),
            item: currentCanonical,
          },
        ]
      : []),
  ],
};

const websiteSearchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND.name,
  url: `${BRAND.url}/`,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${BRAND.url}/?url={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

/** Primary nav — full tool names with Pinterest prefix */
const nav = [
  { href: '/pinterest-video-downloader', label: 'Pinterest Video Downloader' },
  { href: '/pinterest-pin-downloader', label: 'Pinterest Pin Downloader' },
  { href: '/pinterest-board-downloader', label: 'Pinterest Board Downloader' },
  { href: '/pinterest-profile-downloader', label: 'Pinterest Profile Downloader' },
  { href: '/pinterest-gif-downloader', label: 'Pinterest GIF Downloader' },
];

const mobileNav = [
  { href: '/pinterest-video-downloader', label: 'Pinterest Video Downloader' },
  { href: '/pinterest-pin-downloader', label: 'Pinterest Pin Downloader' },
  { href: '/pinterest-board-downloader', label: 'Pinterest Board Downloader' },
  { href: '/pinterest-profile-downloader', label: 'Pinterest Profile Downloader' },
  { href: '/pinterest-gif-downloader', label: 'Pinterest GIF Downloader' },
  { href: '/pinterest-image-downloader', label: 'Pinterest Photo Downloader' },
  { href: '/blog', label: 'Blog' },
  { href: '/how-to-download-pinterest-videos', label: 'How to download' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/logo-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentCanonical} />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BRAND.name} Blog`}
      href={`${BRAND.url}/rss.xml`}
    />
    <link rel="search" type="application/opensearchdescription+xml" title={BRAND.name} href="/opensearch.xml" />

    <meta name="msvalidate.01" content="BING_WEBMASTER_VERIFICATION_KEY" />
    <meta name="yandex-verification" content="YANDEX_VERIFICATION_KEY" />
    <meta name="baidu-site-verification" content="BAIDU_VERIFICATION_KEY" />

    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#E11D48" />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSearchSchema)} />
    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#FFFBFB] dark:bg-ink-950 text-ink-900 dark:text-slate-100 antialiased min-h-screen flex flex-col font-sans selection:bg-brand-600/20 selection:text-brand-800 dark:selection:text-brand-100 relative overflow-x-hidden"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-full focus:bg-white focus:text-ink-900 focus:shadow-lift"
    >
      Skip to content
    </a>

    <!-- Side ambient glows to fill screen margins aesthetically -->
    <div class="fixed top-1/4 -left-36 w-[30rem] h-[30rem] rounded-full bg-red-500/10 dark:bg-red-500/15 blur-3xl pointer-events-none z-0" aria-hidden="true"></div>
    <div class="fixed top-1/2 -right-36 w-[30rem] h-[30rem] rounded-full bg-rose-500/10 dark:bg-rose-500/15 blur-3xl pointer-events-none z-0" aria-hidden="true"></div>

    <!-- Minimal header (Transparent fixed overlay over hero section, frosted glass on scroll) -->
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 border-b border-transparent bg-transparent"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[4.5rem] flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group min-w-0 focus-visible:outline-none shrink-0">
          <img
            src="/images/logo.png"
            alt=""
            width="40"
            height="56"
            class="h-9 w-auto object-contain object-center drop-shadow-sm"
            decoding="async"
          />
          <span class="font-bold text-[1.2rem] tracking-tight text-ink-900 dark:text-white truncate">
            Pint<span class="text-brand-600">Download</span>
          </span>
        </a>

        <nav class="hidden xl:flex items-center gap-1.5 2xl:gap-3 text-[0.78rem] 2xl:text-[0.85rem] font-semibold" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class="px-2.5 py-1.5 rounded-full text-ink-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-brand-50/60 dark:hover:bg-brand-950/40 transition-all whitespace-nowrap"
            >
              {item.label}
            </a>
          ))}
          <a
            href="/blog"
            class="px-2.5 py-1.5 rounded-full text-ink-600 dark:text-slate-300 hover:text-brand-600 hover:bg-brand-50/60 dark:hover:bg-brand-950/40 transition-all"
          >
            Blog
          </a>
        </nav>

        <div class="flex items-center gap-3 shrink-0">
          <!-- Slide Theme Toggle Button -->
          <button
            id="theme-toggle-btn"
            type="button"
            onclick="const h=document.documentElement;if(h.classList.contains('dark')){h.classList.remove('dark');h.classList.add('light');localStorage.setItem('theme','light');}else{h.classList.remove('light');h.classList.add('dark');localStorage.setItem('theme','dark');}"
            class="relative h-9 w-16 rounded-full bg-slate-200/90 dark:bg-slate-800/90 p-1 transition-colors duration-300 border border-slate-300/70 dark:border-slate-700/80 flex items-center justify-between shadow-inner focus-visible:outline-none shrink-0"
            title="Toggle theme"
            aria-label="Toggle light and dark mode"
          >
            <span class="text-xs select-none pl-1.5 z-0" aria-hidden="true">☀️</span>
            <span class="text-xs select-none pr-1.5 z-0" aria-hidden="true">🌙</span>
            <span
              class="absolute left-1 top-1 h-7 w-7 rounded-full bg-white dark:bg-slate-900 shadow-md transform transition-transform duration-300 dark:translate-x-7 z-10 flex items-center justify-center border border-slate-200/80 dark:border-slate-700/80"
              aria-hidden="true"
            >
              <span class="hidden dark:inline text-[11px]">🌙</span>
              <span class="inline dark:hidden text-[11px]">☀️</span>
            </span>
          </button>

          <button
            id="mobile-nav-toggle"
            type="button"
            class="xl:hidden h-10 w-10 inline-flex items-center justify-center rounded-full bg-black/[0.04] dark:bg-white/[0.08] text-ink-800 dark:text-slate-100 touch-manipulation"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="Open menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-panel" class="hidden xl:hidden border-t border-black/[0.05] dark:border-white/[0.08] bg-white/95 dark:bg-ink-950/95 backdrop-blur-xl">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-3 grid grid-cols-1 gap-1.5 text-[0.95rem] font-medium" aria-label="Tools">
          {mobileNav.map((item) => (
            <a
              href={item.href}
              class="px-4 py-3 rounded-xl bg-ink-50 dark:bg-white/[0.05] text-ink-800 dark:text-slate-100 hover:bg-brand-50 dark:hover:bg-brand-950/40 hover:text-brand-700 transition-colors touch-manipulation"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
      <script is:inline>
        (function () {
          var btn = document.getElementById('mobile-nav-toggle');
          var panel = document.getElementById('mobile-nav-panel');
          if (btn && panel) {
            btn.addEventListener('click', function () {
              var open = panel.classList.toggle('hidden') === false;
              btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            });
          }

          var header = document.getElementById('site-header');
          if (header) {
            function updateHeader() {
              if (window.scrollY > 20) {
                header.classList.remove('bg-transparent', 'border-transparent');
                header.classList.add(
                  'bg-white/85',
                  'dark:bg-ink-950/85',
                  'backdrop-blur-xl',
                  'border-black/[0.05]',
                  'dark:border-white/[0.08]',
                  'shadow-sm'
                );
              } else {
                header.classList.remove(
                  'bg-white/85',
                  'dark:bg-ink-950/85',
                  'backdrop-blur-xl',
                  'border-black/[0.05]',
                  'dark:border-white/[0.08]',
                  'shadow-sm'
                );
                header.classList.add('bg-transparent', 'border-transparent');
              }
            }
            window.addEventListener('scroll', updateHeader, { passive: true });
            updateHeader();
          }
        })();
      </script>
    </header>

    <div class="relative w-full overflow-x-hidden flex-1">
      {!clean && (
        <>
          {/* Left floating pin collage with water droplet bubbles on hover */}
          <div class="hidden lg:block absolute left-1 lg:left-3 2xl:left-6 top-16 w-36 lg:w-44 2xl:w-52 pointer-events-none select-none z-20">
            <div class="transform -rotate-6 pointer-events-auto group/pin relative mb-6">
              <!-- Water droplet background bubbles -->
              <div class="absolute -top-3 -left-3 w-8 h-8 rounded-full bg-gradient-to-br from-pink-400/50 to-red-500/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-y-4 group-hover/pin:-translate-x-2 group-hover/pin:scale-125 transition-all duration-500 ease-out z-0 border border-white/50 shadow-md shadow-red-500/20"></div>
              <div class="absolute -bottom-3 -right-3 w-10 h-10 rounded-full bg-gradient-to-tr from-red-500/40 to-rose-400/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:translate-y-4 group-hover/pin:translate-x-2 group-hover/pin:scale-110 transition-all duration-500 delay-75 ease-out z-0 border border-white/40 shadow-md"></div>
              <div class="absolute top-1/2 -right-4 w-6 h-6 rounded-full bg-gradient-to-r from-rose-300/50 to-pink-500/30 backdrop-blur-sm opacity-0 group-hover/pin:opacity-100 group-hover/pin:translate-x-4 group-hover/pin:-translate-y-3 group-hover/pin:scale-125 transition-all duration-500 delay-100 ease-out z-0 border border-white/40"></div>
              <div class="absolute -top-4 right-4 w-5 h-5 rounded-full bg-gradient-to-b from-red-400/40 to-pink-300/30 backdrop-blur-sm opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-y-5 group-hover/pin:scale-110 transition-all duration-500 delay-150 ease-out z-0 border border-white/40"></div>

              <div class="relative z-10 p-1.5 sm:p-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-2xl shadow-red-950/10 group-hover/pin:scale-[1.04] group-hover/pin:shadow-red-500/20 group-hover/pin:border-red-300 dark:group-hover/pin:border-red-600 transition-all duration-500 cursor-pointer">
                <img src="/images/side_pin_1.jpg" alt="" class="w-full h-44 lg:h-56 object-cover rounded-xl" width="192" height="224" loading="lazy" decoding="async" />
                <div class="p-1.5 text-left">
                  <span class="text-[9px] lg:text-[10px] font-bold uppercase tracking-wider text-[#E11D48] block">Interior · Pin</span>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate">Cozy home decor</p>
                </div>
              </div>
            </div>

            <div class="transform rotate-3 translate-y-4 translate-x-4 pointer-events-auto group/pin relative">
              <!-- Water droplet background bubbles -->
              <div class="absolute -top-3 -right-3 w-9 h-9 rounded-full bg-gradient-to-br from-red-400/40 to-pink-500/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-y-3 group-hover/pin:translate-x-3 group-hover/pin:scale-125 transition-all duration-500 ease-out z-0 border border-white/50 shadow-md shadow-red-500/20"></div>
              <div class="absolute -bottom-2 -left-3 w-7 h-7 rounded-full bg-gradient-to-tr from-rose-500/40 to-pink-400/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:translate-y-3 group-hover/pin:-translate-x-3 transition-all duration-500 delay-75 ease-out z-0 border border-white/40"></div>
              <div class="absolute top-1/3 -left-4 w-5 h-5 rounded-full bg-gradient-to-r from-pink-300/50 to-rose-400/30 backdrop-blur-sm opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-x-4 transition-all duration-500 delay-100 ease-out z-0 border border-white/40"></div>

              <div class="relative z-10 p-1.5 sm:p-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-2xl shadow-slate-900/10 group-hover/pin:scale-[1.04] group-hover/pin:shadow-red-500/20 group-hover/pin:border-red-300 dark:group-hover/pin:border-red-600 transition-all duration-500 cursor-pointer">
                <img src="/images/side_pin_3.jpg" alt="" class="w-full h-36 lg:h-48 object-cover rounded-xl" width="192" height="192" loading="lazy" decoding="async" />
                <div class="p-1.5 text-left">
                  <span class="text-[9px] lg:text-[10px] font-bold uppercase tracking-wider text-[#E11D48] block">Lifestyle · Pin</span>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate">Matcha &amp; pastry</p>
                </div>
              </div>
            </div>
          </div>

          {/* Right floating pin collage with water droplet bubbles on hover */}
          <div class="hidden lg:block absolute right-1 lg:right-3 2xl:right-6 top-20 w-36 lg:w-44 2xl:w-52 pointer-events-none select-none z-20">
            <div class="transform rotate-6 pointer-events-auto group/pin relative mb-6">
              <!-- Water droplet background bubbles -->
              <div class="absolute -top-3 -right-3 w-9 h-9 rounded-full bg-gradient-to-br from-pink-400/50 to-red-500/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-y-4 group-hover/pin:translate-x-2 group-hover/pin:scale-125 transition-all duration-500 ease-out z-0 border border-white/50 shadow-md shadow-red-500/20"></div>
              <div class="absolute -bottom-3 -left-3 w-8 h-8 rounded-full bg-gradient-to-tr from-red-500/40 to-rose-400/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:translate-y-3 group-hover/pin:-translate-x-2 group-hover/pin:scale-110 transition-all duration-500 delay-75 ease-out z-0 border border-white/40 shadow-md"></div>
              <div class="absolute top-1/2 -left-4 w-6 h-6 rounded-full bg-gradient-to-r from-rose-300/50 to-pink-500/30 backdrop-blur-sm opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-x-3 group-hover/pin:-translate-y-2 group-hover/pin:scale-125 transition-all duration-500 delay-100 ease-out z-0 border border-white/40"></div>

              <div class="relative z-10 p-1.5 sm:p-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-2xl shadow-red-950/10 group-hover/pin:scale-[1.04] group-hover/pin:shadow-red-500/20 group-hover/pin:border-red-300 dark:group-hover/pin:border-red-600 transition-all duration-500 cursor-pointer">
                <img src="/images/side_pin_2.jpg" alt="" class="w-full h-44 lg:h-56 object-cover rounded-xl" width="192" height="224" loading="lazy" decoding="async" />
                <div class="p-1.5 text-left">
                  <span class="text-[9px] lg:text-[10px] font-bold uppercase tracking-wider text-[#E11D48] block">Travel · Pin</span>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate">Golden hour views</p>
                </div>
              </div>
            </div>

            <div class="transform -rotate-3 translate-y-4 -translate-x-4 pointer-events-auto group/pin relative">
              <!-- Water droplet background bubbles -->
              <div class="absolute -top-3 -left-3 w-8 h-8 rounded-full bg-gradient-to-br from-red-400/40 to-pink-500/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:-translate-y-3 group-hover/pin:-translate-x-2 group-hover/pin:scale-125 transition-all duration-500 ease-out z-0 border border-white/50 shadow-md shadow-red-500/20"></div>
              <div class="absolute -bottom-2 -right-3 w-7 h-7 rounded-full bg-gradient-to-tr from-rose-500/40 to-pink-400/30 backdrop-blur-md opacity-0 group-hover/pin:opacity-100 group-hover/pin:translate-y-3 group-hover/pin:translate-x-2 transition-all duration-500 delay-75 ease-out z-0 border border-white/40"></div>

              <div class="relative z-10 p-1.5 sm:p-2 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-2xl shadow-slate-900/10 group-hover/pin:scale-[1.04] group-hover/pin:shadow-red-500/20 group-hover/pin:border-red-300 dark:group-hover/pin:border-red-600 transition-all duration-500 cursor-pointer">
                <img src="/images/side_pin_4.jpg" alt="" class="w-full h-36 lg:h-48 object-cover rounded-xl" width="192" height="192" loading="lazy" decoding="async" />
                <div class="p-1.5 text-left">
                  <span class="text-[9px] lg:text-[10px] font-bold uppercase tracking-wider text-[#E11D48] block">Fashion · Pin</span>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100 truncate">Street style chic</p>
                </div>
              </div>
            </div>
          </div>
        </>
      )}

      <main
        id="main-content"
        class:list={[
          'relative z-10 flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col',
          fullBleed ? 'max-w-none px-0 py-0' : 'max-w-6xl',
        ]}
      >
        <slot />
      </main>
    </div>

    <footer class="w-full border-t border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-950 py-14 sm:py-16 text-base text-ink-500 dark:text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-12">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 text-left">
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="inline-flex items-center gap-2.5 mb-4">
              <img src="/images/logo.png" alt="" width="32" height="48" class="h-8 w-auto object-contain" />
              <span class="font-semibold text-lg text-ink-900 dark:text-white tracking-tight">
                Pint<span class="text-brand-600">Download</span>
              </span>
            </a>
            <p class="text-[0.95rem] leading-relaxed text-ink-500 dark:text-slate-400 max-w-xs">
              {BRAND.tagline}. Free public pin, video, board, and profile downloads — no account, no watermark from us.
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-ink-900 dark:text-white mb-4 text-[1.05rem]">Tools</h4>
            <ul class="space-y-2.5 text-[0.95rem] font-medium">
              <li><a href="/pinterest-video-downloader" class="hover:text-brand-600 transition-colors">Pinterest Video Downloader</a></li>
              <li><a href="/pinterest-pin-downloader" class="hover:text-brand-600 transition-colors">Pinterest Pin Downloader</a></li>
              <li><a href="/pinterest-board-downloader" class="hover:text-brand-600 transition-colors">Pinterest Board Downloader</a></li>
