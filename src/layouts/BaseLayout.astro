---
import { BRAND } from '../lib/brand';
import { absoluteUrl, normalizeCanonical } from '../lib/urls';
import StickyPasteBar from '../components/StickyPasteBar';
import FooterKeywordMatrix from '../components/FooterKeywordMatrix.astro';
import LanguageSelector from '../components/LanguageSelector';
import '../styles/ticket.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** fullBleed removes max-width constraint (hero pages) */
  fullBleed?: boolean;
  /** Hide decorative side pins */
  clean?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  /** Ticket stock the page is printed on (hero field + header) */
  field?: 'red' | 'tangerine' | 'canary' | 'lilac' | 'mint' | 'sky' | 'blush' | 'counter';
}

const {
  title,
  description,
  canonicalUrl,
  image,
  ogType = 'website',
  fullBleed = false,
  clean = false,
  jsonLd,
  noindex = false,
  field = 'red',
} = Astro.props;

// Always normalize: no trailing slash except homepage
const currentCanonical = normalizeCanonical(
  canonicalUrl || absoluteUrl(Astro.url.pathname),
);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogImage = image
  ? image.startsWith('http')
    ? image
    : absoluteUrl(image.startsWith('/') ? image : `/${image}`)
  : absoluteUrl(BRAND.ogImage);

const pathName = Astro.url.pathname.replace(/\/$/, '');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    ...(pathName
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title.split('—')[0].trim(),
            item: currentCanonical,
          },
        ]
      : []),
  ],
};

const websiteSearchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: BRAND.name,
  url: absoluteUrl('/'),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${absoluteUrl('/')}?url={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${absoluteUrl('/')}#organization`,
  name: BRAND.name,
  url: absoluteUrl('/'),
  description: BRAND.description,
  logo: {
    '@type': 'ImageObject',
    url: absoluteUrl('/images/logo.png'),
  },
  email: BRAND.email.support,
  sameAs: ['https://github.com/kunalsiyag', 'https://x.com/pintdownload'],
};

const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const fieldClass = field === 'counter' ? '' : `field-${field}`;
const themeColor = { red: '#C8281A', tangerine: '#F08A3C', canary: '#F4C531', lilac: '#B79CE8', mint: '#6CC79A', sky: '#7DB7E8', blush: '#F29BB4', counter: '#E4E6E9' }[field];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
/** 'page' on the item's own URL, 'true' anywhere inside its section (blog articles under Guides). */
const navCurrent = (href: string): 'page' | 'true' | undefined =>
  currentPath === href ? 'page' : href !== '/' && currentPath.startsWith(`${href}/`) ? 'true' : undefined;

/** Header navigation — concise labels for clean header spacing */
const nav = [
  { href: '/pinterest-video-downloader', label: 'Videos' },
  { href: '/pinterest-pin-downloader', label: 'Pins' },
  { href: '/pinterest-image-downloader', label: 'Images' },
  { href: '/pinterest-gif-downloader', label: 'GIFs' },
  { href: '/pinterest-board-downloader', label: 'Boards' },
  { href: '/pinterest-profile-picture-downloader', label: 'Avatar' },
  { href: '/pinterest-profile-downloader', label: 'Profiles' },
  { href: '/blog', label: 'Guides' },
];

const mobileNav = [
  { href: '/pinterest-video-downloader', label: 'Pinterest Video Downloader' },
  { href: '/pinterest-pin-downloader', label: 'Pinterest Pin Downloader' },
  { href: '/pinterest-board-downloader', label: 'Pinterest Board Downloader' },
  { href: '/pinterest-profile-picture-downloader', label: 'Pinterest Avatar / DP Downloader' },
  { href: '/pinterest-profile-downloader', label: 'Pinterest Profile Downloader' },
  { href: '/pinterest-gif-downloader', label: 'Pinterest GIF Downloader' },
  { href: '/pinterest-image-downloader', label: 'Pinterest Photo Downloader' },
  { href: '/blog', label: 'Blog & Guides' },
  { href: '/how-to-download-pinterest-videos', label: 'How to Download' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact Support' },
];
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BRAND.name} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <link rel="canonical" href={currentCanonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={absoluteUrl('/sitemap.xml')} />
    {/* Only declare real locale URLs. Fake multi-locale hreflang pointing at English hurts SEO. */}
    <link rel="alternate" hreflang="en" href={currentCanonical} />
    <link rel="alternate" hreflang="x-default" href={currentCanonical} />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${BRAND.name} Blog`}
      href={absoluteUrl('/rss.xml')}
    />
    <link rel="search" type="application/opensearchdescription+xml" title={BRAND.name} href="/opensearch.xml" />

    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pintdownload" />
    <meta name="twitter:url" content={currentCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSearchSchema)} />
    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {adClient && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>
    )}
    <link rel="preload" href="/fonts/big-shoulders-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/big-shoulders-display-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['min-h-screen flex flex-col font-sans antialiased overflow-x-hidden', fieldClass]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-3 focus:rounded-md focus:bg-ink-900 focus:text-white focus:font-bold"
    >
      Skip to content
    </a>

    <header id="site-header" class:list={['relative z-40 w-full', field === 'counter' ? 'bg-[var(--counter)] text-[var(--ink)] border-b-2 border-[var(--ink)]' : 'field']}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[4.5rem] flex items-center justify-between gap-4 lg:gap-6 xl:gap-4">
        <a href="/" class="flex items-center gap-2 min-w-0 shrink-0 rounded-md" aria-label="PintDownload home">
          <span class="grid place-items-center h-10 w-10 rounded-md bg-white shrink-0">
            <img src="/images/logo.png" alt="PintDownload logo" width="28" height="28" class="h-7 w-7 object-contain" decoding="async" />
          </span>
          <span class="t-display text-[1.6rem] leading-none tracking-[0.01em]" translate="no">PintDownload</span>
        </a>

        <nav class="hidden lg:flex items-center [justify-content:safe_center] flex-1 min-w-0 gap-0 xl:gap-1 text-[0.9rem] xl:text-[0.95rem] font-bold" aria-label="Main Navigation">
          {nav.map((item) => {
            const current = navCurrent(item.href);
            const isActive = Boolean(current);
            return (
              <a
                href={item.href}
                aria-current={current}
                class:list={[
                  'px-1.5 xl:px-3 py-2 rounded-md whitespace-nowrap transition-colors',
                  isActive ? 'bg-ink-900 text-white' : 'hover:bg-black/10',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <div class="hidden sm:block"><LanguageSelector client:idle /></div>
          <button
            id="theme-toggle-btn"
            type="button"
            class="h-11 w-11 inline-flex items-center justify-center rounded-md hover:bg-black/10 touch-manipulation"
            aria-label="Toggle light and dark mode"
          >
            <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button
            id="mobile-nav-toggle"
            type="button"
            class="lg:hidden h-11 w-11 inline-flex items-center justify-center rounded-md hover:bg-black/10 touch-manipulation"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="Open menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-nav-panel" class="hidden lg:hidden absolute left-0 right-0 top-full z-50 bg-ink-900 text-white">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-2 text-base font-semibold" aria-label="Tools">
          <div class="sm:hidden py-3 flex items-center justify-between gap-3 border-b-2 border-dashed border-white/20">
            <span class="t-label">Language</span>
            <LanguageSelector client:idle />
          </div>
          <ul class="divide-y-2 divide-dashed divide-white/20">
            {mobileNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={navCurrent(item.href)}
                  class="flex items-center justify-between min-h-[3.25rem] px-1 hover:text-stock-canary touch-manipulation"
                >
                  {item.label}
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <script is:inline>
        (function () {
          var btn = document.getElementById('mobile-nav-toggle');
          var panel = document.getElementById('mobile-nav-panel');
          if (btn && panel) {
            btn.addEventListener('click', function () {
              var open = panel.classList.toggle('hidden') === false;
              btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            });
            document.addEventListener('keydown', function (e) {
              if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
                panel.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
                btn.setAttribute('aria-label', 'Open menu');
                btn.focus();
              }
            });
          }
          var theme = document.getElementById('theme-toggle-btn');
          if (theme) {
            theme.addEventListener('click', function () {
              var h = document.documentElement;
              var dark = !h.classList.contains('dark');
              h.classList.toggle('dark', dark);
              h.classList.toggle('light', !dark);
              try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
            });
          }
        })();
      </script>
    </header>

    <main
      id="main-content"
      class:list={[
        'relative flex-1 w-full mx-auto flex flex-col',
        fullBleed ? 'max-w-none' : 'max-w-6xl px-4 sm:px-6 py-8 sm:py-12',
      ]}
    >
      <slot />
    </main>

    <FooterKeywordMatrix />

    <footer class="w-full bg-ink-950 text-slate-300 pt-10 pb-28 lg:pb-14 text-base">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-10">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 text-left">
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="inline-flex items-center gap-2 mb-4 rounded-md" aria-label="PintDownload home">
              <span class="grid place-items-center h-9 w-9 rounded-md bg-white shrink-0">
                <img src="/images/logo.png" alt="PintDownload logo" width="24" height="24" class="h-6 w-6 object-contain" loading="lazy" />
              </span>
              <span class="t-display text-2xl text-white" translate="no">PintDownload</span>
            </a>
            <p class="text-[0.95rem] leading-relaxed max-w-xs">
              {BRAND.tagline}. Free public pin, video, board, and profile downloads — no account, no watermark from us.
            </p>
          </div>

          <div>
            <h2 class="t-label text-stock-canary mb-4">Tools</h2>
            <ul class="space-y-1 text-[0.95rem] font-medium">
              <li><a href="/pinterest-video-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest Video Downloader</a></li>
              <li><a href="/pinterest-pin-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest Pin Downloader</a></li>
              <li><a href="/pinterest-board-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest Board Downloader</a></li>
              <li><a href="/pinterest-image-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest Photo Downloader</a></li>
              <li><a href="/pinterest-profile-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest Profile Downloader</a></li>
              <li><a href="/pinterest-gif-downloader" class="inline-block py-1 hover:text-white hover:underline">Pinterest GIF Downloader</a></li>
            </ul>
          </div>

          <div>
            <h2 class="t-label text-stock-canary mb-4">Learn</h2>
            <ul class="space-y-1 text-[0.95rem] font-medium">
              <li><a href="/blog" class="inline-block py-1 hover:text-white hover:underline">Blog</a></li>
              <li><a href="/rss.xml" class="inline-block py-1 hover:text-white hover:underline">RSS</a></li>
              <li><a href="/how-to-download-pinterest-videos" class="inline-block py-1 hover:text-white hover:underline">How-to guide</a></li>
              <li><a href="/blog/troubleshooting-pinterest-downloads" class="inline-block py-1 hover:text-white hover:underline">Troubleshooting</a></li>
              <li><a href="/blog/pin-vs-board-vs-profile-urls-explained" class="inline-block py-1 hover:text-white hover:underline">URL types</a></li>
            </ul>
          </div>

          <div>
            <h2 class="t-label text-stock-canary mb-4">Company</h2>
            <ul class="space-y-1 text-[0.95rem] font-medium">
              <li><a href="/about" class="inline-block py-1 hover:text-white hover:underline">About</a></li>
              <li><a href="/contact" class="inline-block py-1 hover:text-white hover:underline">Contact</a></li>
              <li><a href="/privacy-policy" class="inline-block py-1 hover:text-white hover:underline">Privacy</a></li>
              <li><a href="/terms-of-service" class="inline-block py-1 hover:text-white hover:underline">Terms</a></li>
              <li>
                <a href={`mailto:${BRAND.email.support}`} class="inline-block py-1 hover:text-white hover:underline break-all">
                  {BRAND.email.support}
                </a>
              </li>
              <li>
                <a href={`mailto:${BRAND.email.feedback}`} class="inline-block py-1 hover:text-white hover:underline break-all">
                  {BRAND.email.feedback}
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pt-6 border-t-2 border-dashed border-white/20 text-[0.9rem]">
          <p>© {new Date().getFullYear()} {BRAND.name} · {BRAND.domain}</p>
          <p class="md:text-right max-w-lg">
            Credit original creators when you reuse clips. Independent tool — not affiliated with Pinterest Inc.
          </p>
        </div>
      </div>
    </footer>
    <StickyPasteBar client:idle />
  </body>
</html>

<style is:global>
  html {
    font-size: 100%;
    scroll-behavior: smooth;
  }

  @media (min-width: 768px) {
    html {
      font-size: 106.25%;
    }
  }

  body {
    touch-action: manipulation;
    -webkit-tap-highlight-color: rgba(200, 40, 26, 0.18);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
