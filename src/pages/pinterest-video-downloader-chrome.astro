---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import { BRAND } from '../lib/brand';
import { webPageSchema, softwareAppSchema, howToSchema, faqSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-video-downloader-chrome';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Video Downloader Chrome — 1-Click Browser Tool';
const description =
  'Pinterest video downloader for Chrome: a 1-click bookmarklet, not a store extension. Save public videos, photos, and boards from the tab you are on.';

const steps = [
  {
    title: 'Drag Bookmarklet to Chrome Bookmarks Bar',
    body: 'Drag our interactive "PintDownload" button directly to your Chrome, Safari, or Edge bookmarks bar.',
  },
  {
    title: 'Browse Pinterest.com',
    body: 'Browse Pinterest normally. When you find a video, pin, or board you want to save, stay on that page.',
  },
  {
    title: 'Click Bookmarklet to Instantly Download',
    body: 'Click your PintDownload bookmarklet once in your toolbar — it instantly launches PintDownload with your current pin URL prefilled.',
  },
];

const faqs = [
  {
    q: 'Does PintDownload work as a Chrome Extension?',
    a: 'Yes! You can install our 1-click drag-and-drop bookmarklet on Google Chrome, Edge, Safari, and Brave. It acts just like a Chrome extension without consuming browser RAM or requiring background extension permissions.',
  },
  {
    q: 'Why is a bookmarklet safer than installing Chrome web store extensions?',
    a: 'Web store extensions often request invasive browser permissions (reading all site data, tracking tabs). Our bookmarklet uses pure client-side JavaScript that only runs when you click it.',
  },
  {
    q: 'Can I use this Chrome downloader tool on Mac and Windows?',
    a: 'Yes. It works seamlessly across Windows 11/10, macOS, Linux, and Chromebook desktops running Chrome, Edge, Safari, or Opera.',
  },
  {
    q: 'Is there a Pinterest video downloader Chrome extension I need to install?',
    a: 'You do not need a Chrome Web Store extension. The bookmarklet on this page is the 1-click Chrome downloader: drag it to the bookmarks bar, open a pin, click once.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Video Downloader Chrome & Browser Tool',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to Use Pinterest Video Downloader in Chrome',
    description,
    steps: steps.map((s) => ({ name: s.title, text: s.body })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout field="red" title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Minimalist Hero card matching original downloader layout -->
  <TicketHero title={"Pinterest Video Downloader Chrome Tool"} variant="hub" />

  <!-- SEO Content downside -->
  <article class="tool-body flex flex-col w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-12 sm:pb-16 text-start">
    <div class="w-full max-w-3xl mb-8 counter-rule pt-4">
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-4 leading-relaxed">
        1-Click download tool for <strong class="text-slate-900 dark:text-white">Google Chrome, Safari, and Edge</strong> browsers — save HD MP4 videos and pins without leaving Pinterest.
      </p>
    </div>

    <!-- Unique Chrome Feature Cards -->
    <div class="w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-start text-sm mb-12">
      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">🌐</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Chrome &amp; Edge Integration</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Drag-and-drop bookmarklet bar integration provides instant extension functionality directly inside Chrome and Edge.</p>
      </div>

      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">🛡️</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Zero Permission Risks</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">No store extensions tracking your private data or history. Safe, lightweight, and zero RAM overhead.</p>
      </div>

      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">🚀</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">1-Click Tab prefills</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Clicking the bookmarklet on any Pinterest pin opens PintDownload with the video URL prefilled and ready to export.</p>
      </div>
    </div>

    <BookmarkletGuide />
    <HowToSteps title="How to use Pinterest downloader in Chrome" intro="3 steps for 1-click Chrome downloads." exampleUrl="https://pin.it/…" exampleLabel="Pinterest Link" steps={steps} visual stripe={true} />
    <FaqSection items={faqs} title="Chrome Extension FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
