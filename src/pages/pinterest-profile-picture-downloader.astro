---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import HowToSteps from '../components/seo/HowToSteps.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import { BRAND } from '../lib/brand';
import { webPageSchema, softwareAppSchema, howToSchema, faqSchema } from '../lib/seo';

const path = '/pinterest-profile-picture-downloader';
const pageUrl = `${BRAND.url}${path}`;
const title = 'Pinterest Profile Picture Downloader — Save HD Avatars Free';
const description =
  'Download full size, high resolution profile pictures and avatar photos from any Pinterest user account instantly in HD quality for free.';

const steps = [
  {
    title: 'Copy Pinterest Profile Link',
    body: 'Copy the URL of any user or brand profile on Pinterest (e.g., https://pinterest.com/username/).',
  },
  {
    title: 'Paste Profile Link Above',
    body: 'Paste the profile URL into our online profile avatar extractor above and click Download.',
  },
  {
    title: 'Download Uncompressed HD Avatar',
    body: 'Click "Download Profile Picture" to save the original high-resolution profile photo directly to your device.',
  },
];

const faqs = [
  {
    q: 'How to download a Pinterest profile picture in full high resolution?',
    a: 'Paste the user profile URL into PintDownload. Our tool automatically fetches the original uncompressed HD avatar image source from Pinterest CDN and gives you a 1-click HD download.',
  },
  {
    q: 'Can I download private profile pictures?',
    a: 'Only public profile pictures and public avatar photos can be extracted.',
  },
  {
    q: 'What resolution are the downloaded profile pictures?',
    a: 'Pinterest profile avatars are stored on CDN servers up to 600x600 HD resolution. PintDownload extracts the highest resolution source available.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Profile Picture Downloader',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to Download Pinterest Profile Picture in HD',
    description,
    steps: steps.map((s) => ({ name: s.title, text: s.body })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Minimalist Hero card matching original downloader layout -->
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    ></div>
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-slate-950/60 dark:via-slate-950/75 dark:to-slate-950/90"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-6 sm:mb-8"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">Profile Picture Downloader</span>
      </h1>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="profile" />
      </div>
    </div>
  </section>

  <!-- SEO Content downside -->
  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-[#E11D48] text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        👤 HD Profile Picture &amp; Avatar Downloader
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-4 leading-relaxed">
        Download original <strong class="text-slate-900 dark:text-white">full-resolution profile pictures</strong> and avatar icons from public Pinterest accounts.
      </p>
    </div>

    <!-- Unique Profile Feature Cards -->
    <div class="w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm mb-12">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">👤</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Original HD Avatars</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Fetches original uncompressed 600x600 avatar image files directly from CDN servers.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">⚡</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Username Link Parsing</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Supports full profile URLs, username links, and mobile profile share links.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">🖼️</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Clean JPG / PNG Format</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Exports clean profile picture graphics without watermarks or app frame overlays.</p>
      </div>
    </div>

    <HowToSteps title="How to download Pinterest profile picture in HD" intro="Save full-size profile avatars in 3 steps." exampleUrl="https://pinterest.com/username/" exampleLabel="Pinterest Profile URL" steps={steps} visual stripe={true} />
    <BookmarkletGuide />
    <FaqSection items={faqs} title="Profile Picture Downloader FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
