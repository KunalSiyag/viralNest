---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/brand';

// Server error page (SSR / Node adapter). Safe to prerender the shell.
export const prerender = true;
---

<BaseLayout
  title={`Something went wrong — ${BRAND.name}`}
  description={`A server error occurred on ${BRAND.domain}. Please try again or contact support.`}
  clean
  noindex
  fullBleed
>
  <section class="field" aria-labelledby="err-heading">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-12 pb-12 sm:pb-16 grid gap-8 lg:gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] items-start"
    >
      <div class="min-w-0">
        <h1
          id="err-heading"
          class="t-display text-[2.875rem] leading-[0.9] sm:text-6xl sm:leading-[0.88] lg:text-6xl max-w-[13ch]"
          style="text-wrap: balance;"
        >
          Something broke on our side.
        </h1>
        <p class="mt-4 sm:mt-5 text-[1.0625rem] sm:text-lg leading-relaxed max-w-xl text-[var(--on-field-2)]" style="text-wrap: pretty;">
          We’re sorry — the request failed unexpectedly. Refresh in a moment, try the home page, or email us if it keeps happening.
        </p>
      </div>

      <div class="ticket void-ticket min-w-0 w-full max-w-md lg:max-w-none">
        <div class="ticket-paper">
          <div class="ticket-head">
            <span class="t-label">Admit one · public link</span>
            <span class="ticket-serial" translate="no">No. 500</span>
          </div>
          <div class="ticket-body">
            <p class="void-no" aria-hidden="true">500</p>
            <p class="stamp stamp-warn stamp-in void-stamp">Server error</p>
            <div class="mt-6 grid grid-cols-2 gap-2 w-full">
              <a href="/" class="void-btn">Back to home</a>
              <a href="/contact" class="void-btn">Contact support</a>
            </div>
          </div>
        </div>
        <div class="perf" aria-hidden="true"></div>
        <div class="stub">
          <button type="button" onclick="window.location.reload()" class="stub-btn">Try again</button>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" aria-labelledby="err-report">
    <div class="counter-rule pt-6 grid gap-x-10 gap-y-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] items-end">
      <h2 id="err-report" class="t-display text-4xl sm:text-5xl leading-[0.95]">Report it</h2>
      <p class="text-base text-[var(--ink-2)] leading-relaxed">
        Include the page URL and what you were doing. We read every message.
      </p>
    </div>
    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-base">
      <a href={`mailto:${BRAND.email.support}?subject=${encodeURIComponent('500 error on ' + BRAND.domain)}`} class="font-semibold text-[var(--ink)] underline decoration-2 decoration-[var(--red)] hover:text-[var(--red)] dark:hover:text-[#EC8C7D] break-all">
        {BRAND.email.support}
      </a>
      <a href={`mailto:${BRAND.email.feedback}`} class="font-semibold text-[var(--ink)] underline decoration-2 decoration-[var(--red)] hover:text-[var(--red)] dark:hover:text-[#EC8C7D] break-all">
        {BRAND.email.feedback}
      </a>
    </p>
  </section>
</BaseLayout>
