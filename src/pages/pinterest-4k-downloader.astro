---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest 4K & HD Video Downloader — PintDownload",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout field="tangerine" fullBleed   title="Pinterest 4K & 1080p Full HD Video Downloader Free"
  description="Download Pinterest videos in maximum 1080p Full HD and 4K ultra quality. Save original uncompressed MP4 videos and images directly to your gallery."
  jsonLd={webAppSchema}
>
  <TicketHero title={"Pinterest 4K & 1080p HD Video Downloader"} variant="video" />
  <div class="flex flex-col items-center py-10 sm:py-14 text-center w-full max-w-6xl mx-auto px-4 sm:px-6">

    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-3xl mt-6">
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Download Pinterest videos in original 1080p Full HD and highest available bitrate quality without compression artifacts or watermarks.
      </p>
    </div>
  </div>
</BaseLayout>
