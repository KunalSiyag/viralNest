---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-profile-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Profile Downloader — Save User Pins as ZIP Free';
const description =
  'Download all public pins, videos, and photos from any Pinterest user profile in high resolution ZIP archives fast and free with no login.';

const faqs = [
  {
    q: 'How do I download pins from a Pinterest profile?',
    a: 'Open the public profile, copy the URL shaped like pinterest.com/username/, paste it into this profile downloader, extract pins, then download the ZIP of visible public pins.',
  },
  {
    q: 'What is the difference between profile and board download?',
    a: 'A profile URL is one path segment (the username). A board URL has username plus board slug. Profiles list pins shown on the creator page; boards are one curated collection.',
  },
  {
    q: 'Can I download every pin a user ever posted?',
    a: 'No bulk tool can guarantee a full historical dump of a large account. PintDownload extracts public pins visible from the profile page response, up to a practical public limit.',
  },
  {
    q: 'Do private profiles work?',
    a: 'Private or restricted profiles cannot be scraped. Only public profiles and public pins are supported.',
  },
  {
    q: 'Is profile download legal / allowed?',
    a: 'Only download content you have rights to use. PintDownload is a technical helper for public media links; respect creators, Pinterest terms, and copyright.',
  },
  {
    q: 'Why use a profile ZIP instead of saving pins one by one?',
    a: 'Creators, agencies, and researchers often need a quick offline pack of a public feed for moodboarding or backup. ZIP avoids dozens of manual downloads.',
  },
  {
    q: 'I only want the profile picture / PFP / DP — is this the right tool?',
    a: 'No. This page packs public pins into a ZIP. To download just the HD avatar, use the Pinterest Profile Picture Downloader.',
  },
];

const steps = [
  { title: 'Open the public profile', body: 'Go to the creator’s Pinterest profile page (their avatar / username page).' },
  { title: 'Copy the profile URL', body: 'Copy a link like <code>https://www.pinterest.com/username/</code> — no board slug after the name.' },
  { title: 'Paste into the profile tool', body: 'Paste above and extract to list visible public pins from that profile.' },
  { title: 'Download the ZIP', body: 'Use <strong>Download ZIP</strong> to save the pack, or download individual pins from the grid.' },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Profile Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download a Pinterest profile as ZIP',
    description: 'Steps to bulk download public pins from a Pinterest profile into a ZIP archive.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Hero card with curved background image -->
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    />
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-6 sm:mb-8"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-rose-600 dark:text-rose-400">Profile Downloader</span>
      </h1>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="profile" />
      </div>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-rose-700 dark:text-rose-300 text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        Profile URL → bulk pin ZIP
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-3 leading-relaxed">
        Paste a public <strong class="text-slate-900 dark:text-white">profile URL</strong> (<code class="text-xs">pinterest.com/username/</code>)
        to extract visible pins and download them as a <strong class="text-slate-900 dark:text-white">ZIP</strong>.
      </p>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Works with <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">pinterest.com/username/</code> URLs.
        Public profiles only.
      </p>
    </div>
    <div class="mt-2 w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Profile intent</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Targets "download Pinterest profile" queries with username-only URLs.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Bulk ZIP</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">One archive of public pins shown on the profile page for offline use.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Public only</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">No private profiles, no secret boards, no login-gated media.</p>
      </div>
    </div>

    <div class="w-full max-w-4xl">
      <HowToSteps
        title="How to download Pinterest profile pins as a ZIP"
        intro="Use a profile link only. If the URL has a board name after the username, switch to the Board Downloader."
        exampleUrl="https://www.pinterest.com/pinterest/"
        exampleLabel="Example profile URL"
        steps={steps}
      />

      <section class="mt-14 text-left" aria-labelledby="profile-vs-board">
        <h2 id="profile-vs-board" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mb-3 scroll-mt-24">
          Profile ZIP vs board ZIP vs profile picture
        </h2>
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div class="p-4 rounded-2xl border-2 border-rose-500/30 bg-red-50/40 dark:bg-red-950/20 text-left">
            <h3 class="font-extrabold text-rose-700 dark:text-rose-400 mb-2">This page — Profile ZIP</h3>
            <ul class="space-y-1.5 text-slate-700 dark:text-slate-300 text-xs leading-relaxed list-disc pl-4">
              <li>URL: <code>pinterest.com/username/</code></li>
              <li>Goal: bulk pins from a creator's public page</li>
              <li>Output: multi-pin ZIP of visible pins</li>
            </ul>
          </div>
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-left">
            <h3 class="font-extrabold text-slate-900 dark:text-white mb-2">
              <a href="/pinterest-board-downloader" class="hover:text-rose-600 dark:hover:text-rose-400">Board Downloader →</a>
            </h3>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 text-xs leading-relaxed list-disc pl-4">
              <li>URL: <code>pinterest.com/username/board/</code></li>
              <li>Goal: one themed collection / moodboard</li>
              <li>Output: multi-pin ZIP of that board</li>
            </ul>
          </div>
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-left">
            <h3 class="font-extrabold text-slate-900 dark:text-white mb-2">
              <a href="/pinterest-profile-picture-downloader" class="hover:text-rose-600 dark:hover:text-rose-400">Avatar / DP only →</a>
            </h3>
            <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 text-xs leading-relaxed list-disc pl-4">
              <li>Same profile URL shape</li>
              <li>Goal: HD profile picture only</li>
              <li>Output: single avatar image (not ZIP)</li>
            </ul>
          </div>
        </div>
      </section>

      <CompareTable highlight="profile" />
      <FaqSection title="Pinterest profile downloader FAQ" items={faqs} />
      <RelatedTools current={path} title="Related tools (pin, board, video)" />
    </div>
  </article>
</BaseLayout>

