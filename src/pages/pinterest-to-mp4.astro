---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest to MP4 Converter — PintDownload",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I convert a Pinterest video to MP4?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Copy any Pinterest Pin URL, paste it into the PintDownload converter, and click Download MP4 Video to save the converted 1080p MP4 file to your device."
      }
    },
    {
      "@type": "Question",
      "name": "Is converting Pinterest videos to MP4 free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! PintDownload is 100% free with no registration, no subscription, and no watermarks."
      }
    }
  ]
};
---

<BaseLayout
  title="Pinterest to MP4 Converter — Convert Pinterest Video Online"
  description="Convert and download any Pinterest video link to high quality MP4 format. Fast, free online video converter with no registration required."
  jsonLd={[webAppSchema, faqSchema]}
>
  <div class="flex flex-col items-center justify-center py-6 sm:py-12 text-center w-full px-2 sm:px-6">
    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight max-w-3xl leading-tight mb-6 sm:mb-8">
      Convert <span class="text-[#E11D48]">Pinterest Videos to MP4</span> Online
    </h1>

    <div class="w-full max-w-3xl">
      <DownloaderForm client:load />
    </div>

    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-2xl mx-auto mt-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 text-[#E11D48] text-xs sm:text-sm font-bold mb-3 border border-red-200 dark:border-red-900/40 shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 8 6 4-6 4Z"/><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
        <span>Free Pinterest to MP4 Converter</span>
      </div>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Convert any video Pin, Idea Pin, or clip from Pinterest into high-definition MP4 format with audio. Free, fast, and no software installation required.
      </p>
    </div>
  </div>
</BaseLayout>
