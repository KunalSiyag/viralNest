---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-audio-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Audio Downloader — Extract MP3 from Video Pins';
const description =
  'Pinterest audio downloader: extract music or voice from a public video pin as MP3. Free, no login. Use only audio you have the right to keep.';

const steps = [
  {
    title: 'Copy a video pin that has sound',
    body: 'Mute/unmute on Pinterest first. Silent clips and GIFs have nothing useful to extract.',
  },
  {
    title: 'Paste the pin URL',
    body: 'Share → Copy link, or a <code>/pin/</code> URL. Extract on this page.',
  },
  {
    title: 'Download audio',
    body: 'Pick the MP3 line. Your browser makes a 192 kbps MP3 from the video\'s sound; nothing is uploaded. Credit the creator if you reuse the sound.',
  },
];

const faqs = [
  {
    q: 'How do I download audio from a Pinterest video?',
    a: 'Paste a public video pin URL into this Pinterest audio downloader and extract it. The MP3 line then makes an MP3 (192 kbps) from the video\'s sound in your browser. You can also keep the MP4, which has the sound too.',
  },
  {
    q: 'Is a Pinterest audio downloader legal?',
    a: 'Only extract audio you have rights to use (your own pin, licensed music, or personal reference). Public access is not a commercial license.',
  },
  {
    q: 'Why can\'t I get an MP3 from my pin?',
    a: 'The pin may be silent, a GIF, or a still photo, so there is no sound to save. Pinterest has no separate audio file: the MP3 is made from the video, so a very old browser that cannot read the video\'s sound cannot make it either. Try a current Chrome, Edge, Safari or Firefox.',
  },
  {
    q: 'How is the MP3 made?',
    a: 'Your browser fetches the video through PintDownload, decodes its sound and encodes a 192 kbps MP3 with LAME, the open-source MP3 encoder (LGPL, lame.sourceforge.io). The MP3 is made on your device and never uploaded.',
  },
  {
    q: 'Does this work without a Pinterest account?',
    a: 'Yes, for public video pins. Private and secret pins cannot be extracted.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Audio Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to extract audio from a Pinterest video',
    description: 'Paste a public video pin and save its sound as an MP3 made in your browser.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout field="tangerine" title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <TicketHero title={"Pinterest Audio Downloader"} lede={"Save the music or voice from a public Pinterest video pin as an MP3, made in your browser from the video’s sound."} variant="video" />

  <article class="tool-body flex flex-col w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-12 sm:pb-16 text-start">
    <HowToSteps
      title="How to extract audio from Pinterest"
      intro="Public video pins with sound only. Credit creators if you reuse the track."
      exampleUrl="https://pin.it/…"
      exampleLabel="Video pin link"
      steps={steps}
      stripe={true}
    />
    <FaqSection items={faqs} title="Pinterest audio download FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
