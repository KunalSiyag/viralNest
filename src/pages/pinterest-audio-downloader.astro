---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest Audio Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout 
  title="Pinterest Audio Downloader — Extract Music & MP3 from Pins" 
  description="Extract and download audio, background music, and sound tracks from Pinterest videos in high quality MP3 format instantly online for free."
  jsonLd={webAppSchema}
>
  <div class="flex flex-col items-center justify-center py-6 sm:py-12 text-center w-full px-2 sm:px-6">
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mb-6 tracking-tight leading-tight max-w-3xl">
      Pinterest <span class="text-[#E11D48]">Audio Downloader</span>
    </h1>
    
    <div class="w-full max-w-3xl">
      <DownloaderForm client:load />
    </div>

    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-2xl mx-auto mt-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 text-[#E11D48] text-xs sm:text-sm font-bold mb-3 border border-red-200 dark:border-red-900/40 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        Pinterest Audio &amp; Music Extractor
      </div>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
        Extract background audio and music tracks from viral Pinterest videos and Idea Pins.
      </p>
    </div>

    <!-- Info Box -->
    <div class="mt-10 w-full max-w-3xl text-left bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Extracting Audio from Pinterest Videos</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Paste any video pin link above to extract the original audio track or download the full media file to extract sound clips for your video projects.
      </p>
    </div>
  </div>
</BaseLayout>
