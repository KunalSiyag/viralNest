---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-audio-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Audio Downloader — Extract MP3 from Video Pins';
const description =
  'Pinterest audio downloader: extract music or voice from a public video pin as MP3. Free, no login. Use only audio you have the right to keep.';

const steps = [
  {
    title: 'Copy a video pin that has sound',
    body: 'Mute/unmute on Pinterest first. Silent clips and GIFs have nothing useful to extract.',
  },
  {
    title: 'Paste the pin URL',
    body: 'Share → Copy link, or a <code>/pin/</code> URL. Extract on this page.',
  },
  {
    title: 'Download audio',
    body: 'Choose the MP3 / audio option when listed, or download the MP4 and keep the soundtrack. Credit the creator if you reuse the sound.',
  },
];

const faqs = [
  {
    q: 'How do I download audio from a Pinterest video?',
    a: 'Paste a public video pin URL into this Pinterest audio downloader. When a soundtrack is available, save the MP3 (or download the MP4 and keep the audio track).',
  },
  {
    q: 'Is a Pinterest audio downloader legal?',
    a: 'Only extract audio you have rights to use (your own pin, licensed music, or personal reference). Public access is not a commercial license.',
  },
  {
    q: 'Why is there no MP3 on my pin?',
    a: 'The pin may be silent, a GIF, or a still. Confirm playback with sound on Pinterest, then retry. Some pins only expose video, not a separate audio file.',
  },
  {
    q: 'Does this work without a Pinterest account?',
    a: 'Yes, for public video pins. Private and secret pins cannot be extracted.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Audio Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to extract audio from a Pinterest video',
    description: 'Paste a public video pin and save the soundtrack when Pinterest exposes it.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mb-6 tracking-tight leading-tight max-w-3xl"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">Audio Downloader</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-6 leading-relaxed">
        Extract music or voice from a public Pinterest video pin — MP3 when the stream allows it.
      </p>
      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="video" />
      </div>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <HowToSteps
      title="How to extract audio from Pinterest"
      intro="Public video pins with sound only. Credit creators if you reuse the track."
      exampleUrl="https://pin.it/…"
      exampleLabel="Video pin link"
      steps={steps}
      stripe={true}
    />
    <FaqSection items={faqs} title="Pinterest audio download FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
