---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest Audio Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout 
  title="Pinterest Audio Downloader — Extract & Save Music from Pinterest Videos" 
  description="Extract audio and background music from Pinterest videos and Idea Pins online. Download sound clips in MP3 format for free."
  jsonLd={webAppSchema}
>
  <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      Pinterest Audio & Music Extractor
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight max-w-3xl">
      Pinterest <span class="text-[#E11D48]">Audio Downloader</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed font-medium">
      Extract background audio and music tracks from viral Pinterest videos and Idea Pins.
    </p>

    <DownloaderForm client:load />

    <!-- Info Box -->
    <div class="mt-16 w-full text-left bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Extracting Audio from Pinterest Videos</h2>
      <p class="text-slate-600 text-sm leading-relaxed">
        Paste any video pin link above to extract the original audio track or download the full media file to extract sound clips for your video projects.
      </p>
    </div>
  </div>
</BaseLayout>
