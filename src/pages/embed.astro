---
import DownloaderForm from '../components/DownloaderForm';
---

<!ts-html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PintDownload Embed Widget</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-transparent m-0 p-2 antialiased overflow-hidden font-sans">
    <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md">
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-2">
          <span class="font-extrabold text-sm text-slate-900 dark:text-white">Pint<span class="text-[#E11D48]">Download</span></span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-50 text-[#E11D48]">Free HD Downloader</span>
        </div>
      </div>
      <DownloaderForm client:load variant="hub" />
    </div>
  </body>
</html>
