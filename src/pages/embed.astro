---
import DownloaderForm from '../components/DownloaderForm';
import '../styles/ticket.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PintDownload Downloader Embed Widget</title>
    <meta name="description" content="Embed PintDownload free HD Pinterest video and photo downloader widget on your website." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://pintdownload.app/embed" />
  </head>
  <body class="field-red bg-transparent m-0 p-2 antialiased overflow-hidden font-sans">
    <div class="field p-3 sm:p-4 rounded-lg">
      <p class="t-display text-2xl mb-3" translate="no">PintDownload</p>
      <DownloaderForm client:load variant="hub" layout="hero" />
    </div>
  </body>
</html>
