---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest Story & Idea Pin Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout 
  title="Pinterest Story & Idea Pin Downloader — Save Pinterest Stories HD" 
  description="Download Pinterest Idea Pins, Story Pins, and carousel slideshows in high definition MP4 format. Free online Idea Pin downloader."
  jsonLd={webAppSchema}
>
  <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-[#E60023] text-xs sm:text-sm font-bold mb-6 border border-red-200 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-1.2 0-2.4.6-3 1.7A5 5 0 0 0 7 9c0 3.8 2.5 6.9 5 9 2.5-2.1 5-5.2 5-9a5 5 0 0 0-2-4.3c-.6-1.1-1.8-1.7-3-1.7Z"/><path d="M12 21v1"/><path d="M9 18h6"/></svg>
      Multi-Slide Story & Idea Pin Downloader
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight max-w-3xl">
      Pinterest <span class="text-[#E60023]">Idea Pin Downloader</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed font-medium">
      Download full video slides, audio, and content from Pinterest Idea Pins and Story Pins without watermarks.
    </p>

    <DownloaderForm client:load />

    <!-- Info Box -->
    <div class="mt-16 w-full text-left bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">What are Pinterest Idea Pins?</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-4">
        Idea Pins (formerly Story Pins) are multi-page video and image slideshows created by Pinterest creators. viralNest extracts all available video pages and high-res media from Idea Pins in one clean step.
      </p>
    </div>
  </div>
</BaseLayout>
