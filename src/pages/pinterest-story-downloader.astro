---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest Story & Idea Pin Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout field="tangerine" fullBleed 
  title="Pinterest Story & Idea Pin Downloader — Save Stories HD" 
  description="Download Pinterest Idea Pins, multi-page story pins and video stories as HD MP4, in the best quality each pin has. Fast on mobile and desktop, free."
  jsonLd={webAppSchema}
>
  <TicketHero title={"Pinterest Idea Pin Downloader"} variant="video" />
  <div class="flex flex-col items-center py-10 sm:py-14 text-center w-full max-w-6xl mx-auto px-4 sm:px-6">

    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-3xl mt-6">
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
        Download full video slides, audio, and content from Pinterest Idea Pins and Story Pins without watermarks.
      </p>
    </div>

    <!-- Info Box -->
    <div class="mt-10 w-full max-w-3xl text-start bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">What are Pinterest Idea Pins?</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
        Idea Pins (formerly Story Pins) are multi-page video and image slideshows created by Pinterest creators. PintDownload extracts all available video pages and high-res media from Idea Pins in one clean step.
      </p>
    </div>
  </div>
</BaseLayout>
