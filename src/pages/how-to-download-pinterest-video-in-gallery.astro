---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import HowToSteps from '../components/seo/HowToSteps.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import { BRAND } from '../lib/brand';
import { webPageSchema, softwareAppSchema, howToSchema, faqSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/how-to-download-pinterest-video-in-gallery';
const pageUrl = absoluteUrl(path);
const title = 'How to Save Pinterest Video in Phone Gallery (Easy Free Guide)';
const description =
  'Learn how to download Pinterest videos directly in your phone gallery or camera roll. Step-by-step free online guide for iPhone, iPad, and Android users.';

const steps = [
  {
    title: 'Copy Pinterest Video Link',
    body: 'Open the Pinterest app on your phone, tap the Share icon on the video, and click "Copy Link".',
  },
  {
    title: 'Paste Link in Online Tool',
    body: 'Open Safari or Chrome browser, paste the link in our downloader above, and tap "Download MP4".',
  },
  {
    title: 'Save to Phone Gallery / Photos',
    body: 'Tap your browser downloads manager, select the MP4 file, and tap "Save Video" to store it directly in your Gallery app.',
  },
];

const faqs = [
  {
    q: 'How to download Pinterest video in gallery without any app?',
    a: 'Paste the copied Pinterest link into PintDownload on your phone web browser (Safari or Chrome), tap Download MP4, and save the downloaded file to your device Photos / Gallery app.',
  },
  {
    q: 'Why does my downloaded Pinterest video not show up in my gallery?',
    a: 'On iOS iPhones, downloaded files first land in the Safari Downloads folder inside the Files app. Open Files -> Downloads, tap the video, tap Share, and choose "Save Video" so iOS moves it into your main Camera Roll gallery.',
  },
  {
    q: 'Does saving Pinterest videos to gallery cost money or require login?',
    a: 'No. PintDownload is 100% free and does not require creating an account or logging in.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'How to Download Pinterest Video in Gallery',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to Download Pinterest Video in Gallery',
    description,
    steps: steps.map((s) => ({ name: s.title, text: s.body })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Minimalist Hero card matching original downloader layout -->
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    ></div>
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-slate-950/60 dark:via-slate-950/75 dark:to-slate-950/90"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-6 sm:mb-8"
        style="text-wrap: balance;"
      >
        How to Download Pinterest <span class="text-[#E11D48]">Video in Gallery</span>
      </h1>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="video" />
      </div>
    </div>
  </section>

  <!-- SEO Content downside -->
  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-[#E11D48] text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        📌 Gallery Video Download Guide
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-4 leading-relaxed">
        Save any Pinterest video directly into your <strong class="text-slate-900 dark:text-white">phone gallery or camera roll</strong> in HD MP4 format.
      </p>
    </div>

    <!-- Unique Gallery Feature Cards -->
    <div class="w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm mb-12">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">🖼️</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Direct Gallery Export</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Saves MP4 video streams straight into your phone native Photos app gallery album.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">🎥</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Full High Definition MP4</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Maintains original audio clarity and video frame rates without re-encoding quality loss.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-[#E11D48] flex items-center justify-center font-bold mb-3">📱</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Works on iOS &amp; Android</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Fully compatible with Apple iPhone (iOS 13+ Safari) and Android (Chrome, Edge, Samsung Internet).</p>
      </div>
    </div>

    <HowToSteps title="How to save Pinterest video in gallery" intro="Follow these 3 simple steps to save videos to your phone photos gallery." exampleUrl="https://pin.it/…" exampleLabel="Pinterest Video URL" steps={steps} visual stripe={true} />
    <BookmarkletGuide />
    <FaqSection items={faqs} title="Gallery Download FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
