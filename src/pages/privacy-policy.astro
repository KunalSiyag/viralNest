---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/brand';
---

<BaseLayout
  title={`Privacy Policy — ${BRAND.name} Free Video Downloader`}
  description={`Read the official privacy policy for ${BRAND.name}. Learn how we respect user privacy, handle zero-log data, and protect user security.`}
  clean
>
  <div class="max-w-3xl mx-auto py-8 text-left">
    <nav class="text-sm font-medium text-ink-500 mb-8 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="text-ink-300" aria-hidden="true">/</span>
      <span class="text-ink-700 dark:text-slate-300">Privacy Policy</span>
    </nav>

    <h1 class="font-display text-4xl sm:text-5xl text-ink-900 dark:text-white mb-4">Privacy Policy</h1>
    <p class="text-sm text-ink-400 mb-8">Last updated: July 24, 2026</p>

    <div class="space-y-6 text-ink-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-medium">
      <p>
        At {BRAND.name} (accessible from {BRAND.url}), one of our main priorities is the privacy of our visitors. This Privacy Policy outlines the types of information collected and recorded by {BRAND.name} and how we use it.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">No account data</h2>
      <p>
        {BRAND.name} is a free online utility. We do not require users to register, create accounts, or provide personal information (such as names, emails, or phone numbers) to use the downloader.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">Log files</h2>
      <p>
        Like standard web services, {BRAND.name} may log basic technical metadata (such as IP addresses, browser types, timestamps, and requested URLs) for diagnostics, performance, abuse prevention, and rate limiting.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">Cookies &amp; local storage</h2>
      <p>
        {BRAND.name} does not use tracking cookies for advertising. We may use browser LocalStorage to store a small number of recent download links on your device for convenience.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">Email contact</h2>
      <p>
        If you email us, we receive the content of your message and your email address so we can respond. We do not sell that information.
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li>
          Privacy inquiries:
          <a href={`mailto:${BRAND.email.privacy}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.privacy}</a>
        </li>
        <li>
          Product support:
          <a href={`mailto:${BRAND.email.support}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.support}</a>
        </li>
        <li>
          Feedback:
          <a href={`mailto:${BRAND.email.feedback}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.feedback}</a>
        </li>
        <li>
          DMCA / copyright:
          <a href={`mailto:${BRAND.email.dmca}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.dmca}</a>
        </li>
      </ul>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">Contact</h2>
      <p>
        Questions about this Privacy Policy:
        <a href={`mailto:${BRAND.email.privacy}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.privacy}</a>
        or see our
        <a href="/contact" class="text-brand-600 font-semibold hover:underline">Contact page</a>.
      </p>
    </div>
  </div>
</BaseLayout>
