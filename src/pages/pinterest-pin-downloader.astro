---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';

const path = '/pinterest-pin-downloader';
const pageUrl = `https://pintdownload.app${path}`;
const title = 'Pinterest Pin Downloader — Save Any Pin, Video, GIF or Carousel Free';
const description =
  'Free Pinterest pin downloader for single pin links. Download HD images, MP4 videos, GIFs, and every slide in multi-image carousels. No login, no watermark.';

const faqs = [
  {
    q: 'What is a Pinterest pin link?',
    a: 'A pin link points to one pin page, usually shaped like pinterest.com/pin/123456789/ or a short pin.it/… URL. It is different from a board link (username/board-name) or a profile link (username only).',
  },
  {
    q: 'Can I download every image in a carousel pin?',
    a: 'Yes. PintDownload reads full carousel data and returns every slide so you can download each file or pack them into a ZIP. Cover-only tools stop at the first image.',
  },
  {
    q: 'Does the pin downloader work with videos and GIFs?',
    a: 'Yes. Public video pins export as MP4 when a downloadable stream is available. Static images and many animated GIFs save as image files. Private or deleted pins cannot be extracted.',
  },
  {
    q: 'Why did my board or profile link not work here?',
    a: 'This page is optimized for single pin URLs. For a full board ZIP use the Board Downloader; for a profile pack use the Profile Downloader. Using the correct tool matches the URL type and avoids empty results.',
  },
  {
    q: 'Is the Pinterest pin downloader free?',
    a: 'Yes. PintDownload is free to use in the browser with no account required. Only public pins can be extracted.',
  },
];

const steps = [
  { title: 'Open the pin on Pinterest', body: 'On the app or website, open the exact pin you want (not the board grid).' },
  { title: 'Copy the pin link', body: 'Tap <strong>Share → Copy link</strong>, or copy the browser address bar when it contains <code>/pin/</code>.' },
  { title: 'Paste into PintDownload', body: 'Paste the pin or pin.it URL in the box above and run extract.' },
  { title: 'Download the file(s)', body: 'Save the HD image or MP4. For carousels, download each slide or use <strong>Download ZIP</strong>.' },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Pin Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download a Pinterest pin',
    description: 'Steps to download a single Pinterest pin image, video, GIF, or carousel.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Hero card with curved background image -->
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    />
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-6 sm:mb-8"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">Pin Downloader</span>
      </h1>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="pin" />
      </div>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <!-- SEO Intro & Subtitle Banner -->
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-[#E11D48] text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        Single pin · Carousel · Video · GIF
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-3 leading-relaxed">
        Paste one public <strong class="text-slate-900 dark:text-white">pin URL</strong> to download the original image, HD video, GIF,
        or <strong class="text-slate-900 dark:text-white">every carousel slide</strong> — free, no login, no watermark.
      </p>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Works with <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">/pin/</code> and
        <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">pin.it</code> shortlinks. Public pins only.
      </p>
    </div>
    <div class="mt-2 w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Pin URLs only</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Built for <code class="text-[10px]">/pin/…</code> and <code class="text-[10px]">pin.it</code> shortlinks — not boards or profiles.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Full carousels</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Multi-image pins return all slides so you are not stuck with the cover only.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">HD media</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Prefers original images and highest available MP4 when Pinterest exposes them publicly.</p>
      </div>
    </div>

    <div class="w-full max-w-4xl">
      <HowToSteps
        title="How to download a Pinterest pin (step by step)"
        intro="Use this flow when you have a single pin link. For entire boards or profiles, switch tools below."
        exampleUrl="https://www.pinterest.com/pin/112027111109431342/"
        exampleLabel="Example pin URL"
        steps={steps}
      />

      <section class="mt-14 text-left" aria-labelledby="when-pin-heading">
        <h2 id="when-pin-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mb-3 scroll-mt-24">
          When to use the pin downloader (not board or profile)
        </h2>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed list-disc pl-5">
          <li>You need <strong class="text-slate-800 dark:text-slate-200">one</strong> idea, recipe video, outfit photo, or GIF.</li>
          <li>The pin is a <strong class="text-slate-800 dark:text-slate-200">carousel</strong> and you want every slide offline.</li>
          <li>You want MP4 quality options or image + caption/tags for reposting.</li>
          <li>You do <em>not</em> need every pin on a board — that is the{' '}
            <a href="/pinterest-board-downloader" class="text-[#E11D48] font-semibold hover:underline">Board ZIP tool</a>.</li>
        </ul>
      </section>

      <CompareTable highlight="pin" />
      <FaqSection title="Pinterest pin downloader FAQ" items={faqs} />
      <RelatedTools current={path} title="Need a board, profile, or video instead?" />
    </div>
  </article>
</BaseLayout>
