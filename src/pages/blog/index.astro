---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllPosts,
  getIndexablePosts,
  getCategories,
  BLOG_PUBLISHER,
  getCoverUrl,
} from '../../data/blog';
import { BRAND } from '../../lib/brand';
import { absoluteUrl } from '../../lib/urls';
import { STOCKS } from '../../lib/stocks';
import ArticleTicket from '../../components/blog/ArticleTicket.astro';
import { categoryAnchor } from '../../components/blog/blog-utils';
import '../../styles/blog.css';

// UI can list all posts; schema + SEO priority only references indexable guides
const articles = getAllPosts();
const indexableArticles = getIndexablePosts();
const categories = getCategories();
const featured = indexableArticles[0] ?? articles[0];
const rest = articles.filter((a) => a.slug !== featured?.slug);
const BLOG_AUTHOR_NAME = 'PintDownload Team';
const blogUrl = absoluteUrl('/blog');

// Category chips jump to the first ticket of that category (one id per category)
const countByCategory = new Map<string, number>();
for (const a of articles) countByCategory.set(a.category, (countByCategory.get(a.category) ?? 0) + 1);
const anchorOwner = new Map<string, string>();
const anchored = new Set<string>();
for (const a of [featured, ...rest].filter(Boolean) as typeof articles) {
  if (anchored.has(a.category)) continue;
  anchored.add(a.category);
  anchorOwner.set(a.slug, categoryAnchor(a.category));
}

const blogHubSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${BRAND.name} Blog — Pinterest Download Guides`,
  description: `In-depth guides for downloading Pinterest videos, boards, profiles, GIFs, and images. By the ${BRAND.name} Team.`,
  url: blogUrl,
  publisher: {
    '@type': 'Organization',
    name: BLOG_PUBLISHER.name,
    url: BLOG_PUBLISHER.url,
    logo: { '@type': 'ImageObject', url: BLOG_PUBLISHER.logo },
  },
  blogPost: indexableArticles.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.title,
    url: absoluteUrl(`/blog/${a.slug}`),
    image: getCoverUrl(a),
    datePublished: a.datePublished,
    dateModified: a.dateModified,
    author: { '@type': 'Organization', name: BLOG_AUTHOR_NAME },
  })),
};
---

<BaseLayout
  title={`Pinterest Download Guides & Tips — ${BRAND.name}`}
  description={`Long-form Pinterest download guides: video MP4, board ZIP, troubleshooting, mobile tips, and more. Written by the ${BRAND.name} Team.`}
  canonicalUrl={blogUrl}
  image={featured?.coverImage}
  clean
  fullBleed
  jsonLd={blogHubSchema}
>
  <div class="blog w-full">
    <!-- Masthead on the house stock -->
    <header class="field blog-masthead">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="blog-masthead-grid">
          <h1 class="blog-title">Pinterest download guides</h1>
          <div class="blog-masthead-aside">
            <p class="blog-lede">
              Medium-style articles on pins, videos, boards, and offline workflows — with clear paths back to the tools.
            </p>
            <p class="blog-masthead-links">
              <a href="/rss.xml">RSS</a>
              <a href="/">Downloader</a>
              <a href="/about">About</a>
            </p>
          </div>
        </div>

        <nav class="blog-cats" aria-label="Categories">
          <ul>
            {categories.map((cat) => (
              <li>
                <a href={`#${categoryAnchor(cat)}`} class="blog-cat">
                  <span>{cat}</span>
                  <span class="blog-cat-count">{countByCategory.get(cat) ?? 0}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <!-- Featured ticket, lying across the field and the counter -->
    {featured && (
      <div class="blog-featured max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" id={anchorOwner.get(featured.slug)}>
        <ArticleTicket post={featured} as="h2" featured eager />
      </div>
    )}

    <!-- The rack -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="art-rack art-rack--3">
        {rest.map((art) => (
          <li id={anchorOwner.get(art.slug)}>
            <ArticleTicket post={art} as="h2" />
          </li>
        ))}
      </ul>
    </div>

    <!-- Back channel -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
      <div class="blog-backchannel">
        <div>
          <p class="t-display blog-backchannel-title">Ready to download?</p>
          <p class="blog-backchannel-text">Jump back to the tools from any article.</p>
        </div>
        <div class="blog-backchannel-actions">
          <a href="/" class="blog-backchannel-primary">Home downloader</a>
          <a href="/pinterest-video-downloader" class="stock-chip" data-stock="video" style={`--chip:${STOCKS.video.color};--chip-ink:${STOCKS.video.onColor}`}>Video</a>
          <a href="/pinterest-board-downloader" class="stock-chip" data-stock="board" style={`--chip:${STOCKS.board.color};--chip-ink:${STOCKS.board.onColor}`}>Board ZIP</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
