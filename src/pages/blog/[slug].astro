---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllPosts,
  getPostBySlug,
  getRelatedPosts,
  BLOG_AUTHOR,
  BLOG_PUBLISHER,
  getCoverUrl,
  estimateWordCount,
} from '../../data/blog';

export function getStaticPaths() {
  return getAllPosts().map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const post = getPostBySlug(slug);
if (!post) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const related = getRelatedPosts(post, 4);
const pageUrl = `https://viralnest.com/blog/${post.slug}`;
const coverUrl = getCoverUrl(post);
const wordCount = estimateWordCount(post.content);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: [coverUrl],
  datePublished: post.datePublished,
  dateModified: post.dateModified,
  author: {
    '@type': 'Organization',
    name: BLOG_AUTHOR.name,
    url: BLOG_AUTHOR.url,
  },
  publisher: {
    '@type': 'Organization',
    name: BLOG_PUBLISHER.name,
    url: BLOG_PUBLISHER.url,
    logo: {
      '@type': 'ImageObject',
      url: BLOG_PUBLISHER.logo,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  articleSection: post.category,
  keywords: post.tags.join(', '),
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  wordCount,
};

const breadcrumbExtra = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://viralnest.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://viralnest.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${post.title} — viralNest Blog`}
  description={post.description}
  canonicalUrl={pageUrl}
  image={post.coverImage}
  ogType="article"
  jsonLd={[articleSchema, breadcrumbExtra]}
>
  <article class="max-w-3xl mx-auto py-8 text-left w-full">
    <nav class="text-xs font-semibold text-slate-500 mb-6 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#E60023]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-[#E60023]">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-700 dark:text-slate-300 line-clamp-1">{post.category}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="px-2.5 py-1 rounded-md bg-red-50 dark:bg-red-950/50 text-[#E60023] text-xs font-bold uppercase tracking-wider">
        {post.category}
      </span>
      {post.tags.slice(0, 3).map((tag) => (
        <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-semibold">
          {tag}
        </span>
      ))}
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-4 leading-tight text-wrap balance">
      {post.title}
    </h1>

    <p class="text-sm text-slate-600 dark:text-slate-400 mb-6 flex flex-wrap items-center gap-x-2 gap-y-1">
      <span>
        By <a href="/about" class="font-bold text-slate-800 dark:text-slate-200 hover:text-[#E60023]">viralNest Team</a>
      </span>
      <span class="text-slate-300" aria-hidden="true">·</span>
      <time datetime={post.datePublished}>Published {post.datePublished}</time>
      <span class="text-slate-300" aria-hidden="true">·</span>
      <time datetime={post.dateModified}>Updated {post.dateModified}</time>
      <span class="text-slate-300" aria-hidden="true">·</span>
      <span>~{post.readTimeMin} min read</span>
      <span class="text-slate-300" aria-hidden="true">·</span>
      <span class="tabular-nums">{wordCount.toLocaleString()} words</span>
    </p>

    <!-- Cover image -->
    <figure class="not-prose mb-8 -mx-0">
      <div class="relative overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm bg-slate-100 dark:bg-slate-900 aspect-[16/9]">
        <img
          src={post.coverImage}
          alt={post.coverAlt}
          width={1200}
          height={675}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <figcaption class="sr-only">{post.coverAlt}</figcaption>
    </figure>

    <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 leading-relaxed border-l-4 border-[#E60023]/pl-4">
      {post.excerpt}
    </p>

    <div
      class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:font-extrabold prose-h2:text-2xl prose-h2:mt-10 prose-h3:text-lg prose-a:text-[#E60023] prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-strong:text-slate-900 dark:prose-strong:text-white prose-li:my-1 leading-relaxed"
      set:html={post.content}
    />

    <!-- Tool strip -->
    <aside class="mt-10 p-6 rounded-3xl bg-gradient-to-br from-white to-red-50/60 dark:from-slate-900 dark:to-red-950/20 border border-red-200 dark:border-red-900/40 text-center shadow-sm">
      <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">Try viralNest now</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm mb-5 max-w-md mx-auto">
        Paste a public Pinterest link and download free — pin, video, board ZIP, or profile ZIP.
      </p>
      <div class="flex flex-wrap justify-center gap-2">
        <a href="/pinterest-video-downloader" class="inline-flex h-11 px-5 items-center rounded-xl bg-[#E60023] hover:bg-[#CC0000] text-white font-extrabold text-sm shadow-md shadow-red-500/20 transition-all touch-manipulation">Video MP4</a>
        <a href="/pinterest-pin-downloader" class="inline-flex h-11 px-5 items-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold text-sm hover:border-red-200 transition-all touch-manipulation">Pin / Carousel</a>
        <a href="/pinterest-board-downloader" class="inline-flex h-11 px-5 items-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold text-sm hover:border-red-200 transition-all touch-manipulation">Board ZIP</a>
        <a href="/pinterest-profile-downloader" class="inline-flex h-11 px-5 items-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold text-sm hover:border-red-200 transition-all touch-manipulation">Profile ZIP</a>
      </div>
    </aside>

    <!-- Related posts -->
    {related.length > 0 && (
      <section class="mt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-xl font-extrabold text-slate-900 dark:text-white mb-4">
          Keep reading
        </h2>
        <ul class="grid sm:grid-cols-2 gap-4">
          {related.map((r) => (
            <li>
              <a
                href={`/blog/${r.slug}`}
                class="group block rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-red-200 dark:hover:border-red-900 transition-colors h-full overflow-hidden"
              >
                <div class="aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-800">
                  <img
                    src={r.coverImage}
                    alt={r.coverAlt}
                    width={640}
                    height={360}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="p-4">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#E60023]">{r.category}</span>
                  <span class="block mt-1 font-bold text-sm text-slate-900 dark:text-white leading-snug">{r.title}</span>
                  <span class="block mt-1 text-[11px] text-slate-500 tabular-nums">{r.readTimeMin}&nbsp;min read</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-10 text-center text-sm">
      <a href="/blog" class="font-bold text-[#E60023] hover:underline">← All viralNest guides</a>
      <span class="text-slate-300 mx-2">·</span>
      <a href="/rss.xml" class="font-semibold text-slate-600 dark:text-slate-400 hover:text-[#E60023]">RSS</a>
    </p>
  </article>
</BaseLayout>
