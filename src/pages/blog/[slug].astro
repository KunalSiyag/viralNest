---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllPosts,
  getPostBySlug,
  getRelatedPosts,
  getAdjacentPosts,
  getPostsByCategory,
  isPostIndexable,
  BLOG_AUTHOR,
  BLOG_PUBLISHER,
  getCoverUrl,
  estimateWordCount,
} from '../../data/blog';
import { BRAND } from '../../lib/brand';
import { absoluteUrl } from '../../lib/urls';
import ArticleTicket from '../../components/blog/ArticleTicket.astro';
import ToolTicket from '../../components/blog/ToolTicket.astro';
import { anchorHeadings, categoryAnchor, formatPostDate, pickPostTool } from '../../components/blog/blog-utils';
import '../../styles/blog.css';

export function getStaticPaths() {
  return getAllPosts().map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const post = getPostBySlug(slug);
if (!post) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const related = getRelatedPosts(post, 4);
const sameCategory = getPostsByCategory(post.category, post.slug, 3);
const { prev, next } = getAdjacentPosts(post);
const pageUrl = absoluteUrl(`/blog/${post.slug}`);
const coverUrl = getCoverUrl(post);
const wordCount = estimateWordCount(post.content);
const postNoindex = !isPostIndexable(post);

// H2s get ids so the outline can link to them (heading text untouched)
const { html: articleHtml, outline } = anchorHeadings(post.content);
const tool = pickPostTool(post.content);
const publishedLabel = formatPostDate(post.datePublished);
const categoryHref = `/blog#${categoryAnchor(post.category)}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: [coverUrl],
  datePublished: post.datePublished,
  dateModified: post.dateModified,
  author: {
    '@type': 'Organization',
    name: BLOG_AUTHOR.name,
    url: BLOG_AUTHOR.url,
  },
  publisher: {
    '@type': 'Organization',
    name: BLOG_PUBLISHER.name,
    url: BLOG_PUBLISHER.url,
    logo: { '@type': 'ImageObject', url: BLOG_PUBLISHER.logo },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  articleSection: post.category,
  keywords: post.tags.join(', '),
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  wordCount,
};

const breadcrumbExtra = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('/blog') },
    { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
  ],
};

const toolLinks = [
  { href: '/pinterest-video-downloader', label: 'Video MP4' },
  { href: '/pinterest-pin-downloader', label: 'Pin / Carousel' },
  { href: '/pinterest-board-downloader', label: 'Board ZIP' },
];

let postTitle = `${post.title} — ${BRAND.name} Blog`;
if (postTitle.length > 65) {
  postTitle = post.title.length <= 65 ? post.title : `${post.title.slice(0, 62)}...`;
}
if (postTitle.length < 30) {
  postTitle = `${postTitle} | ${BRAND.domain}`;
}

let postDesc = post.description.trim();
if (postDesc.length < 110) {
  postDesc = `${postDesc} Learn more in this step-by-step Pinterest guide from ${BRAND.name}.`;
}
if (postDesc.length > 160) {
  postDesc = `${postDesc.slice(0, 157)}...`;
}
---

<BaseLayout
  title={postTitle}
  description={postDesc}
  canonicalUrl={pageUrl}
  image={post.coverImage}
  ogType="article"
  clean
  fullBleed
  noindex={postNoindex}
  jsonLd={[articleSchema, breadcrumbExtra]}
>
  <article class="blog w-full">
    <!-- Masthead: the article is printed on the house stock -->
    <header class="field post-masthead">
      <div class="post-masthead-grid max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="post-masthead-text min-w-0">
          <nav class="post-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/blog">Blog</a>
            <span aria-hidden="true">/</span>
            <a href={categoryHref}>{post.category}</a>
          </nav>

          <h1 class="post-title">{post.title}</h1>

          <p class="post-lede">{post.excerpt}</p>

          <div class="post-serial-strip">
            <a href="/about" class="post-byline">
              <span class="post-byline-tile">
                <img src="/images/logo.png" alt={BLOG_AUTHOR.name} width="28" height="28" />
              </span>
              <span>{BLOG_AUTHOR.name}</span>
            </a>
            <p class="post-serial">
              <span>{post.category}</span>
              <span aria-hidden="true">·</span>
              <time datetime={post.datePublished}>{publishedLabel}</time>
              <span aria-hidden="true">·</span>
              <span>{post.readTimeMin}&nbsp;min read</span>
              <span aria-hidden="true">·</span>
              <span>{wordCount.toLocaleString('en-US')}&nbsp;words</span>
            </p>
          </div>
        </div>

        <figure class="post-cover">
          <img
            src={post.coverImage}
            alt={post.coverAlt}
            width={1200}
            height={675}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            onerror="this.onerror=null;this.src='/images/blog/cover-guide.webp';"
          />
        </figure>
      </div>
    </header>

    <!-- Reading column on a paper sheet; outline rail and tool ticket in the frame -->
    <div class="post-grid max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {outline.length >= 3 && (
        <nav class="post-toc post-toc--rail" aria-label="In this article">
          <p class="t-label post-toc-label">In this article</p>
          <ol>
            {outline.map((h) => (
              <li><a href={`#${h.id}`} set:html={h.html} /></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post-sheet">
        {outline.length >= 3 && (
          <details class="post-toc post-toc--inline">
            <summary>
              <span class="t-label">In this article</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ol>
              {outline.map((h) => (
                <li><a href={`#${h.id}`} set:html={h.html} /></li>
              ))}
            </ol>
          </details>
        )}

        <div class="blog-prose" set:html={articleHtml} />

        {post.tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {post.tags.slice(0, 4).map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </div>

      <ToolTicket tool={tool} links={toolLinks} />

      <!-- Author slip -->
      <aside class="post-author" aria-label="About the author">
        <span class="post-author-tile">
          <img src="/images/logo.png" alt={BLOG_AUTHOR.name} width="40" height="40" />
        </span>
        <div class="min-w-0">
          <p class="t-label post-author-label">Written by</p>
          <a href="/about" class="post-author-name">{BLOG_AUTHOR.name}</a>
          <p class="post-author-bio">
            Guides and tooling notes from the team behind {BRAND.name} — free public Pinterest downloads on {BRAND.domain}.
          </p>
          <p class="post-author-links">
            <a href="/about">About</a>
            <a href="/blog">More articles</a>
            <a href="/rss.xml">RSS</a>
          </p>
        </div>
      </aside>

      <!-- Prev / Next -->
      <nav class="post-adjacent" aria-label="Adjacent articles">
        {prev ? (
          <a href={`/blog/${prev.slug}`} class="post-adjacent-link">
            <span class="t-label post-adjacent-dir">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
              Newer
            </span>
            <span class="post-adjacent-title">{prev.title}</span>
          </a>
        ) : (
          <div></div>
        )}
        {next ? (
          <a href={`/blog/${next.slug}`} class="post-adjacent-link post-adjacent-link--next">
            <span class="t-label post-adjacent-dir">
              Older
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
            <span class="post-adjacent-title">{next.title}</span>
          </a>
        ) : null}
      </nav>

      <!-- Same category -->
      {sameCategory.length > 0 && (
        <section class="post-more" aria-labelledby="same-cat-heading">
          <h2 id="same-cat-heading" class="post-section-head">More in {post.category}</h2>
          <ul>
            {sameCategory.map((r) => (
              <li>
                <a href={`/blog/${r.slug}`}>
                  <span>{r.title}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <!-- Related rack -->
    {related.length > 0 && (
      <section class="post-related max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-labelledby="related-heading">
        <h2 id="related-heading" class="post-section-head post-section-head--lg">Keep reading</h2>
        <ul class="art-rack art-rack--4">
          {related.map((r) => (
            <li><ArticleTicket post={r} excerpt={false} /></li>
          ))}
        </ul>
      </section>
    )}

    <p class="post-exit max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/blog">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        All articles
      </a>
      <a href="/">Downloader</a>
    </p>
    {outline.length >= 3 && (
      <script is:inline>
        (function () {
          var links = document.querySelectorAll('.post-toc--rail a[href^="#"]');
          if (!links.length || !('IntersectionObserver' in window)) return;
          var map = {};
          links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
          var current = null;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var a = map[e.target.id];
              if (!a || a === current) return;
              if (current) current.removeAttribute('aria-current');
              a.setAttribute('aria-current', 'location');
              current = a;
            });
          }, { rootMargin: '0px 0px -70% 0px' });
          Object.keys(map).forEach(function (id) {
            var h = document.getElementById(id);
            if (h) io.observe(h);
          });
          var inline = document.querySelector('.post-toc--inline');
          if (inline) {
            inline.addEventListener('click', function (e) {
              if (e.target.closest && e.target.closest('a')) inline.open = false;
            });
          }
        })();
      </script>
    )}
  </article>
</BaseLayout>
