---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllPosts,
  getPostBySlug,
  getRelatedPosts,
  getAdjacentPosts,
  getPostsByCategory,
  BLOG_AUTHOR,
  BLOG_PUBLISHER,
  getCoverUrl,
  estimateWordCount,
} from '../../data/blog';
import { BRAND } from '../../lib/brand';

export function getStaticPaths() {
  return getAllPosts().map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const post = getPostBySlug(slug);
if (!post) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const related = getRelatedPosts(post, 4);
const sameCategory = getPostsByCategory(post.category, post.slug, 3);
const { prev, next } = getAdjacentPosts(post);
const pageUrl = `${BRAND.url}/blog/${post.slug}`;
const coverUrl = getCoverUrl(post);
const wordCount = estimateWordCount(post.content);

// Extract H2s for a light Medium-style outline
const headingMatches = [...post.content.matchAll(/<h2[^>]*>(.*?)<\/h2>/gi)];
const outline = headingMatches
  .map((m) => m[1].replace(/<[^>]+>/g, '').trim())
  .filter(Boolean)
  .slice(0, 8);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: [coverUrl],
  datePublished: post.datePublished,
  dateModified: post.dateModified,
  author: {
    '@type': 'Organization',
    name: BLOG_AUTHOR.name,
    url: BLOG_AUTHOR.url,
  },
  publisher: {
    '@type': 'Organization',
    name: BLOG_PUBLISHER.name,
    url: BLOG_PUBLISHER.url,
    logo: { '@type': 'ImageObject', url: BLOG_PUBLISHER.logo },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  articleSection: post.category,
  keywords: post.tags.join(', '),
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  wordCount,
};

const breadcrumbExtra = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BRAND.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${BRAND.url}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
  ],
};

const toolLinks = [
  { href: '/pinterest-video-downloader', label: 'Video MP4' },
  { href: '/pinterest-pin-downloader', label: 'Pin / Carousel' },
  { href: '/pinterest-board-downloader', label: 'Board ZIP' },
  { href: '/pinterest-profile-downloader', label: 'Profile ZIP' },
];
---

<BaseLayout
  title={`${post.title} — ${BRAND.name} Blog`}
  description={post.description}
  canonicalUrl={pageUrl}
  image={post.coverImage}
  ogType="article"
  clean
  fullBleed
  jsonLd={[articleSchema, breadcrumbExtra]}
>
  <article class="w-full">
    <!-- Medium-style top meta -->
    <header class="max-w-medium mx-auto px-4 sm:px-6 pt-6 sm:pt-10">
      <nav class="text-sm font-medium text-ink-500 mb-8 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-600">Home</a>
        <span class="text-ink-300" aria-hidden="true">/</span>
        <a href="/blog" class="hover:text-brand-600">Blog</a>
        <span class="text-ink-300" aria-hidden="true">/</span>
        <a href={`/blog?cat=${encodeURIComponent(post.category)}`} class="hover:text-brand-600">{post.category}</a>
      </nav>

      <p class="text-brand-600 font-semibold text-sm tracking-wide mb-4">{post.category}</p>

      <h1
        class="font-display text-[2.35rem] sm:text-5xl text-ink-900 dark:text-white tracking-tight leading-[1.12] mb-6"
        style="text-wrap: balance;"
      >
        {post.title}
      </h1>

      <p class="text-xl sm:text-2xl text-ink-500 dark:text-slate-400 leading-relaxed mb-8 font-serif" style="text-wrap: pretty;">
        {post.excerpt}
      </p>

      <!-- Author row (Medium-style) -->
      <div class="flex flex-wrap items-center gap-4 pb-8 border-b border-black/[0.06] dark:border-white/[0.08]">
        <a href="/about" class="flex items-center gap-3 group min-w-0">
          <img
            src="/images/logo.svg"
            alt=""
            width="48"
            height="48"
            class="w-12 h-12 rounded-full border border-black/[0.06] shadow-soft"
          />
          <div class="min-w-0 text-left">
            <p class="font-semibold text-ink-900 dark:text-white group-hover:text-brand-600 transition-colors truncate">
              {BLOG_AUTHOR.name}
            </p>
            <p class="text-sm text-ink-500 tabular-nums">
              <time datetime={post.datePublished}>{post.datePublished}</time>
              <span class="mx-1.5 text-ink-300">·</span>
              {post.readTimeMin} min read
              <span class="mx-1.5 text-ink-300">·</span>
              {wordCount.toLocaleString()} words
            </p>
          </div>
        </a>
        <div class="flex flex-wrap gap-2 sm:ml-auto">
          {post.tags.slice(0, 4).map((tag) => (
            <span class="px-3 py-1 rounded-full text-sm font-medium bg-ink-50 dark:bg-white/[0.06] text-ink-600 dark:text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Cover -->
    <figure class="max-w-3xl mx-auto px-4 sm:px-6 mt-10 mb-10">
      <div class="overflow-hidden rounded-2xl sm:rounded-3xl border border-black/[0.06] dark:border-white/[0.08] shadow-soft aspect-[16/9] bg-ink-100 dark:bg-ink-900">
        <img
          src={post.coverImage}
          alt={post.coverAlt}
          width={1200}
          height={675}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </figure>

    <!-- Outline + body -->
    <div class="max-w-medium mx-auto px-4 sm:px-6">
      {outline.length >= 3 && (
        <aside class="mb-10 p-5 sm:p-6 rounded-2xl bg-ink-50/80 dark:bg-white/[0.04] border border-black/[0.05] dark:border-white/[0.08]">
          <p class="text-sm font-semibold uppercase tracking-wider text-ink-500 mb-3">In this article</p>
          <ol class="space-y-2 text-base text-ink-700 dark:text-slate-300 list-decimal list-inside">
            {outline.map((h) => (
              <li class="leading-snug">{h}</li>
            ))}
          </ol>
        </aside>
      )}

      <div
        class="medium-body font-serif text-ink-800 dark:text-slate-200"
        set:html={post.content}
      />

      <!-- Author footer card -->
      <aside class="mt-14 p-6 sm:p-8 rounded-3xl border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-900 shadow-soft flex flex-col sm:flex-row gap-5 items-start">
        <img src="/images/logo.svg" alt="" width="64" height="64" class="w-16 h-16 rounded-full border border-black/[0.06]" />
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-ink-400 mb-1">Written by</p>
          <a href="/about" class="text-xl font-semibold text-ink-900 dark:text-white hover:text-brand-600">
            {BLOG_AUTHOR.name}
          </a>
          <p class="mt-2 text-base text-ink-500 dark:text-slate-400 leading-relaxed">
            Guides and tooling notes from the team behind {BRAND.name} — free public Pinterest downloads on {BRAND.domain}.
          </p>
          <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
            <a href="/about" class="text-brand-600 hover:underline">About</a>
            <a href="/blog" class="text-brand-600 hover:underline">More articles</a>
            <a href="/rss.xml" class="text-brand-600 hover:underline">RSS</a>
          </div>
        </div>
      </aside>

      <!-- Tool back-channel -->
      <aside class="mt-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-brand-50 to-orange-50 dark:from-brand-950/30 dark:to-ink-900 border border-brand-100 dark:border-brand-900/40 text-center">
        <h2 class="font-display text-2xl text-ink-900 dark:text-white mb-2">Try it on {BRAND.name}</h2>
        <p class="text-base text-ink-600 dark:text-slate-400 mb-5 max-w-md mx-auto">
          Paste a public Pinterest link — pin, video, board ZIP, or profile ZIP.
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          {toolLinks.map((t) => (
            <a
              href={t.href}
              class="inline-flex h-11 px-5 items-center rounded-full bg-white dark:bg-ink-950 border border-black/[0.08] dark:border-white/10 text-ink-900 dark:text-white font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
            >
              {t.label}
            </a>
          ))}
        </div>
      </aside>

      <!-- Prev / Next (Medium back channel) -->
      <nav class="mt-12 grid sm:grid-cols-2 gap-4" aria-label="Adjacent articles">
        {prev ? (
          <a
            href={`/blog/${prev.slug}`}
            class="group p-5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-900 hover:border-brand-300 transition-colors text-left"
          >
            <span class="text-sm font-medium text-ink-400">← Newer</span>
            <span class="block mt-1 font-semibold text-ink-900 dark:text-white group-hover:text-brand-600 leading-snug">
              {prev.title}
            </span>
          </a>
        ) : (
          <div></div>
        )}
        {next ? (
          <a
            href={`/blog/${next.slug}`}
            class="group p-5 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-900 hover:border-brand-300 transition-colors text-left sm:text-right"
          >
            <span class="text-sm font-medium text-ink-400">Older →</span>
            <span class="block mt-1 font-semibold text-ink-900 dark:text-white group-hover:text-brand-600 leading-snug">
              {next.title}
            </span>
          </a>
        ) : null}
      </nav>

      <!-- Same category channel -->
      {sameCategory.length > 0 && (
        <section class="mt-12" aria-labelledby="same-cat-heading">
          <h2 id="same-cat-heading" class="text-sm font-semibold uppercase tracking-wider text-ink-400 mb-4">
            More in {post.category}
          </h2>
          <ul class="space-y-3">
            {sameCategory.map((r) => (
              <li>
                <a href={`/blog/${r.slug}`} class="text-lg font-medium text-ink-800 dark:text-slate-200 hover:text-brand-600 underline-offset-4 hover:underline">
                  {r.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Related with covers -->
      {related.length > 0 && (
        <section class="mt-14 mb-20" aria-labelledby="related-heading">
          <h2 id="related-heading" class="font-display text-2xl sm:text-3xl text-ink-900 dark:text-white mb-6">
            Keep reading
          </h2>
          <ul class="grid sm:grid-cols-2 gap-5">
            {related.map((r) => (
              <li>
                <a
                  href={`/blog/${r.slug}`}
                  class="group block rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-ink-900 overflow-hidden hover:shadow-lift transition-shadow h-full"
                >
                  <div class="aspect-[16/9] overflow-hidden bg-ink-100 dark:bg-ink-800">
                    <img
                      src={r.coverImage}
                      alt={r.coverAlt}
                      width={640}
                      height={360}
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-4 sm:p-5">
                    <span class="text-xs font-semibold uppercase tracking-wider text-brand-600">{r.category}</span>
                    <span class="block mt-1 font-semibold text-ink-900 dark:text-white leading-snug group-hover:text-brand-600">
                      {r.title}
                    </span>
                    <span class="block mt-2 text-sm text-ink-400 tabular-nums">{r.readTimeMin} min read</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="mb-16 text-center text-base">
        <a href="/blog" class="font-semibold text-brand-600 hover:underline">← All articles</a>
        <span class="text-ink-300 mx-2">·</span>
        <a href="/" class="font-semibold text-brand-600 hover:underline">Downloader</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Medium-like article body */
  .medium-body {
    font-size: 1.2rem;
    line-height: 1.8;
  }
  .medium-body > *:first-child {
    margin-top: 0;
  }
  .medium-body p {
    margin: 1.35em 0;
  }
  .medium-body h2 {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 400;
    color: inherit;
    margin: 2.25em 0 0.75em;
    scroll-margin-top: 6rem;
  }
  .medium-body h3 {
    font-family: Inter, system-ui, sans-serif;
    font-size: 1.2rem;
    font-weight: 650;
    margin: 1.75em 0 0.5em;
    scroll-margin-top: 6rem;
  }
  .medium-body a {
    color: #E11D48;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .medium-body a:hover {
    text-decoration-thickness: 2px;
  }
  .medium-body ul,
  .medium-body ol {
    margin: 1.25em 0;
    padding-left: 1.35em;
  }
  .medium-body li {
    margin: 0.45em 0;
  }
  .medium-body strong {
    font-weight: 650;
    color: #0f172a;
  }
  .dark .medium-body strong {
    color: #f8fafc;
  }
  .medium-body code {
    font-size: 0.88em;
    padding: 0.15em 0.4em;
    border-radius: 0.4em;
    background: rgba(15, 23, 42, 0.06);
  }
  .dark .medium-body code {
    background: rgba(255, 255, 255, 0.08);
  }
  .medium-body .not-prose {
    font-family: Inter, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
