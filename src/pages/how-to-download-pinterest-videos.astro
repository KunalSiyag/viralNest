---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Download Pinterest Videos to Your Gallery (2026 Step-by-Step Guide)",
  "description": "Learn how to save Pinterest videos, images, and GIFs to your phone gallery (iPhone & Android) or PC using free online tools.",
  "author": { "@type": "Organization", "name": "PintDownload" }
};
---

<BaseLayout 
  title="How to Download Pinterest Videos to Your Gallery (2026 Step-by-Step Guide)" 
  description="Learn how to save Pinterest videos, images, and GIFs to your phone gallery (iPhone & Android) or PC using free online tools."
  jsonLd={articleSchema}
>
  <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      Step-by-Step Tutorial
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight max-w-4xl">
      How to Download Pinterest Videos to Your Gallery
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed font-medium">
      A complete, easy guide for saving Pinterest videos, Idea Pins, GIFs, and photos on iPhone, Android, and Desktop.
    </p>

    <DownloaderForm client:load />

    <!-- Article Content -->
    <div class="mt-16 w-full text-left bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm prose max-w-none">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Method 1: Downloading from the Pinterest Mobile App (iPhone & Android)</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-4">
        Downloading videos on mobile requires getting the Pin's share link. Since Pinterest doesn't have a native "Save Video to Gallery" button for video pins, follow these 4 quick steps:
      </p>
      <ol class="space-y-3 text-slate-700 text-sm font-medium mb-8">
        <li><strong>Step 1:</strong> Open the Pinterest app on your phone and navigate to the Video Pin or Idea Pin.</li>
        <li><strong>Step 2:</strong> Tap the <strong>Share icon</strong> or <strong>••• (three dots)</strong> menu in the upper/lower right corner.</li>
        <li><strong>Step 3:</strong> Tap <strong>Copy Link</strong>. The URL (e.g. <code>https://pin.it/...</code>) will be saved to your clipboard.</li>
        <li><strong>Step 4:</strong> Paste the link into PintDownload above and tap <strong>Download MP4 Video</strong> to save it directly to your Photos / Camera Roll.</li>
      </ol>

      <h2 class="text-2xl font-bold text-slate-900 mb-4">Method 2: Downloading on Desktop PC or Mac</h2>
      <p class="text-slate-600 text-sm leading-relaxed mb-4">
        On desktop web browsers (Chrome, Edge, Safari, Firefox), downloading Pinterest videos is even faster:
      </p>
      <ol class="space-y-3 text-slate-700 text-sm font-medium">
        <li><strong>Step 1:</strong> Open <a href="https://pinterest.com" target="_blank" rel="noopener" class="text-[#E11D48] underline">pinterest.com</a> and click on the Pin.</li>
        <li><strong>Step 2:</strong> Copy the URL from your browser's address bar.</li>
        <li><strong>Step 3:</strong> Paste it into PintDownload and click <strong>Download MP4 Video</strong>.</li>
      </ol>
    </div>
  </div>
</BaseLayout>
