---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest Image Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout 
  title="Pinterest Image Downloader — Save Full HD Pinterest Photos & Images" 
  description="Download full-resolution Pinterest images, photos, artwork, and infographics for free. High quality PNG & JPG original pin downloads."
  jsonLd={webAppSchema}
>
  <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-[#E60023] text-xs sm:text-sm font-bold mb-6 border border-red-200 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      100% Original Resolution Image Downloader
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight max-w-3xl">
      Pinterest <span class="text-[#E60023]">Image Downloader</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed font-medium">
      Save uncompressed, maximum resolution Pinterest photos, wallpapers, artwork, and infographics directly to your device.
    </p>

    <DownloaderForm client:load />

    <!-- Features -->
    <div class="mt-16 w-full text-left bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Why Use Our Pinterest Image Downloader?</h2>
      <div class="grid sm:grid-cols-2 gap-6 text-sm text-slate-600">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <h3 class="font-bold text-slate-900 mb-1">Max Original Quality</h3>
          <p>Extracts the raw uncompressed original resolution image uploaded to Pinterest servers.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
          <h3 class="font-bold text-slate-900 mb-1">No Login Needed</h3>
          <p>Fast and 100% anonymous downloads without giving out credentials or logging in.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
