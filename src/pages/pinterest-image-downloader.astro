---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-image-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Image Downloader — Save HD Original Photos Free';
const description =
  'Free Pinterest image downloader for original-resolution photos, wallpapers, and artwork. Save HD JPG images from Pinterest without an account or login.';

const faqs = [
  {
    q: 'How to download images from Pinterest without an account?',
    a: 'Paste any public Pinterest image pin URL into PintDownload. The tool extracts the original high-resolution photo from the Pinterest CDN so you can save it without creating or logging into an account.',
  },
  {
    q: 'How do I download a high-resolution Pinterest image?',
    a: 'Open the image pin, copy the share link or browser URL with /pin/, paste it into this image downloader, extract, then download the HD/original image file — not the tiny grid thumbnail.',
  },
  {
    q: 'Will I get the original size or a tiny thumbnail?',
    a: 'PintDownload prefers original or largest public CDN variants when available. Some pins only expose mid-size variants; we never invent pixels beyond the source.',
  },
  {
    q: 'Can I download multi-image carousels?',
    a: 'Yes — multi-slide pins can list every image so you can save all slides. For a pin-first flow that also handles video and GIF, see the Pin Downloader. For a carousel-focused tool, open Carousel Downloader.',
  },
  {
    q: 'Is this different from the video downloader?',
    a: 'Yes. This page targets still photos, wallpapers, and artwork. Use the video tool for MP4 streams and board/profile tools for bulk ZIP packs.',
  },
  {
    q: 'Does this work for wallpapers and design references?',
    a: 'Yes. Designers and makers often save public inspiration pins offline for moodboards. Credit creators if you republish or use assets commercially.',
  },
  {
    q: 'Why did a video pin fail here?',
    a: 'This tool prioritizes still image files. Paste video pins into the Pinterest Video Downloader for MP4 extraction.',
  },
];

const steps = [
  {
    title: 'Open the image pin',
    body: 'Open the pin close-up so the URL contains <code>/pin/</code> and you see a still photo (not a playing video).',
  },
  {
    title: 'Copy the link',
    body: 'Share → Copy link, or copy the browser address bar. <code>pin.it</code> shortlinks work for many public pins.',
  },
  {
    title: 'Paste & extract',
    body: 'Paste into the image tool above and extract media. Prefer the largest resolution option when listed.',
  },
  {
    title: 'Download HD photo',
    body: 'Save the original-resolution JPG/PNG to your device for offline use or design reference.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Image Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest images in full resolution',
    description: 'Steps to save original HD photos from public Pinterest pin links.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-4 sm:mb-6 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-0 sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-6 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-8 sm:pt-14 lg:pt-16 pb-4 sm:pb-8 lg:pb-10 w-full my-auto">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-4 sm:mb-6"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">Image Downloader</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-6 sm:mb-8 leading-relaxed">
        Save <strong class="text-slate-900 dark:text-white">original-resolution photos</strong> &amp; artwork — free, no login.
      </p>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="image" />
      </div>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-[#E11D48] text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        Original resolution · Photos · Artwork
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-3 leading-relaxed">
        Download <strong class="text-slate-900 dark:text-white">full-resolution</strong> Pinterest photos, wallpapers,
        and artwork from a public pin link — free, no login, no watermark.
      </p>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Works with <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">/pin/</code> URLs.
        Public image pins only.
      </p>
    </div>

    <div class="w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm mb-10">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">HD originals first</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Prefers the largest public image source instead of the blurry feed thumbnail you get from long-press alone.
        </p>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Still photos only</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Optimized for “Pinterest image downloader” and “download Pinterest photo HD” — not MP4 video streams.
        </p>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">No account required</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Paste a public pin link and save. Private or login-only pins cannot be extracted.
        </p>
      </div>
    </div>

    <section class="w-full max-w-3xl text-left mb-12 space-y-4 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white text-center mb-2">
        Image vs video vs pin downloader
      </h2>
      <p>
        Choose the tool that matches the media type. This page is for <strong>still images</strong>. Video pins belong on the
        <a href="/pinterest-video-downloader" class="text-[#E11D48] font-semibold underline-offset-2 hover:underline">Video Downloader</a>.
        Mixed pin types (image, GIF, carousel, video) can use the
        <a href="/pinterest-pin-downloader" class="text-[#E11D48] font-semibold underline-offset-2 hover:underline">Pin Downloader</a>.
        Need an avatar only? Use the
        <a href="/pinterest-profile-picture-downloader" class="text-[#E11D48] font-semibold underline-offset-2 hover:underline">Profile Picture Downloader</a>.
      </p>
    </section>

    <div class="w-full max-w-4xl">
      <HowToSteps
        title="How to download Pinterest images in HD"
        intro="Use a pin URL for a still photo. Board bulk saves belong on the Board ZIP page."
        exampleUrl="https://www.pinterest.com/pin/…"
        exampleLabel="Example image pin URL"
        steps={steps}
        visual
        stripe={true}
      />
      <CompareTable highlight="pin" title="Image pin vs board vs profile tools" />
      <FaqSection title="Pinterest image downloader FAQ" items={faqs} />
      <RelatedTools current={path} />
    </div>
  </article>
</BaseLayout>
