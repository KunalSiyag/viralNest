---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';

const path = '/pinterest-image-downloader';
const pageUrl = `https://pintdownload.app${path}`;
const title = 'Pinterest Image Downloader — Save Full HD Original Photos Free';
const description =
  'Free Pinterest image downloader for original-resolution photos, wallpapers, and artwork. Paste a pin URL and save HD JPG without login or watermark.';

const faqs = [
  {
    q: 'How do I download a high-resolution Pinterest image?',
    a: 'Copy the image pin URL, paste it into this image downloader, extract, then download the HD/original image file.',
  },
  {
    q: 'Will I get the original size or a tiny thumbnail?',
    a: 'PintDownload prefers originals when available (not the small grid thumbnail). Some pins only expose mid-size CDN variants.',
  },
  {
    q: 'Can I download multi-image carousels?',
    a: 'Yes — multi-slide pins list every image so you can save all slides. For a dedicated pin flow see the Pin Downloader.',
  },
  {
    q: 'Is this different from the video downloader?',
    a: 'Yes. This page targets still photos and artwork. Use the video tool for MP4 streams and the board/profile tools for bulk ZIP packs.',
  },
];

const steps = [
  { title: 'Open the image pin', body: 'Open the pin close-up so the URL contains <code>/pin/</code>.' },
  { title: 'Copy the link', body: 'Copy share link or browser URL.' },
  { title: 'Paste & extract', body: 'Paste into the image tool and extract media.' },
  { title: 'Download HD', body: 'Save the original-resolution image to your device.' },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({ name: 'Pinterest Image Downloader — PintDownload', description, url: pageUrl }),
  howToSchema({
    name: 'How to download Pinterest images in full resolution',
    description: 'Steps to save original HD photos from Pinterest pin links.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Hero card with curved background image -->
  <section
    class="relative mx-3 sm:mx-6 lg:mx-8 xl:mx-10 mt-2 sm:mt-3 mb-4 sm:mb-6 rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col justify-center items-center py-10 sm:py-14 border border-red-100/80 dark:border-red-900/30 shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    />
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 sm:px-8 lg:px-12 pt-12 sm:pt-14 lg:pt-16 pb-6 sm:pb-8 lg:pb-10 w-full my-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/80 dark:bg-ink-900/80 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200/80 dark:border-red-900/40 shadow-sm backdrop-blur-sm">
        Original resolution · Photos · Artwork
      </div>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-4"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">Image Downloader</span>
      </h1>

      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mb-8 leading-relaxed">
        Download <strong class="text-slate-900 dark:text-white">full-resolution</strong> Pinterest photos, wallpapers,
        and artwork from a public pin link — free, no login, no watermark.
      </p>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="image" />
      </div>

      <p class="mt-5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">
        Works with <code class="text-[11px] bg-white/70 dark:bg-ink-900/70 px-1.5 py-0.5 rounded">/pin/</code> URLs.
        Public image pins only.
      </p>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="w-full max-w-4xl">
      <HowToSteps
        title="How to download Pinterest images in HD"
        intro="Use a pin URL. Board bulk saves belong on the Board ZIP page."
        exampleUrl="https://www.pinterest.com/pin/…"
        steps={steps}
      />
      <FaqSection title="Pinterest image downloader FAQ" items={faqs} />
      <RelatedTools current={path} />
    </div>
  </article>
</BaseLayout>
