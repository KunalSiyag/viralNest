---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/brand';
---

<BaseLayout
  title={`Terms of Service — ${BRAND.name} Video Downloader`}
  description={`Read the official terms of service and usage guidelines for using ${BRAND.name} video, photo, and GIF downloader web utility.`}
  clean
>
  <div class="max-w-3xl mx-auto py-8 text-left">
    <nav class="text-sm font-medium text-ink-500 mb-8 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="text-ink-300" aria-hidden="true">/</span>
      <span class="text-ink-700 dark:text-slate-300">Terms of Service</span>
    </nav>

    <h1 class="font-display text-4xl sm:text-5xl text-ink-900 dark:text-white mb-4">Terms of Service</h1>
    <p class="text-sm text-ink-400 mb-8">Last updated: July 24, 2026</p>

    <div class="space-y-6 text-ink-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-medium">
      <p>
        By accessing or using {BRAND.name} ({BRAND.url}), you agree to be bound by these Terms of Service.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">1. Permitted use</h2>
      <p>
        {BRAND.name} provides media extraction tools for public Pinterest pins. Users agree to use the service for lawful, personal, non-commercial, or otherwise authorized purposes, and to respect creators’ rights.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">2. Copyright and intellectual property</h2>
      <p>
        {BRAND.name} does not own, host as a library, or claim copyright over media files obtained through the tool. Intellectual property belongs to the respective creators and rights holders. Public availability does not grant a commercial license.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">3. Limitation of liability</h2>
      <p>
        {BRAND.name} is provided on an “as is” and “as available” basis without warranties of any kind. {BRAND.name} shall not be liable for damages resulting from misuse of content or copyright violations by users.
      </p>

      <h2 class="text-2xl font-semibold text-ink-900 dark:text-white mt-8">4. Contact</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li>
          Support:
          <a href={`mailto:${BRAND.email.support}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.support}</a>
        </li>
        <li>
          Feedback:
          <a href={`mailto:${BRAND.email.feedback}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.feedback}</a>
        </li>
        <li>
          Privacy:
          <a href={`mailto:${BRAND.email.privacy}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.privacy}</a>
        </li>
        <li>
          DMCA:
          <a href={`mailto:${BRAND.email.dmca}`} class="text-brand-600 font-semibold hover:underline">{BRAND.email.dmca}</a>
        </li>
      </ul>
      <p>
        Full list:
        <a href="/contact" class="text-brand-600 font-semibold hover:underline">pintdownload.app/contact</a>
      </p>
    </div>
  </div>
</BaseLayout>
