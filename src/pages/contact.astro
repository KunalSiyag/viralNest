---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us — viralNest" description="Contact viralNest team for support or inquiry.">
  <div class="max-w-3xl mx-auto py-8 text-left bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-sm">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Contact Us</h1>
    <p class="text-slate-600 text-sm leading-relaxed mb-8">
      Have a question, feedback, or need to report an issue with viralNest? Get in touch with our team.
    </p>

    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
      <div>
        <h3 class="text-sm font-bold text-slate-900">Email Support</h3>
        <p class="text-xs text-slate-600">support@viralnest.com</p>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900">DMCA & Copyright Inquiries</h3>
        <p class="text-xs text-slate-600">dmca@viralnest.com</p>
      </div>
    </div>
  </div>
</BaseLayout>
