---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import EmbedWidget from '../components/seo/EmbedWidget.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/';
const pageUrl = absoluteUrl('/');
const title = 'Pinterest Downloader — Free Video, Photo & GIF | PintDownload';
const description =
  'Free Pinterest downloader online. Save public videos as MP4, photos, GIFs, boards, and profiles in HD — no login or watermark, on any phone or desktop.';

const faqs = [
  {
    q: 'How to download images from Pinterest without an account?',
    a: 'Simply copy the pin link from Pinterest (app or web) and paste it into PintDownload. Our tool extracts direct HD media URLs from Pinterest CDN servers, allowing you to save images, photos, and videos without logging into Pinterest or creating an account.',
  },
  {
    q: 'Is PintDownload free?',
    a: 'Yes. PintDownload is 100% free for public Pinterest media with no registration or account required.',
  },
  {
    q: 'What can I download from Pinterest?',
    a: 'Public videos (MP4), photos, GIFs, multi-image carousels, full boards as ZIP, and public profile pin packs. Use the hub form above or a specialized tool page.',
  },
  {
    q: 'How do I download a Pinterest video as MP4?',
    a: 'Copy the public pin link from the Pinterest app or browser, paste it above, extract, then download the MP4. Prefer links with /pin/ or pin.it.',
  },
  {
    q: 'Can I download boards and profiles as ZIP?',
    a: 'Yes. Paste a public board or profile URL to list pins, then download a ZIP pack. Dedicated Board and Profile tools are also linked in the nav.',
  },
  {
    q: 'What is the bookmarklet for?',
    a: 'Save the PintDownload bookmarklet to your bookmarks bar. When you are on a Pinterest pin, board, or profile page, click it once — we open with that link prefilled and start the download flow automatically.',
  },
  {
    q: 'Should I credit original creators?',
    a: 'Yes. If you reuse someone’s clip or image in content you publish, credit the creator and follow copyright rules. Public access is not a commercial license.',
  },
  {
    q: 'What does not work?',
    a: 'Private, secret, login-only, deleted, or restricted pins cannot be extracted. We do not invent higher quality than the source provides.',
  },
  {
    q: 'How do I convert Pinterest to MP4?',
    a: 'Paste a public video pin into the hub form above or open the Pinterest to MP4 page. Extract, then download the MP4 — the same file a “Pinterest to MP4” converter should give you.',
  },
  {
    q: 'Can I download GIFs from Pinterest?',
    a: 'Yes. Paste the GIF pin URL here or use the Pinterest GIF Downloader so the file stays an animated GIF instead of a still frame.',
  },
  {
    q: 'Can I use Pinterest offline?',
    a: 'Pinterest itself needs a network. Download public pins, videos, or boards first, then open the files in Photos, Gallery, or VLC with no account and no app. See the offline-without-account guide.',
  },
];

const steps = [
  {
    title: 'Copy the Pinterest link',
    body: 'Open the pin, board, or profile in the app or browser. Share → Copy link, or copy a full URL with <code>/pin/</code>. Short <code>pin.it</code> links work too.',
    image: '/images/step1.webp',
    imageAlt: 'Copy a Pinterest pin link from the share menu',
  },
  {
    title: 'Paste into PintDownload',
    body: 'Paste the public link in the box above and tap <strong>Download</strong>. Works for videos, photos, GIFs, boards, and profiles.',
    image: '/images/step2.webp',
    imageAlt: 'Paste the Pinterest URL into PintDownload',
  },
  {
    title: 'Preview and save',
    body: 'Choose quality if offered, then save to Downloads, Photos, or Gallery. Board and profile links pack into a ZIP.',
    image: '/images/step3.webp',
    imageAlt: 'Preview and download the Pinterest media file',
  },
];

const guides = [
  { href: '/blog/how-to-make-money-on-pinterest', tag: 'Creators', title: 'Make money on Pinterest (2026)', blurb: 'Affiliate, products, and creator paths in plain English.' },
  { href: '/blog/how-to-download-pinterest-videos-fast-and-easy', tag: 'Guide', title: 'Download videos fast & easy', blurb: 'Step-by-step MP4 workflow for phone and desktop.' },
  { href: '/blog/how-to-download-entire-pinterest-board-zip', tag: 'Boards', title: 'Download a board as ZIP', blurb: 'Bulk-save public moodboards for offline reference.' },
  { href: '/blog/how-to-download-pinterest-profile-picture', tag: 'PFP / DP', title: 'Download a profile picture in HD', blurb: 'Full-size Pinterest avatar, PFP, and DP — not the tiny app thumbnail.' },
  { href: '/blog/make-money-on-pinterest-without-website', tag: 'No blog', title: 'Make money without a website', blurb: 'Affiliate and product paths that do not need a blog on day one.' },
  { href: '/blog/save-pinterest-offline-without-account', tag: 'Offline', title: 'Save Pinterest offline, no account', blurb: 'Download public pins first, then watch or browse files with no login.' },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest videos, photos, GIFs, boards, and profiles',
    description: 'Copy a public Pinterest link, paste it into PintDownload, preview, and save the file or ZIP.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout field="red" title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <TicketHero
    title={"Pinterest downloader"}
    lede={"<strong>Paste link, keep file.</strong> Save public <strong>videos as HD MP4</strong>, photos in the largest size Pinterest publishes, GIFs, or whole <strong>boards &amp; profiles as one ZIP</strong>. Free, no login, on your phone or desktop."}
    variant="hub"
    layout="hero"
  >
    <dl slot="aside" class="mt-6 sm:mt-8 hidden sm:grid grid-cols-3 max-w-xl border-t-2 border-[var(--on-field)]">
      <div class="pt-3 pe-3">
        <dt class="t-label">Pin</dt>
        <dd class="mt-1 text-sm text-[var(--on-field-2)]">MP4, JPG, GIF or every carousel slide</dd>
      </div>
      <div class="pt-3 px-3 border-s-2 border-dashed border-[var(--on-field)]">
        <dt class="t-label">Board</dt>
        <dd class="mt-1 text-sm text-[var(--on-field-2)]">All public pins in one ZIP</dd>
      </div>
      <div class="pt-3 ps-3 border-s-2 border-dashed border-[var(--on-field)]">
        <dt class="t-label">Profile</dt>
        <dd class="mt-1 text-sm text-[var(--on-field-2)]">Pin pack or HD avatar</dd>
      </div>
    </dl>
  </TicketHero>

  <article class="w-full">
    <HowToSteps
      title="How to download from Pinterest in 3 steps"
      intro="Works in any browser on iPhone, Android, Mac, or PC. Public pins only — no login, no software to install."
      exampleUrl="https://www.pinterest.com/pin/112027111109431342/"
      exampleLabel="Example pin URL"
      steps={steps}
      visual
    />

    <AdSlot slot={import.meta.env.PUBLIC_AD_SLOT_HOME_1} class="px-4" />

    <RelatedTools current={path} title="Specialized download tools" />

    <section class="field-canary field w-full py-12 sm:py-16" aria-labelledby="credit-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] gap-x-12 gap-y-4 items-end">
        <h2 id="credit-heading" class="t-display text-5xl sm:text-6xl lg:text-7xl leading-[0.9]">Credit original creators</h2>
        <p class="text-base sm:text-lg leading-relaxed">
          If you use someone else’s Pinterest video or image in content you publish (Reels, TikTok, YouTube, ads),
          <strong>credit the original creator</strong>. Personal offline reference is fine; republishing without credit or a license is not.
          <a href="/blog/things-to-know-before-downloading-pinterest-videos" class="font-bold underline decoration-2">Read the before-you-download guide</a>.
        </p>
      </div>
    </section>

    <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-start" aria-labelledby="money-heading">
      <div class="counter-rule pt-4 mb-6 sm:mb-8 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] gap-x-10 gap-y-3 items-end">
        <h2 id="money-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">How people make money with Pinterest</h2>
        <p class="text-base text-[var(--ink-2)] leading-relaxed">
          Creators and shop owners use Pinterest for affiliate traffic, digital products, and brand deals. Save references offline while you plan, then publish pins you own.
        </p>
      </div>
      <ul class="grid md:grid-cols-2 gap-x-10 list-none p-0 m-0 border-t-2 border-dashed border-[var(--rule)]">
        {guides.map((g) => (
          <li class="border-b-2 border-dashed border-[var(--rule)]">
            <a href={g.href} class="group flex items-start gap-4 py-4 min-h-[44px]">
              <span class="t-label shrink-0 w-20 pt-1 text-brand-700 dark:text-brand-300">{g.tag}</span>
              <span class="min-w-0">
                <span class="block font-bold text-lg leading-snug group-hover:underline">{g.title}</span>
                <span class="block mt-0.5 text-[0.9375rem] text-[var(--ink-2)]">{g.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <BookmarkletGuide />

    <CompareTable highlight="pin" />

    <AdSlot slot={import.meta.env.PUBLIC_AD_SLOT_HOME_2} class="px-4" />

    <FaqSection title="Pinterest downloader FAQ" items={faqs} />

    <EmbedWidget />
  </article>
</BaseLayout>
