---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import { BRAND } from '../lib/brand';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${BRAND.name} Pinterest Video Downloader`,
  operatingSystem: 'All',
  applicationCategory: 'MultimediaApplication',
  url: BRAND.url,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '18450',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Is ${BRAND.name} free to use?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Yes. ${BRAND.name} is free with no hidden fees, limits, or account registration required for public pins.`,
      },
    },
    {
      '@type': 'Question',
      name: 'How do I download Pinterest videos on mobile?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Open the Pinterest app, copy the pin link, paste it into ${BRAND.name} in Safari or Chrome, then download the MP4.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Can I download Pinterest GIFs and images?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We support full-resolution static image pins, animated GIFs, carousels, and Idea Pins when publicly available.',
      },
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Download Pinterest Videos & Pins',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Copy Pinterest Link',
      text: 'Open Pinterest, find the pin, tap Share or ⋯ and select Copy Link.',
    },
    {
      '@type': 'HowToStep',
      name: `Paste in ${BRAND.name}`,
      text: `Paste the URL into the search box on ${BRAND.domain}.`,
    },
    {
      '@type': 'HowToStep',
      name: 'Save File',
      text: 'Download the MP4 video, HD image, or GIF to your device.',
    },
  ],
};

const tools = [
  {
    href: '/pinterest-pin-downloader',
    title: 'Pin Downloader',
    blurb: 'One pin → image, video, GIF, or every carousel slide.',
  },
  {
    href: '/pinterest-video-downloader',
    title: 'Video → MP4',
    blurb: 'Dedicated HD video extractor for public video pins.',
  },
  {
    href: '/pinterest-image-downloader',
    title: 'HD Images',
    blurb: 'Original-resolution photos and artwork from pin links.',
  },
  {
    href: '/pinterest-board-downloader',
    title: 'Board ZIP',
    blurb: 'Paste a board URL and pack public pins into a ZIP.',
    badge: 'ZIP',
  },
  {
    href: '/pinterest-profile-downloader',
    title: 'Profile ZIP',
    blurb: 'Bulk download visible public pins from a profile.',
    badge: 'ZIP',
  },
  {
    href: '/blog',
    title: 'Guides & Blog',
    blurb: 'Medium-style articles on downloads, quality, and workflow.',
  },
];
---

<BaseLayout
  title="Pinterest Video Downloader — Save Videos, Images & GIFs Free | PintDownload"
  description="Download Pinterest videos, Idea Pins, GIFs, boards, and HD images free. Fast MP4 saves on pintdownload.app — no watermark, no account."
  fullBleed
  clean
  jsonLd={[webAppSchema, faqSchema, howToSchema]}
>
  <!-- Sarvam-inspired premium hero -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10"
      aria-hidden="true"
      style="
        background:
          radial-gradient(120% 80% at 50% -10%, rgba(251,146,60,0.55) 0%, rgba(251,113,133,0.28) 28%, rgba(196,181,253,0.18) 52%, rgba(251,251,253,0) 72%),
          linear-gradient(180deg, #fff7ed 0%, #FBFBFD 62%, #FBFBFD 100%);
      "
    ></div>
    <div
      class="absolute inset-x-0 top-0 h-[28rem] -z-10 opacity-60 dark:opacity-30 pointer-events-none"
      aria-hidden="true"
      style="
        background:
          radial-gradient(ellipse 70% 50% at 50% 0%, rgba(225,29,72,0.16), transparent 70%);
      "
    ></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-14 sm:pt-20 pb-10 sm:pb-14 text-center">
      <div class="flex justify-center mb-6">
        <img
          src="/images/logo.svg"
          alt=""
          width="56"
          height="56"
          class="w-14 h-14 rounded-[28%] shadow-glow"
          decoding="async"
        />
      </div>

      <p class="text-brand-700 dark:text-brand-300 font-medium tracking-wide text-sm sm:text-base mb-4">
        {BRAND.tagline}
      </p>

      <h1
        class="font-display text-[2.75rem] sm:text-6xl md:text-7xl text-ink-900 dark:text-white tracking-tight leading-[1.05] max-w-4xl mx-auto mb-5"
        style="text-wrap: balance;"
      >
        AI-free downloads.<br class="hidden sm:block" />
        <span class="italic text-brand-600">Pinterest, perfected.</span>
      </h1>

      <p class="text-lg sm:text-xl text-ink-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Paste a public pin, board, or profile link. Save HD videos, images, GIFs, and ZIP packs — free, fast, no account.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        <a
          href="#download"
          class="inline-flex h-12 sm:h-13 items-center px-7 rounded-full bg-ink-900 dark:bg-white text-white dark:text-ink-900 text-base font-semibold shadow-soft hover:opacity-90 transition-opacity touch-manipulation"
        >
          Start downloading
        </a>
        <a
          href="/blog"
          class="inline-flex h-12 sm:h-13 items-center px-7 rounded-full bg-white/80 dark:bg-white/10 border border-black/[0.08] dark:border-white/15 text-ink-800 dark:text-white text-base font-semibold backdrop-blur-md hover:bg-white transition-colors touch-manipulation"
        >
          Read the guides
        </a>
      </div>

      <p class="text-[0.75rem] font-semibold tracking-[0.18em] uppercase text-ink-400 mb-5">
        Built for creators, students &amp; makers
      </p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-ink-500 dark:text-slate-400 font-medium opacity-80">
        <span>Pin · Video · Board · Profile</span>
        <span class="hidden sm:inline text-ink-300">·</span>
        <span>iOS · Android · Desktop</span>
        <span class="hidden sm:inline text-ink-300">·</span>
        <span>No signup</span>
      </div>
    </div>
  </section>

  <!-- Downloader surface -->
  <section id="download" class="max-w-5xl mx-auto px-4 sm:px-6 pb-8 -mt-2">
    <div class="rounded-[2rem] bg-white/90 dark:bg-ink-900/80 border border-black/[0.06] dark:border-white/[0.08] shadow-lift backdrop-blur-xl p-5 sm:p-8">
      <DownloaderForm client:load variant="hub" />
      <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm font-medium text-ink-500">
        <span class="text-ink-400">Accepts</span>
        <span class="px-3 py-1.5 rounded-full bg-ink-50 dark:bg-white/[0.06] border border-black/[0.05] text-ink-700 dark:text-slate-200">pin/…</span>
        <span class="px-3 py-1.5 rounded-full bg-ink-50 dark:bg-white/[0.06] border border-black/[0.05] text-ink-700 dark:text-slate-200">pin.it/…</span>
        <a href="/pinterest-board-downloader" class="px-3 py-1.5 rounded-full bg-brand-50 dark:bg-brand-950/40 border border-brand-200/60 text-brand-700 dark:text-brand-300 hover:bg-brand-100 transition-colors">board → ZIP</a>
        <a href="/pinterest-profile-downloader" class="px-3 py-1.5 rounded-full bg-brand-50 dark:bg-brand-950/40 border border-brand-200/60 text-brand-700 dark:text-brand-300 hover:bg-brand-100 transition-colors">profile → ZIP</a>
      </div>
    </div>
  </section>

  <!-- Tool grid -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20" id="features">
    <div class="text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl text-ink-900 dark:text-white mb-3">Everything you need to save pins</h2>
      <p class="text-lg text-ink-500 dark:text-slate-400 max-w-xl mx-auto">Specialized tools for every URL type — so downloads succeed the first time.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {tools.map((t) => (
        <a
          href={t.href}
          class="group relative p-6 sm:p-7 rounded-3xl bg-white dark:bg-ink-900 border border-black/[0.06] dark:border-white/[0.08] shadow-soft hover:shadow-lift hover:border-brand-200 dark:hover:border-brand-800 transition-all"
        >
          {'badge' in t && t.badge && (
            <span class="absolute top-5 right-5 text-[0.7rem] font-bold uppercase tracking-wider text-brand-600 bg-brand-50 dark:bg-brand-950/50 px-2.5 py-1 rounded-full">
              {t.badge}
            </span>
          )}
          <h3 class="text-lg font-semibold text-ink-900 dark:text-white mb-2 group-hover:text-brand-600 transition-colors">
            {t.title}
          </h3>
          <p class="text-base text-ink-500 dark:text-slate-400 leading-relaxed">{t.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- How to -->
  <section id="how-to-download" class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <div class="rounded-[2rem] bg-white dark:bg-ink-900 border border-black/[0.06] dark:border-white/[0.08] shadow-soft p-7 sm:p-12">
      <h2 class="font-display text-3xl sm:text-4xl text-ink-900 dark:text-white mb-3">How to download</h2>
      <p class="text-lg text-ink-500 dark:text-slate-400 mb-10 max-w-2xl">
        Three steps on phone or desktop. No app install required.
      </p>
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
        <div class="p-6 sm:p-7 rounded-3xl bg-ink-50/80 dark:bg-white/[0.03] border border-black/[0.04] dark:border-white/[0.06]">
          <h3 class="text-xl font-semibold text-ink-900 dark:text-white mb-5">Mobile (iOS / Android)</h3>
          <ol class="space-y-4 text-base text-ink-700 dark:text-slate-300">
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">1</span><span>Open the pin in Pinterest and tap Share → Copy link.</span></li>
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">2</span><span>Paste into {BRAND.name} in Safari or Chrome.</span></li>
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">3</span><span>Download, then save to Photos / Gallery if needed.</span></li>
          </ol>
        </div>
        <div class="p-6 sm:p-7 rounded-3xl bg-ink-50/80 dark:bg-white/[0.03] border border-black/[0.04] dark:border-white/[0.06]">
          <h3 class="text-xl font-semibold text-ink-900 dark:text-white mb-5">Desktop browser</h3>
          <ol class="space-y-4 text-base text-ink-700 dark:text-slate-300">
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">1</span><span>Open the pin so the URL contains <code class="text-sm">/pin/</code>.</span></li>
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">2</span><span>Copy the address bar or share link.</span></li>
            <li class="flex gap-3"><span class="font-semibold text-brand-600 tabular-nums">3</span><span>Paste above and download your MP4 or image.</span></li>
          </ol>
        </div>
      </div>
      <p class="mt-8 text-base">
        <a href="/how-to-download-pinterest-videos" class="font-semibold text-brand-600 hover:underline">Full how-to guide →</a>
        <span class="text-ink-300 mx-2">·</span>
        <a href="/blog/using-pintdownload-on-phone-android-ios" class="font-semibold text-brand-600 hover:underline">Phone walkthrough →</a>
      </p>
    </div>
  </section>

  <!-- Trust -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <div class="rounded-[2rem] bg-white dark:bg-ink-900 border border-black/[0.06] dark:border-white/[0.08] shadow-soft p-7 sm:p-12">
      <h2 class="font-display text-3xl sm:text-4xl text-ink-900 dark:text-white mb-3">What we can and cannot do</h2>
      <p class="text-lg text-ink-500 dark:text-slate-400 mb-8">Honest boundaries keep {BRAND.name} trustworthy.</p>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="p-6 rounded-3xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-900/40">
          <h3 class="text-lg font-semibold text-emerald-950 dark:text-emerald-100 mb-3">We can</h3>
          <ul class="space-y-2.5 text-base text-ink-700 dark:text-slate-300">
            <li>Extract public pins, videos, GIFs, and images</li>
            <li>Pack public boards and profiles as ZIP</li>
            <li>Work on any modern browser without installs</li>
          </ul>
        </div>
        <div class="p-6 rounded-3xl bg-rose-50/70 dark:bg-rose-950/20 border border-rose-200/80 dark:border-rose-900/40">
          <h3 class="text-lg font-semibold text-rose-950 dark:text-rose-100 mb-3">We cannot</h3>
          <ul class="space-y-2.5 text-base text-ink-700 dark:text-slate-300">
            <li>Access private, secret, or login-only content</li>
            <li>Bypass DRM, paywalls, or platform locks</li>
            <li>Grant commercial rights to media you do not own</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="max-w-5xl mx-auto px-4 sm:px-6 pb-20 sm:pb-28">
    <h2 class="font-display text-3xl sm:text-4xl text-ink-900 dark:text-white mb-8 text-center">Questions</h2>
    <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
      {[
        { q: `Is ${BRAND.name} free?`, a: 'Yes — free for public media, no account required.' },
        { q: 'Does it work on phones?', a: 'Yes on iOS Safari and Android Chrome. No app install.' },
        { q: 'Where do files save?', a: 'Your browser Downloads folder, Files app, or Photos via the share sheet.' },
        { q: 'Can I download boards?', a: 'Yes — use the Board ZIP tool with a public board URL.' },
      ].map((item) => (
        <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-ink-900 border border-black/[0.06] dark:border-white/[0.08] shadow-soft text-left">
          <h3 class="font-semibold text-lg text-ink-900 dark:text-white mb-2">{item.q}</h3>
          <p class="text-base text-ink-500 dark:text-slate-400 leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
