---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { BRAND } from '../lib/brand';

const path = '/';
const pageUrl = `${BRAND.url}/`;
const title = 'Pinterest Downloader — Free Video, Photo, GIF, Board & Profile | PintDownload';
const description =
  'Free Pinterest downloader online. Paste a public pin, board, or profile link to save HD MP4 videos, photos, GIFs, carousels, and ZIP packs. No account, no watermark from us.';

const faqs = [
  {
    q: 'Is PintDownload free?',
    a: 'Yes. PintDownload is free for public Pinterest media with no account required.',
  },
  {
    q: 'What can I download from Pinterest?',
    a: 'Public videos (MP4), photos, GIFs, multi-image carousels, full boards as ZIP, and public profile pin packs. Use the hub form above or a specialized tool page.',
  },
  {
    q: 'How do I download a Pinterest video as MP4?',
    a: 'Copy the public pin link from the Pinterest app or browser, paste it above, extract, then download the MP4. Prefer links with /pin/ or pin.it.',
  },
  {
    q: 'Can I download boards and profiles as ZIP?',
    a: 'Yes. Paste a public board or profile URL to list pins, then download a ZIP pack. Dedicated Board and Profile tools are also linked in the nav.',
  },
  {
    q: 'What is the bookmarklet for?',
    a: 'Save the PintDownload bookmarklet to your bookmarks bar. When you are on a Pinterest pin, board, or profile page, click it once — we open with that link prefilled and start the download flow automatically.',
  },
  {
    q: 'Should I credit original creators?',
    a: 'Yes. If you reuse someone’s clip or image in content you publish, credit the creator and follow copyright rules. Public access is not a commercial license.',
  },
  {
    q: 'What does not work?',
    a: 'Private, secret, login-only, deleted, or restricted pins cannot be extracted. We do not invent higher quality than the source provides.',
  },
];

const steps = [
  {
    title: 'Copy the Pinterest link',
    body: 'Open the pin, board, or profile in the app or browser. Share → Copy link, or copy a full URL with <code>/pin/</code>. Short <code>pin.it</code> links work too.',
    image: '/images/step1.webp',
    imageAlt: 'Copy a Pinterest pin link from the share menu',
  },
  {
    title: 'Paste into PintDownload',
    body: 'Paste the public link in the box above and tap <strong>Download</strong>. Works for videos, photos, GIFs, boards, and profiles.',
    image: '/images/step2.webp',
    imageAlt: 'Paste the Pinterest URL into PintDownload',
  },
  {
    title: 'Preview and save',
    body: 'Choose quality if offered, then save to Downloads, Photos, or Gallery. Board and profile links pack into a ZIP.',
    image: '/images/step3.webp',
    imageAlt: 'Preview and download the Pinterest media file',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest videos, photos, GIFs, boards, and profiles',
    description: 'Copy a public Pinterest link, paste it into PintDownload, preview, and save the file or ZIP.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Hero card with background image + vertical centering & maximum mobile width -->
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-6 sm:mb-8 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-[85vh] sm:min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center py-8 sm:py-16 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden opacity-90 transition-all duration-300"
      style="background-image: url('/images/hero_background.webp'); background-size: cover; background-position: center center;"
      aria-hidden="true"
    />
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block opacity-90 transition-all duration-300"
      style="background-image: url('/images/hero_background_dark.webp'); background-size: cover; background-position: center center;"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/60 via-white/75 to-white/95 dark:from-ink-950/70 dark:via-ink-950/85 dark:to-ink-950/95"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-6 sm:pt-10 pb-6 sm:pb-8 w-full my-auto">
      {/* Mobile Floating Pin Preview Badges */}
      <div class="flex lg:hidden items-center justify-center gap-2 mb-4">
        <div class="flex -space-x-2 overflow-hidden p-1">
          <img src="/images/side_pin_1.jpg" alt="" class="inline-block h-8 w-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover" />
          <img src="/images/side_pin_2.jpg" alt="" class="inline-block h-8 w-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover" />
          <img src="/images/side_pin_3.jpg" alt="" class="inline-block h-8 w-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover" />
          <img src="/images/side_pin_4.jpg" alt="" class="inline-block h-8 w-8 rounded-full ring-2 ring-white dark:ring-slate-900 object-cover" />
        </div>
        <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300 bg-white/80 dark:bg-slate-900/80 px-2.5 py-1 rounded-full border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-sm">
          Viral Pin Saver
        </span>
      </div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/90 dark:bg-ink-900/90 text-[#E11D48] text-xs font-bold mb-4 border border-red-200/80 dark:border-red-900/40 shadow-sm backdrop-blur-md">
        Free · HD MP4 · Photos · GIFs · Boards &amp; profiles
      </div>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight max-w-3xl leading-tight mb-3"
        style="text-wrap: balance;"
      >
        Free <span class="text-[#E11D48]">Pinterest Downloader</span>
      </h1>

      <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base lg:text-lg max-w-2xl mb-6 sm:mb-8 leading-relaxed">
        Paste a public Pinterest link and save <strong class="text-slate-900 dark:text-white">videos as MP4</strong>,
        photos, GIFs, carousels, or full <strong class="text-slate-900 dark:text-white">board &amp; profile ZIPs</strong>
        — free, no account, no watermark from us.
      </p>

      <div class="w-full max-w-3xl">
        <DownloaderForm client:load variant="hub" layout="hero" />
      </div>

      <p class="mt-4 text-xs text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">
        Works with <code class="text-[11px] bg-white/80 dark:bg-ink-900/80 px-1.5 py-0.5 rounded border border-slate-200/60 dark:border-slate-800">/pin/</code>,
        <code class="text-[11px] bg-white/80 dark:bg-ink-900/80 px-1.5 py-0.5 rounded border border-slate-200/60 dark:border-slate-800">pin.it</code>,
        boards, and profiles. Public media only.
      </p>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full pb-12 sm:pb-16">
    <!-- Quick Feature Highlights -->
    <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 grid sm:grid-cols-3 gap-4 text-left text-sm">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Video, photo &amp; GIF</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">One hub for common pin types — or open Video, Pin, Photo, and GIF tools for clearer intent.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Board &amp; profile ZIP</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Paste a board or profile URL to list public pins and download a pack.</p>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Credit creators</h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">If you reuse clips in public content, credit the original creator and follow copyright rules.</p>
      </div>
    </div>

    <!-- STRIPE 1: How To Steps (Full Bleed Edge-to-Edge Stripe) -->
    <HowToSteps
      title="How to download from Pinterest (phone or desktop)"
      intro="Three steps. Videos, photos, GIFs, boards, and profiles — public links only, no login required."
      exampleUrl="https://pin.it/…"
      exampleLabel="Common shortlink"
      steps={steps}
      visual
      stripe={true}
    />

    <!-- STRIPE 2: Interactive Drag-and-Drop Bookmarklet Installer Guide -->
    <BookmarkletGuide />

    <!-- STRIPE 3: Creator credit (Full Bleed Accent Stripe) -->
    <section class="w-full py-12 sm:py-16 bg-red-50/70 dark:bg-red-950/40 border-y border-red-200/80 dark:border-red-900/40 text-left">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-extrabold text-slate-900 dark:text-white text-lg sm:text-xl mb-2">Credit original creators</h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-4xl">
          If you use someone else’s Pinterest video or image in content you publish (Reels, TikTok, YouTube, ads),
          <strong class="text-slate-800 dark:text-slate-200">credit the original creator</strong>.
          Personal offline reference is fine; republishing without credit or a license is not.
          <a href="/blog/using-downloaded-content-responsibly" class="font-bold text-[#E11D48] hover:underline">Ethics guide →</a>
        </p>
      </div>
    </section>

    <!-- STRIPE 4: Money Section (Full Bleed Edge-to-Edge Stripe) -->
    <section class="w-full py-14 sm:py-20 bg-slate-100/80 dark:bg-slate-900/70 border-y border-slate-200/80 dark:border-slate-800/80 text-left shadow-inner" aria-labelledby="money-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="money-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mb-2 scroll-mt-24">
          How people make money with Pinterest
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-6 max-w-3xl leading-relaxed">
          Creators and shop owners use Pinterest for affiliate traffic, digital products, and brand deals.
          Save pin references offline while you build your strategy — then publish original pins you own.
        </p>
        <div class="grid sm:grid-cols-3 gap-5">
          <a href="/blog/how-to-make-money-on-pinterest" class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-red-300 dark:hover:border-red-800 hover:shadow-md transition-all text-left group">
            <p class="text-[10px] font-bold uppercase tracking-wider text-[#E11D48] mb-1.5">Creators</p>
            <h3 class="font-extrabold text-slate-900 dark:text-white text-base group-hover:text-[#E11D48] transition-colors mb-2">Make money on Pinterest (2026)</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Affiliate, products, and creator paths in plain English.</p>
          </a>
          <a href="/blog/pinterest-affiliate-marketing-beginners" class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-red-300 dark:hover:border-red-800 hover:shadow-md transition-all text-left group">
            <p class="text-[10px] font-bold uppercase tracking-wider text-[#E11D48] mb-1.5">Affiliate</p>
            <h3 class="font-extrabold text-slate-900 dark:text-white text-base group-hover:text-[#E11D48] transition-colors mb-2">Affiliate marketing for beginners</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Niche, links, pin design, and honest disclosure tips.</p>
          </a>
          <a href="/blog/sell-digital-products-with-pinterest" class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-red-300 dark:hover:border-red-800 hover:shadow-md transition-all text-left group">
            <p class="text-[10px] font-bold uppercase tracking-wider text-[#E11D48] mb-1.5">Products</p>
            <h3 class="font-extrabold text-slate-900 dark:text-white text-base group-hover:text-[#E11D48] transition-colors mb-2">Sell digital products with pins</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Etsy, printables, and traffic without paid ads first.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- STRIPE 5: Compare Table (Boxed Floating Container) -->
    <div class="w-full py-8">
      <CompareTable highlight="pin" />
    </div>

    <!-- STRIPE 6: FAQ Section (Full Bleed Edge-to-Edge Stripe) -->
    <FaqSection title="Pinterest downloader FAQ" items={faqs} stripe={true} />

    <!-- STRIPE 7: Related Tools -->
    <div class="w-full py-8">
      <RelatedTools current={path} />
    </div>
  </article>
</BaseLayout>
