---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { BRAND } from '../lib/brand';

const path = '/';
const pageUrl = `${BRAND.url}/`;
const title = 'Pinterest Video Downloader — Free HD MP4, Photos & GIFs | PintDownload';
const description =
  'Free Pinterest video downloader online. Paste a public pin link to save HD MP4 videos, photos, GIFs, boards, and profiles. No account, no watermark from us.';

const faqs = [
  {
    q: 'Is PintDownload free?',
    a: 'Yes. PintDownload is free for public Pinterest media with no account required.',
  },
  {
    q: 'How do I download a Pinterest video as MP4?',
    a: 'Copy the public pin link from the Pinterest app or browser, paste it above, extract, then download the MP4. Prefer links with /pin/ or pin.it.',
  },
  {
    q: 'Can I download images, GIFs, boards, and profiles?',
    a: 'Yes. Use this hub for any public link, or open the dedicated Pin, Photo, Board ZIP, Profile ZIP, and GIF tools for clearer intent.',
  },
  {
    q: 'Should I credit original creators?',
    a: 'Yes. If you reuse someone’s clip or image in content you publish, credit the creator and follow copyright rules. Public access is not a commercial license.',
  },
  {
    q: 'What does not work?',
    a: 'Private, secret, login-only, deleted, or restricted pins cannot be extracted. We do not invent higher quality than the source provides.',
  },
];

const steps = [
  {
    title: 'Copy the Pinterest link',
    body: 'Open the pin in the app or browser. Share → Copy link, or copy a full URL with <code>/pin/</code>. Short <code>pin.it</code> links work too.',
    image: '/images/step1.jpg',
    imageAlt: 'Copy a Pinterest pin link from the share menu',
  },
  {
    title: 'Paste into PintDownload',
    body: 'Paste the public link in the box above and tap <strong>Download</strong>. Works for pins, boards, and profiles.',
    image: '/images/step2.jpg',
    imageAlt: 'Paste the Pinterest URL into PintDownload',
  },
  {
    title: 'Preview and save',
    body: 'Choose quality if offered, then save to Downloads, Photos, or Gallery. Board and profile links pack into a ZIP.',
    image: '/images/step3.jpg',
    imageAlt: 'Preview and download the Pinterest media file',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Video Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest videos on phone or desktop',
    description: 'Copy a public Pinterest link, paste it into PintDownload, preview, and save the file.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd}>
  <article class="flex flex-col items-center py-8 sm:py-12 text-center w-full">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200 dark:border-red-900/40">
      Free · HD MP4 · Pins, boards &amp; profiles
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight max-w-3xl leading-tight mb-4">
      Pinterest <span class="text-[#E11D48]">Video Downloader</span>
    </h1>

    <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mb-8 leading-relaxed">
      Paste a public Pinterest link and save <strong class="text-slate-800 dark:text-slate-200">videos as MP4</strong>,
      photos, GIFs, full carousels, or board/profile ZIPs — free, no account, no watermark from us.
    </p>

    <DownloaderForm client:load variant="hub" />

    <div class="mt-10 w-full max-w-3xl grid sm:grid-cols-3 gap-3 text-left text-sm">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Video, photo &amp; GIF</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">One hub for common pin types — or open a dedicated tool page for clearer intent.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Board &amp; profile ZIP</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Paste a board or profile URL to list public pins and download a pack.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Credit creators</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">If you reuse clips in public content, credit the original creator and follow copyright rules.</p>
      </div>
    </div>

    <div class="w-full max-w-4xl">
      <HowToSteps
        title="How to download Pinterest videos on phone or desktop"
        intro="Three steps. Public pins only — no login required."
        exampleUrl="https://pin.it/…"
        exampleLabel="Common shortlink"
        steps={steps}
        visual
      />

      <!-- Creator credit -->
      <aside class="mt-10 p-5 sm:p-6 rounded-2xl border border-red-200 dark:border-red-900/40 bg-red-50/50 dark:bg-red-950/20 text-left">
        <h2 class="font-extrabold text-slate-900 dark:text-white text-base sm:text-lg mb-2">Credit original creators</h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          If you use someone else’s Pinterest video or image in content you publish (Reels, TikTok, YouTube, ads),
          <strong class="text-slate-800 dark:text-slate-200">credit the original creator</strong>.
          Personal offline reference is fine; republishing without credit or a license is not.
          <a href="/blog/using-downloaded-content-responsibly" class="font-bold text-[#E11D48] hover:underline">Ethics guide →</a>
        </p>
      </aside>

      <CompareTable highlight="pin" title="Pin vs board vs profile — which tool?" />
      <FaqSection title="Pinterest downloader FAQ" items={faqs} />
      <RelatedTools current={path} title="Specialized Pinterest download tools" />
    </div>
  </article>
</BaseLayout>
