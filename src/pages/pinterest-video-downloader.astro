---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';

const path = '/pinterest-video-downloader';
const pageUrl = `https://pintdownload.app${path}`;
const title = 'Pinterest Video Downloader — Save Pins to MP4 HD Free Online';
const description =
  'Free Pinterest video downloader: paste a video pin link and save HD MP4 without watermarks. Works with pin.it shortlinks. No app install, no login.';

const faqs = [
  {
    q: 'How do I download a Pinterest video as MP4?',
    a: 'Copy the video pin link from the Pinterest app or browser, paste it into this video downloader, extract, then download the MP4 stream. Prefer links that contain /pin/ or pin.it.',
  },
  {
    q: 'What quality can I get?',
    a: 'When Pinterest exposes multiple streams, PintDownload lists available qualities (for example 720p/1080p-class MP4). Exact options depend on the pin.',
  },
  {
    q: 'Can I extract audio only?',
    a: 'Yes on many video pins — use Download MP3 Sound when the stream is available, or open the dedicated audio tool for audio-focused workflows.',
  },
  {
    q: 'Why is there no video on my pin?',
    a: 'The pin may be a static image, a private pin, or a format without a public MP4. Try the Pin or Image downloader if the pin is not a video.',
  },
  {
    q: 'Does this download whole boards of videos?',
    a: 'No. This page is for single video pins. For many pins at once use the Board or Profile ZIP tools.',
  },
];

const steps = [
  { title: 'Find a video pin', body: 'Open a pin that plays video (not a still photo grid card only).' },
  { title: 'Copy the link', body: 'Share → Copy link, or copy the browser URL with <code>/pin/</code>.' },
  { title: 'Paste & extract', body: 'Paste into the video tool above and run extract.' },
  { title: 'Save MP4', body: 'Choose quality if offered, then download the MP4 to your device.' },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Video Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest videos to MP4',
    description: 'Steps to save a Pinterest video pin as an MP4 file online.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd}>
  <article class="flex flex-col items-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200 dark:border-red-900/40">
      Video pin → HD MP4
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight max-w-3xl leading-tight mb-4">
      Pinterest <span class="text-[#E11D48]">Video Downloader</span>
    </h1>

    <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mb-8 leading-relaxed">
      Paste a public <strong class="text-slate-800 dark:text-slate-200">video pin</strong> URL and download the
      <strong class="text-slate-800 dark:text-slate-200">MP4</strong> stream online — free, no watermark, no install.
      For still photos use the image tool; for whole boards use ZIP tools.
    </p>

    <DownloaderForm client:load variant="video" />

    <div class="mt-10 w-full max-w-3xl grid sm:grid-cols-3 gap-3 text-left text-sm">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">MP4 focused</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Ranked for “Pinterest video downloader” and “save Pinterest video MP4” intent.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Quality picker</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">When multiple streams exist, pick the quality that fits your device.</p>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1 text-sm">Mobile friendly</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Works from iOS/Android browsers with pin.it shortlinks from the app.</p>
      </div>
    </div>

    <div class="w-full max-w-3xl">
      <HowToSteps
        title="How to download Pinterest videos on phone or desktop"
        intro="Works with public video pins. Board links belong on the Board Downloader page."
        exampleUrl="https://pin.it/…"
        exampleLabel="Common shortlink"
        steps={steps}
      />
      <CompareTable highlight="pin" title="Video pin vs board vs profile tools" />
      <FaqSection title="Pinterest video downloader FAQ" items={faqs} />
      <RelatedTools current={path} />
    </div>
  </article>
</BaseLayout>
