---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
---

<BaseLayout 
  title="Pinterest Video Downloader — Save Pins & Idea Pins to MP4" 
  description="Download Pinterest videos, stories, and idea pins to your device in full HD. Fast, free, and secure Pinterest downloader."
>
  <div class="flex flex-col items-center justify-center py-16 text-center">
    <div class="w-16 h-16 rounded-2xl bg-[#E60023] mb-8 flex items-center justify-center shadow-[0_0_40px_rgba(230,0,35,0.3)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
    </div>
    
    <h1 class="text-4xl sm:text-6xl font-heading font-bold text-white mb-6">
      Pinterest Video Downloader
    </h1>
    
    <p class="text-lg text-white/60 max-w-2xl mb-12">
      Paste any Pinterest video or Idea Pin link to download the high-quality MP4 file directly to your phone or computer.
    </p>

    <DownloaderForm client:load />
    
    <div class="mt-20 prose prose-invert max-w-none text-left w-full px-6 py-8 bg-white/5 border border-white/10 rounded-2xl">
      <h2 class="text-2xl font-heading font-bold mb-4 text-white">How to Download Pinterest Videos</h2>
      <ol class="list-decimal pl-5 space-y-2 text-white/70">
        <li>Find the video on the Pinterest app or website.</li>
        <li>Click the <strong>Share</strong> icon and select <strong>Copy Link</strong>.</li>
        <li>Paste the copied link into the box above.</li>
        <li>Click <strong>Download</strong> to extract the video.</li>
        <li>Save the video directly to your gallery or downloads folder!</li>
      </ol>
    </div>
  </div>
</BaseLayout>

