---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import CompareTable from '../components/seo/CompareTable.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-video-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest Video Downloader — Free HD MP4 Online';
const description =
  'Free Pinterest video downloader: paste a video pin link and save HD MP4 without watermarks. Works with pin.it shortlinks. No app install, no login.';

const faqs = [
  {
    q: 'How do I download a Pinterest video as MP4?',
    a: 'Copy the video pin link from the Pinterest app or browser (Share → Copy link, or a URL with /pin/ or pin.it). Paste it into this video downloader, extract, then download the MP4 stream. Public video pins only.',
  },
  {
    q: 'What quality can I get — 720p, 1080p, or 4K?',
    a: 'When Pinterest exposes multiple streams, PintDownload lists available qualities (for example 720p/1080p-class MP4). We cannot invent higher resolution than the source pin. For max-quality workflows also see the 4K downloader page when the pin supports it.',
  },
  {
    q: 'Does this work on iPhone and Android?',
    a: 'Yes. Open pintdownload.app in Safari or Chrome, paste the pin.it or full pin URL from the Pinterest app, then save the MP4 to Files/Photos or Downloads. No app install required.',
  },
  {
    q: 'Can I extract audio only from a Pinterest video?',
    a: 'Yes on many video pins — use Download MP3 Sound when the stream is available, or open the dedicated Pinterest audio downloader for audio-focused workflows.',
  },
  {
    q: 'Why is there no video on my pin?',
    a: 'The pin may be a static image, a private pin, a deleted pin, or a format without a public MP4. Try the Pin or Image downloader if the pin is not a video.',
  },
  {
    q: 'Does this download whole boards of videos?',
    a: 'No. This page is for single video pins. For many pins at once use the Board or Profile ZIP tools. For one multi-slide Idea Pin see the Story downloader.',
  },
  {
    q: 'Is the Pinterest video downloader free and watermark-free?',
    a: 'Yes. PintDownload is free for public media. We do not add our own watermark to the MP4. Always credit creators if you republish their work.',
  },
];

const steps = [
  {
    title: 'Find a video pin',
    body: 'Open a pin that actually plays video (not a still photo grid card). Confirm playback on Pinterest first.',
  },
  {
    title: 'Copy the video link',
    body: 'Share → Copy link, or copy the browser URL with <code>/pin/</code>. Short <code>pin.it</code> links from the app work too.',
  },
  {
    title: 'Paste & extract',
    body: 'Paste into the video tool above and run extract. Choose quality if multiple MP4 streams are listed.',
  },
  {
    title: 'Save MP4',
    body: 'Download the MP4 to your device. On mobile, save to Photos, Gallery, or Files depending on your browser.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest Video Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download Pinterest videos to MP4',
    description: 'Steps to save a public Pinterest video pin as an HD MP4 file online.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout field="tangerine" title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <TicketHero title={"Pinterest Video Downloader"} lede={"Save public video pins as <strong>HD MP4</strong> — free, no login, no watermark."} variant="video" />

  <article class="tool-body flex flex-col w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-12 sm:pb-16 text-left">
    <div class="w-full max-w-3xl mb-6 counter-rule pt-4">
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-3 leading-relaxed">
        Paste a public <strong class="text-slate-900 dark:text-white">video pin</strong> URL and download the
        <strong class="text-slate-900 dark:text-white">MP4</strong> stream online — free, no watermark, no install.
      </p>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Works with <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">/pin/</code> and
        <code class="text-[11px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">pin.it</code> shortlinks. Public video pins only.
      </p>
    </div>

    <div class="mt-2 w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm mb-10">
      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">MP4 video only</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Built for “download Pinterest video” and “save Pinterest video MP4” intent — not still photos or board ZIPs.
        </p>
      </div>
      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Quality picker</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          When multiple streams exist, pick the quality that fits your phone, laptop, or offline archive.
        </p>
      </div>
      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <h2 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Mobile &amp; desktop</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Works from iOS Safari and Android Chrome with pin.it links copied from the Pinterest app.
        </p>
      </div>
    </div>

    <section class="w-full max-w-3xl text-left mb-12 space-y-4 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white text-center mb-2">
        Video downloader vs pin, board, and image tools
      </h2>
      <p>
        Use this page when the pin <strong>plays video</strong> and you want a single MP4 file. For a still photo, open the
        <a href="/pinterest-image-downloader" class="text-rose-700 dark:text-rose-400 font-semibold underline-offset-2 hover:underline">Image Downloader</a>.
        For one pin that might be image, GIF, or carousel, use the
        <a href="/pinterest-pin-downloader" class="text-rose-700 dark:text-rose-400 font-semibold underline-offset-2 hover:underline">Pin Downloader</a>.
        For many pins at once, use
        <a href="/pinterest-board-downloader" class="text-rose-700 dark:text-rose-400 font-semibold underline-offset-2 hover:underline">Board ZIP</a>
        or
        <a href="/pinterest-profile-downloader" class="text-rose-700 dark:text-rose-400 font-semibold underline-offset-2 hover:underline">Profile ZIP</a>.
      </p>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong>Video pin → MP4</strong> → this tool</li>
        <li><strong>Still photo / artwork</strong> → Image Downloader</li>
        <li><strong>Whole board moodboard</strong> → Board Downloader</li>
      </ul>
    </section>

    <div class="w-full">
      <HowToSteps
        title="How to download Pinterest videos on phone or desktop"
        intro="Works with public video pins. Board links belong on the Board Downloader page."
        exampleUrl="https://pin.it/…"
        exampleLabel="Common shortlink"
        steps={steps}
        visual
        stripe={true}
      />
      <CompareTable highlight="pin" title="Video pin vs board vs profile tools" />
      <FaqSection title="Pinterest video downloader FAQ" items={faqs} />
      <RelatedTools current={path} />
    </div>
  </article>
</BaseLayout>
