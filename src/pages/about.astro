---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About viralNest — Free Pinterest Media Saver" description="About viralNest Pinterest Downloader tool.">
  <div class="max-w-3xl mx-auto py-8 text-left bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-sm">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-4">About viralNest</h1>
    <p class="text-slate-600 text-sm leading-relaxed mb-6">
      viralNest is a high-performance online media extraction utility created to help designers, video creators, students, and researchers save public Pinterest videos, images, Idea Pins, and GIFs.
    </p>

    <h2 class="text-xl font-bold text-slate-900 mb-3">Our Mission</h2>
    <p class="text-slate-600 text-sm leading-relaxed mb-6">
      Our goal is to deliver a clean, fast, 100% free tool without annoying ads, popups, or required account signups.
    </p>

    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500">
      <strong>Disclaimer:</strong> viralNest is an independent utility and is not affiliated, sponsored, or endorsed by Pinterest Inc.
    </div>
  </div>
</BaseLayout>
