---
import BaseLayout from '../layouts/BaseLayout.astro';
import TicketHero from '../components/TicketHero.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import RelatedTools from '../components/seo/RelatedTools.astro';
import BookmarkletGuide from '../components/seo/BookmarkletGuide.astro';
import { BRAND } from '../lib/brand';
import { webPageSchema, softwareAppSchema, howToSchema, faqSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/download-pinterest-videos-iphone-android';
const pageUrl = absoluteUrl(path);
const title = 'Download Pinterest Videos to iPhone & Android (Free HD MP4)';
const description =
  'Save Pinterest videos directly to your iPhone Camera Roll or Android Gallery. Free online Pinterest video downloader for mobile devices — no app required.';

const steps = [
  {
    title: 'Copy Video Link from Pinterest App',
    body: 'Open the official Pinterest app on your iPhone or Android phone. Tap the Share icon on any video or Idea Pin and select "Copy Link".',
  },
  {
    title: 'Paste in Safari or Chrome Mobile Browser',
    body: 'Open Safari on iOS or Chrome on Android, head to PintDownload, paste the copied link into the input box above, and tap "Download".',
  },
  {
    title: 'Export to Photos / Camera Roll',
    body: 'Tap "Download MP4". On iOS Safari, open the download manager, tap the file, hit Share, and select "Save Video" to store it in your Camera Roll.',
  },
];

const faqs = [
  {
    q: 'How do I save Pinterest videos directly to my iPhone Camera Roll?',
    a: 'Paste the video URL into PintDownload using Safari. Once the video processes, tap Download MP4. Next, tap the blue Safari download arrow, open the MP4 file, tap the Share icon, and select "Save Video" so iOS transfers it into your Photos app.',
  },
  {
    q: 'How do Android users save Pinterest videos to Google Photos / Gallery?',
    a: 'On Android Chrome, simply paste the link and tap Download MP4. Your Android browser saves the video file straight to your internal Downloads folder, which immediately appears inside your Google Photos or Samsung Gallery app.',
  },
  {
    q: 'Why do I not need to install an App Store or Play Store app?',
    a: 'PintDownload is built with web technologies that execute directly inside mobile browsers (Safari, Chrome, Firefox, Brave). It saves your phone battery, storage, and privacy.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'iPhone & Android Pinterest Video Downloader',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to Save Pinterest Videos on iPhone & Android',
    description,
    steps: steps.map((s) => ({ name: s.title, text: s.body })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout field="tangerine" title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <!-- Minimalist Hero card matching original downloader layout -->
  <TicketHero title={"Pinterest Videos to iPhone & Android Gallery"} variant="video" />

  <!-- SEO Content downside -->
  <article class="tool-body flex flex-col w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-12 sm:pb-16 text-left">
    <div class="w-full max-w-3xl mb-8 counter-rule pt-4">
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-4 leading-relaxed">
        Save public <strong class="text-slate-900 dark:text-white">Pinterest videos &amp; Idea Pins</strong> directly into your phone photos app in <strong class="text-slate-900 dark:text-white">HD MP4</strong> format — no app store download required.
      </p>
    </div>

    <!-- Unique Mobile Feature Cards -->
    <div class="w-full max-w-5xl grid sm:grid-cols-3 gap-4 text-left text-sm mb-12">
      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">📱</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">iOS Camera Roll Export</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Seamless step-by-step export from Safari downloads directly into Apple Photos app Camera Roll.</p>
      </div>

      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">🤖</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Android Gallery Auto-Sync</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Downloads store straight into Android internal storage and render inside Google Photos &amp; Samsung Gallery.</p>
      </div>

      <div class="pt-3 border-t-2 border-[var(--ink)]">
        <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-rose-700 dark:text-rose-300 flex items-center justify-center font-bold mb-3">⚡</div>
        <h3 class="font-extrabold text-slate-900 dark:text-white mb-1.5 text-base">Zero Mobile App Needed</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">No need to download bloated third-party apps from App Store or Play Store. Works 100% in mobile browser.</p>
      </div>
    </div>

    <HowToSteps title="How to save Pinterest video to phone gallery" intro="Follow these 3 easy steps on iOS Safari or Android Chrome." exampleUrl="https://pin.it/…" exampleLabel="Pinterest Mobile Link" steps={steps} visual stripe={true} />
    <BookmarkletGuide />
    <FaqSection items={faqs} title="Mobile Gallery Download FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
