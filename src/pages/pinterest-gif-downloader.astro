---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest GIF Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout
  title="Pinterest GIF Downloader — Save Animated GIFs from Pinterest Free"
  description="Download animated GIFs from Pinterest online for free. Convert animated Pinterest pins to GIF or MP4 files directly."
  jsonLd={webAppSchema}
  fullBleed
>
  <!-- Hero card with curved background image -->
  <section
    class="relative mx-3 sm:mx-6 lg:mx-8 xl:mx-10 mt-2 sm:mt-3 mb-4 sm:mb-6 rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col justify-center items-center py-10 sm:py-14 border border-red-100/80 dark:border-red-900/30 shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <!-- Light theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat dark:hidden"
      style="background-image: url('/images/hero_background.webp');"
      aria-hidden="true"
    />
    <!-- Dark theme hero background -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat hidden dark:block"
      style="background-image: url('/images/hero_background_dark.webp');"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/45 via-white/65 to-white/85 dark:from-ink-950/60 dark:via-ink-950/75 dark:to-ink-950/90"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 sm:px-8 lg:px-12 pt-12 sm:pt-14 lg:pt-16 pb-6 sm:pb-8 lg:pb-10 w-full my-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/80 dark:bg-ink-900/80 text-[#E11D48] text-xs sm:text-sm font-bold mb-6 border border-red-200/80 dark:border-red-900/40 shadow-sm backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 10 4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14v-4z"/><rect width="12" height="12" x="3" y="6" rx="2"/></svg>
        Free Animated GIF Downloader
      </div>

      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-4"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-[#E11D48]">GIF Downloader</span>
      </h1>

      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mb-8 leading-relaxed">
        Download high-speed animated GIFs posted on Pinterest directly to your phone or computer.
      </p>

      <div class="w-full max-w-4xl">
        <DownloaderForm client:load />
      </div>

      <p class="mt-5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">
        Works with animated pin URLs. Public GIF pins only.
      </p>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <!-- Info Box -->
    <div class="mt-2 w-full max-w-3xl text-left bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">How to Save GIFs from Pinterest?</h2>
      <ol class="space-y-3 text-slate-600 dark:text-slate-400 text-sm font-medium">
        <li>1. Copy the animated GIF Pin URL from the Pinterest app or site.</li>
        <li>2. Paste the link into the box above and tap Download.</li>
        <li>3. Save the GIF file straight to your gallery or camera roll.</li>
      </ol>
    </div>
  </article>
</BaseLayout>
