---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';
import RelatedTools from '../components/seo/RelatedTools.astro';
import FaqSection from '../components/seo/FaqSection.astro';
import HowToSteps from '../components/seo/HowToSteps.astro';
import { softwareAppSchema, howToSchema, faqSchema, webPageSchema } from '../lib/seo';
import { absoluteUrl } from '../lib/urls';

const path = '/pinterest-gif-downloader';
const pageUrl = absoluteUrl(path);
const title = 'Pinterest GIF Downloader — Save Animated GIFs Free';
const description =
  'Download GIFs from Pinterest without losing animation. Paste a public GIF pin and save the original looping file — no login, no watermark, phone or desktop.';

const steps = [
  {
    title: 'Open the GIF pin',
    body: 'Confirm it loops like a GIF (often no audio and no timeline scrubber). A real MP4 video belongs on the video tool instead.',
  },
  {
    title: 'Copy the pin link',
    body: 'Share → Copy link, or copy a URL with <code>/pin/</code>. Short <code>pin.it</code> links work too.',
  },
  {
    title: 'Paste and save the GIF',
    body: 'Paste above, extract, then download. Open the file in a browser or Photos app that plays animation — some galleries freeze on the first frame.',
  },
];

const faqs = [
  {
    q: 'How do I download a GIF from Pinterest?',
    a: 'Copy the public GIF pin URL, paste it into this Pinterest GIF downloader, extract, and save the .gif file. Do not use the video tool first if the pin has no real MP4 stream.',
  },
  {
    q: 'Why did my Pinterest GIF download as a photo?',
    a: 'Some “moving” pins are still images, Idea Pin covers, or tools that only grab a poster frame. Use this GIF page, or read why a video sometimes saves as a photo.',
  },
  {
    q: 'Is this different from Pinterest to MP4?',
    a: 'Yes. This page keeps animated GIFs as GIFs. Use Pinterest to MP4 or the video downloader when you need a real MP4 with a duration bar.',
  },
  {
    q: 'Do I need a Pinterest account?',
    a: 'No. Public GIF pins only. Private or secret pins cannot be extracted.',
  },
  {
    q: 'Will the GIF stay animated in my gallery?',
    a: 'Most Android galleries play GIFs. Some iOS views show the first frame until you open the file. Try Safari or a GIF-capable app if it looks frozen.',
  },
];

const jsonLd = [
  webPageSchema({ name: title, description, url: pageUrl }),
  softwareAppSchema({
    name: 'Pinterest GIF Downloader — PintDownload',
    description,
    url: pageUrl,
  }),
  howToSchema({
    name: 'How to download a GIF from Pinterest',
    description: 'Copy a public GIF pin, paste it into PintDownload, and save the animated file.',
    steps: steps.map((s) => ({ name: s.title, text: s.body.replace(/<[^>]+>/g, '') })),
  }),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} canonicalUrl={pageUrl} jsonLd={jsonLd} fullBleed>
  <section
    class="relative mx-0 sm:mx-6 lg:mx-8 xl:mx-10 mt-0 sm:mt-3 mb-6 sm:mb-8 rounded-none sm:rounded-[2.5rem] overflow-hidden min-h-[68svh] sm:min-h-[64svh] flex flex-col justify-center items-center py-10 sm:py-14 border-0 sm:border border-red-100/80 dark:border-red-900/30 shadow-none sm:shadow-[0_20px_60px_-20px_rgba(225,29,72,0.35)]"
    aria-labelledby="hero-heading"
  >
    <div
      class="absolute inset-0 bg-no-repeat dark:hidden opacity-40"
      style="background-image: url('/images/hero_background.webp'); background-size: cover; background-position: center center;"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-no-repeat hidden dark:block opacity-30"
      style="background-image: url('/images/hero_background_dark.webp'); background-size: cover; background-position: center center;"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/85 to-white dark:from-ink-950/90 dark:via-ink-950/90 dark:to-ink-950"
      aria-hidden="true"
    />

    <div class="relative z-10 flex flex-col items-center justify-center text-center px-3 sm:px-8 lg:px-12 pt-6 sm:pt-10 pb-4 sm:pb-8 w-full my-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/90 dark:bg-ink-900/90 text-rose-700 dark:text-rose-300 text-xs font-bold mb-4 border border-red-200/80 dark:border-red-900/40 shadow-sm backdrop-blur-md">
        Free forever · Full animation loop preserved
      </div>
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight max-w-4xl leading-tight mb-4 sm:mb-6"
        style="text-wrap: balance;"
      >
        Pinterest <span class="text-rose-600 dark:text-rose-400">GIF Downloader</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mb-6 sm:mb-8 leading-relaxed">
        Save animated Pinterest GIFs — keep the full loop, skip the still-frame surprise.
      </p>
      <div class="w-full max-w-4xl">
        <DownloaderForm client:load variant="gif" />
      </div>
    </div>
  </section>

  <article class="flex flex-col items-center text-center w-full max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/40 text-rose-700 dark:text-rose-300 text-xs font-bold mb-3 border border-red-200/80 dark:border-red-900/40 shadow-sm">
        Free Animated GIF Downloader
      </div>
      <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-4 leading-relaxed">
        Searching for <strong class="text-slate-900 dark:text-white">gif download Pinterest</strong> or
        <strong class="text-slate-900 dark:text-white">download GIF from Pinterest</strong>?
        This tool extracts the public animated file instead of a static JPG cover.
      </p>
    </div>

    <HowToSteps
      title="How to save GIFs from Pinterest"
      intro="Three steps. Public GIF pins only — no account required."
      exampleUrl="https://pin.it/…"
      exampleLabel="GIF pin link"
      steps={steps}
      stripe={true}
    />
    <FaqSection items={faqs} title="Pinterest GIF download FAQs" />
    <RelatedTools currentPath={path} />
  </article>
</BaseLayout>
