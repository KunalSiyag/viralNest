---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloaderForm from '../components/DownloaderForm';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pinterest GIF Downloader",
  "operatingSystem": "All",
  "applicationCategory": "MultimediaApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout 
  title="Pinterest GIF Downloader — Save Animated GIFs from Pinterest Free" 
  description="Download animated GIFs from Pinterest online for free. Convert animated Pinterest pins to GIF or MP4 files directly."
  jsonLd={webAppSchema}
>
  <div class="flex flex-col items-center justify-center py-8 sm:py-12 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-[#E60023] text-xs sm:text-sm font-bold mb-6 border border-red-200 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 10 4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14v-4z"/><rect width="12" height="12" x="3" y="6" rx="2"/></svg>
      Free Animated GIF Downloader
    </div>
    
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight max-w-3xl">
      Pinterest <span class="text-[#E60023]">GIF Downloader</span>
    </h1>
    
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed font-medium">
      Download high-speed animated GIFs posted on Pinterest directly to your phone or computer.
    </p>

    <DownloaderForm client:load />

    <!-- Info Box -->
    <div class="mt-16 w-full text-left bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">How to Save GIFs from Pinterest?</h2>
      <ol class="space-y-3 text-slate-600 text-sm font-medium">
        <li>1. Copy the animated GIF Pin URL from the Pinterest app or site.</li>
        <li>2. Paste the link into the box above and tap Download.</li>
        <li>3. Save the GIF file straight to your gallery or camera roll.</li>
      </ol>
    </div>
  </div>
</BaseLayout>
