---
interface Step {
  title: string;
  body: string;
  /** Optional illustration path under /public */
  image?: string;
  imageAlt?: string;
}

interface Props {
  title: string;
  intro?: string;
  steps: Step[];
  exampleUrl?: string;
  exampleLabel?: string;
  /** When true, show image cards in a responsive grid */
  visual?: boolean;
  /** When true, apply contrasting section stripe container */
  stripe?: boolean;
}

const { title, intro, steps, exampleUrl, exampleLabel, visual = false, stripe = true } = Astro.props;
const hasImages = steps.some((s) => s.image);
const useVisual = visual || hasImages;
---

<section
  class:list={['w-full text-left', stripe ? 'py-12 sm:py-16' : 'mt-10 sm:mt-14']}
  aria-labelledby="howto-heading"
>
  <div class:list={[stripe ? 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8' : '']}>
    <div class="counter-rule pt-4 mb-6 sm:mb-8 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] gap-x-10 gap-y-3 items-end">
      <h2 id="howto-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">{title}</h2>
      <div>
        {intro && <p class="text-base text-[var(--ink-2)] leading-relaxed">{intro}</p>}
        {exampleUrl && (
          <p class="mt-2 text-sm text-[var(--ink-2)]">
            <span class="font-bold text-[var(--ink)]">{exampleLabel || 'Example URL'}:</span>{' '}
            <code class="text-[0.8125rem] font-semibold text-[var(--ink)] break-all" translate="no">{exampleUrl}</code>
          </p>
        )}
      </div>
    </div>

    <ol class:list={['list-none p-0 m-0 grid gap-4 sm:gap-5', useVisual ? 'sm:grid-cols-3' : steps.length > 3 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3']}>
      {steps.map((step, i) => (
        <li class="flex flex-col bg-[var(--paper)] rounded-md overflow-hidden">
          <div class="flex items-baseline justify-between gap-3 px-4 pt-3 pb-2">
            <span class="t-label text-[var(--ink-2)]">Step</span>
            <span class="t-display text-5xl leading-none text-brand-600 dark:text-brand-400" aria-hidden="true">{i + 1}</span>
          </div>
          {step.image && (
            <div class="aspect-[3/2] overflow-hidden bg-[var(--paper-2)] mx-4 rounded">
              <img
                src={step.image}
                alt={step.imageAlt || step.title}
                width={900}
                height={600}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="mx-4 mt-3 border-t-2 border-dashed border-[var(--rule)]" aria-hidden="true"></div>
          <div class="p-4 flex-1">
            <h3 class="font-bold text-lg leading-snug mb-1"><span class="sr-only">Step {i + 1}: </span>{step.title}</h3>
            <p class="text-[0.9375rem] text-[var(--ink-2)] leading-relaxed [&_code]:font-semibold [&_code]:text-[var(--ink)] [&_code]:[overflow-wrap:anywhere] [&_strong]:text-[var(--ink)]" set:html={step.body} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
