---
interface Step {
  title: string;
  body: string;
  /** Optional illustration path under /public */
  image?: string;
  imageAlt?: string;
}

interface Props {
  title: string;
  intro?: string;
  steps: Step[];
  exampleUrl?: string;
  exampleLabel?: string;
  /** When true, show image cards in a responsive grid */
  visual?: boolean;
  /** When true, apply contrasting section stripe container */
  stripe?: boolean;
}

const { title, intro, steps, exampleUrl, exampleLabel, visual = false, stripe = true } = Astro.props;
const hasImages = steps.some((s) => s.image);
const useVisual = visual || hasImages;
---

<section
  class:list={['w-full text-left', stripe ? 'py-12 sm:py-16' : 'mt-10 sm:mt-14']}
  aria-labelledby="howto-heading"
>
  <div class:list={[stripe ? 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8' : '']}>
    <div class="counter-rule pt-4 mb-6 sm:mb-8 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] gap-x-10 gap-y-3 items-end">
      <h2 id="howto-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">{title}</h2>
      <div>
        {intro && <p class="text-base text-[var(--ink-2)] leading-relaxed">{intro}</p>}
        {exampleUrl && (
          <p class="mt-2 text-sm text-[var(--ink-2)]">
            <span class="font-bold text-[var(--ink)]">{exampleLabel || 'Example URL'}:</span>{' '}
            <code class="text-[0.8125rem] font-semibold text-[var(--ink)] break-all" translate="no">{exampleUrl}</code>
          </p>
        )}
      </div>
    </div>

    <ol
      class:list={[
        'list-none p-0 m-0 grid bg-[var(--paper)] rounded-md',
        steps.length > 3 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3',
      ]}
    >
      {steps.map((step, i) => (
        <li
          class:list={[
            'flex flex-col p-4 sm:p-5 border-dashed border-[var(--rule)]',
            i > 0 && 'border-t-2 sm:border-t-0 sm:border-l-2',
            steps.length > 3 && i === 2 && 'sm:border-l-0 sm:border-t-2 lg:border-t-0 lg:border-l-2',
            steps.length > 3 && i === 3 && 'sm:border-t-2 lg:border-t-0',
          ]}
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-bold text-lg leading-snug pt-1"><span class="sr-only">Step {i + 1}: </span>{step.title}</h3>
            <span class="t-display text-5xl leading-[0.8] text-brand-600 dark:text-brand-400 shrink-0" aria-hidden="true">{i + 1}</span>
          </div>
          <p class="mt-2 text-[0.9375rem] text-[var(--ink-2)] leading-relaxed [&_code]:font-semibold [&_code]:text-[var(--ink)] [&_code]:[overflow-wrap:anywhere] [&_strong]:text-[var(--ink)]" set:html={step.body} />
          {/* mt-auto: wells share one bottom edge whatever the body length. The ground is the
              step art's own ticket-red field (src/assets/steps), so lazy loads do not flash grey. */}
          {step.image && (
            <div class="mt-auto pt-4">
              <div class="aspect-[3/2] overflow-hidden bg-brand-600 rounded">
                <img
                  src={step.image}
                  alt={step.imageAlt || step.title}
                  width={900}
                  height={600}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
