---
const bookmarkletCode = `javascript:(function(){var u=location.href;if(u.indexOf('pinterest.com')===-1&&u.indexOf('pin.it')===-1){alert('Please open a Pinterest page first!');return;}window.open('https://pintdownload.app/?url='+encodeURIComponent(u)+'&auto=true','_blank');})();`;
---

<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-left" aria-labelledby="bookmarklet-heading">
  <div class="bg-ink-900 text-white rounded-md overflow-hidden grid lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]">
    <div class="p-6 sm:p-10 flex flex-col gap-5">
      <h2 id="bookmarklet-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">
        One-click bookmarklet
      </h2>
      <p class="text-base text-slate-200 leading-relaxed max-w-xl">
        Save Pinterest videos, photos, and boards while you browse Pinterest on a computer. Click the bookmark on any pin and PintDownload opens with that link ready.
      </p>
      <div>
        <a
          href={bookmarkletCode}
          onclick="alert('Drag this button to your browser Bookmarks Bar to install!'); return false;"
          class="inline-flex items-center gap-2 min-h-[3.25rem] px-6 rounded-md bg-stock-canary text-ink-900 t-display text-xl cursor-grab active:cursor-grabbing hover:bg-white transition-colors"
          title="Drag me to your Bookmarks Bar"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
          <span>Drag to bookmarks bar</span>
        </a>
      </div>
      <ol class="grid sm:grid-cols-3 gap-5 text-[0.9375rem] pt-5 mt-1 border-t-2 border-dashed border-white/25 list-none p-0">
        <li>
          <h3 class="t-label text-stock-canary mb-1.5">Chrome / Edge</h3>
          <p class="text-slate-200 leading-relaxed">
            Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 font-semibold text-white">Ctrl+Shift+B</kbd> (Cmd+Shift+B on Mac) to show the bookmarks bar, then drag the button onto it.
          </p>
        </li>
        <li>
          <h3 class="t-label text-stock-canary mb-1.5">Safari</h3>
          <p class="text-slate-200 leading-relaxed">
            Drag to Favorites. On iPhone or iPad, bookmark any page, edit its URL, and paste the bookmarklet code.
          </p>
        </li>
        <li>
          <h3 class="t-label text-stock-canary mb-1.5">Use it</h3>
          <p class="text-slate-200 leading-relaxed">
            On a pin or board, click your <strong class="text-white">PintDownload</strong> bookmark. We open with the link filled in.
          </p>
        </li>
      </ol>
    </div>
    <div class="bg-ink-800 p-4 sm:p-6 flex items-center">
      <img
        src="/images/bookmark.webp"
        alt="How to bookmark PintDownload in Chrome: open the menu, go to Bookmarks, choose Bookmark this tab, and save to the bookmarks bar"
        width={1200}
        height={675}
        class="w-full h-auto rounded"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
