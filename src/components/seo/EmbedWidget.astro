---
---

<section class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-left" aria-labelledby="embed-heading">
  <div class="counter-rule pt-4 mb-6 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] gap-x-10 gap-y-3 items-end">
    <h2 id="embed-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">Embed the downloader on your site</h2>
    <p class="text-base text-[var(--ink-2)] leading-relaxed">
      Run a blog or tech site? Add the PintDownload widget for free. Your readers get one-paste downloads; the snippet links back to us.
    </p>
  </div>
  <div class="bg-[var(--paper)] rounded-md p-4 sm:p-6">
    <label for="embed-code-textarea" class="t-label block mb-2">HTML embed code</label>
    <textarea
      id="embed-code-textarea"
      name="embedCode"
      readonly
      rows="4"
      class="w-full font-mono text-[0.8125rem] leading-relaxed p-4 rounded bg-ink-900 text-slate-100 border-0 focus:outline-none focus-visible:outline-2 select-all cursor-pointer"
    >&lt;!-- PintDownload Pinterest Downloader Widget --&gt;
&lt;iframe src="https://pintdownload.app/embed" width="100%" height="320" frameborder="0" style="border-radius:8px;" title="Free Pinterest Downloader"&gt;&lt;/iframe&gt;
&lt;p style="font-size:11px;text-align:center;color:#64748b;margin-top:6px;"&gt;Powered by &lt;a href="https://pintdownload.app/" target="_blank" rel="noopener"&gt;PintDownload Pinterest Downloader&lt;/a&gt;&lt;/p&gt;</textarea>
    <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <p class="text-sm text-[var(--ink-2)]">Paste it anywhere your site accepts HTML.</p>
      <button
        id="copy-embed-btn"
        type="button"
        class="shrink-0 inline-flex items-center justify-center gap-2 min-h-[2.75rem] px-5 rounded-md bg-ink-900 text-white dark:bg-ink-100 dark:text-ink-900 font-bold text-sm hover:bg-brand-600 hover:text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        <span id="copy-embed-label">Copy embed code</span>
      </button>
    </div>
    <p class="sr-only" aria-live="polite" id="copy-embed-status"></p>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-embed-btn');
  const textarea = document.getElementById('embed-code-textarea') as HTMLTextAreaElement;

  if (copyBtn && textarea) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(textarea.value);
        const label = document.getElementById('copy-embed-label');
        const status = document.getElementById('copy-embed-status');
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Embed code copied to clipboard';
        setTimeout(() => {
          if (label) label.textContent = 'Copy embed code';
        }, 3000);
      } catch (e) {
        textarea.select();
      }
    });
  }
</script>
