---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  items: FaqItem[];
}

const { title = 'Frequently asked questions', items } = Astro.props;
---

<section class="mt-14 w-full text-left" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mb-5 scroll-mt-24">
    {title}
  </h2>
  <div class="space-y-3">
    {items.map((item, i) => (
      <details
        class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 open:border-red-200 dark:open:border-red-900/50 open:shadow-sm transition-colors"
        open={i === 0}
      >
        <summary class="cursor-pointer list-none flex items-start justify-between gap-3 p-4 sm:p-5 font-bold text-sm sm:text-base text-slate-900 dark:text-white touch-manipulation [&::-webkit-details-marker]:hidden">
          <span class="min-w-0">{item.q}</span>
          <span
            class="shrink-0 w-6 h-6 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 flex items-center justify-center text-lg leading-none group-open:rotate-45 transition-transform"
            aria-hidden="true"
          >+</span>
        </summary>
        <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
