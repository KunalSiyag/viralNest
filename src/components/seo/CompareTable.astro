---
interface Row {
  feature: string;
  pin: string;
  board: string;
  profile: string;
}

interface Props {
  title?: string;
  highlight?: 'pin' | 'board' | 'profile';
  rows?: Row[];
  stripe?: boolean;
}

const defaultRows: Row[] = [
  {
    feature: 'URL example',
    pin: 'pinterest.com/pin/123…',
    board: 'pinterest.com/user/board/',
    profile: 'pinterest.com/user/',
  },
  {
    feature: 'What you get',
    pin: '1 file or full carousel',
    board: 'Many pins → ZIP',
    profile: 'Visible pins → ZIP',
  },
  {
    feature: 'Best for',
    pin: 'Saving one idea / video',
    board: 'Moodboards & collections',
    profile: 'Creator bulk backup',
  },
  {
    feature: 'Carousel slides',
    pin: 'Yes — every slide',
    board: 'Cover per pin*',
    profile: 'Cover per pin*',
  },
  {
    feature: 'Private / secret content',
    pin: 'Not supported',
    board: 'Not supported',
    profile: 'Not supported',
  },
];

const { title = 'Pin vs Board vs Profile — which tool?', highlight, rows = defaultRows, stripe = true } = Astro.props;

const colClass = (col: 'pin' | 'board' | 'profile') =>
  highlight === col ? 'bg-stock-canary/40 dark:bg-stock-canary/15 font-semibold text-[var(--ink)]' : 'text-[var(--ink-2)]';
const heads = [
  { key: 'pin', label: 'Pin', href: '/pinterest-pin-downloader' },
  { key: 'board', label: 'Board ZIP', href: '/pinterest-board-downloader' },
  { key: 'profile', label: 'Profile ZIP', href: '/pinterest-profile-downloader' },
] as const;
---

<section class="py-12 sm:py-16 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-left" aria-labelledby="compare-heading">
  <div class="counter-rule pt-4 mb-6 sm:mb-8 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] gap-x-10 gap-y-3 items-end">
    <h2 id="compare-heading" class="t-display text-4xl sm:text-5xl leading-[0.95]">{title}</h2>
    <p class="text-base text-[var(--ink-2)] leading-relaxed">
      Use the tool that matches your link type. A wrong URL type is the most common reason a download fails.
    </p>
  </div>
  <div class="overflow-x-auto touch-pan-x rounded-md bg-[var(--paper)]">
    <table class="w-full text-left text-[0.9375rem] min-w-[560px] tabular-nums">
      <thead>
        <tr class="bg-ink-900 text-white dark:bg-ink-100 dark:text-ink-900">
          <th scope="col" class="p-3.5 sm:p-4 t-label">Feature</th>
          {heads.map((h) => (
            <th scope="col" class:list={['p-3.5 sm:p-4 t-label', highlight === h.key && 'bg-stock-canary text-ink-900']}>
              <a href={h.href} class="underline decoration-2 underline-offset-4 hover:no-underline">{h.label}</a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b-2 border-dashed border-[var(--rule)] last:border-0">
            <th scope="row" class="p-3.5 sm:p-4 font-bold align-top">{row.feature}</th>
            <td class={`p-3.5 sm:p-4 align-top ${colClass('pin')}`}>{row.pin}</td>
            <td class={`p-3.5 sm:p-4 align-top ${colClass('board')}`}>{row.board}</td>
            <td class={`p-3.5 sm:p-4 align-top ${colClass('profile')}`}>{row.profile}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-[var(--ink-2)]">
    * For every carousel slide of a pin inside a board or profile pack, open that pin with the{' '}
    <a href="/pinterest-pin-downloader" class="font-bold text-[var(--ink)] underline">Pin Downloader</a>.
  </p>
</section>
