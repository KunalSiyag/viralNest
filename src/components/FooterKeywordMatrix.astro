---
interface Props {
  /** Localized pages pass their own groups (live pages only); English keeps MATRIX_GROUPS. */
  groups?: { category: string; links: { href: string; label: string }[] }[];
  /** sr-only heading (localized). */
  heading?: string;
}

/**
 * English footer: plain labels, one link per page. This sits on every page, so
 * keyword-stuffed anchors here read as sitewide anchor manipulation.
 */
const MATRIX_GROUPS = [
  {
    category: 'Downloaders',
    links: [
      { href: '/pinterest-video-downloader', label: 'Video downloader' },
      { href: '/pinterest-image-downloader', label: 'Image downloader' },
      { href: '/pinterest-gif-downloader', label: 'GIF downloader' },
      { href: '/pinterest-pin-downloader', label: 'Pin downloader' },
      { href: '/pinterest-carousel-downloader', label: 'Carousel downloader' },
      { href: '/pinterest-audio-downloader', label: 'Audio to MP3' },
    ],
  },
  {
    category: 'Boards & profiles',
    links: [
      { href: '/pinterest-board-downloader', label: 'Board downloader' },
      { href: '/pinterest-profile-downloader', label: 'Profile downloader' },
      { href: '/pinterest-profile-picture-downloader', label: 'Profile picture' },
    ],
  },
  {
    category: 'Guides',
    links: [
      { href: '/download-pinterest-videos-iphone-android', label: 'iPhone & Android' },
      { href: '/how-to-download-pinterest-video-in-gallery', label: 'Save to gallery' },
      { href: '/how-to-download-pinterest-video-on-laptop', label: 'Laptop & PC' },
      { href: '/pinterest-video-downloader-chrome', label: 'Chrome' },
      { href: '/blog', label: 'Blog' },
    ],
  },
];

const { groups = MATRIX_GROUPS, heading = 'All PintDownload tools and guides' } = Astro.props;
---

<nav class="w-full bg-ink-950 text-slate-300 pt-14 text-start" aria-labelledby="all-tools-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 border-b-2 border-dashed border-white/20">
    <h2 id="all-tools-heading" class="sr-only">{heading}</h2>
    <div class={`grid grid-cols-1 sm:grid-cols-2 ${groups.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'} gap-x-10 gap-y-8`}>
      {groups.map((group) => (
        <div>
          <h3 class="t-label text-stock-canary mb-3">{group.category}</h3>
          <ul class="space-y-0.5 text-[0.9375rem]">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-1 hover:text-white hover:underline leading-snug">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</nav>
